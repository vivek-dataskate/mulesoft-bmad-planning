{
  "name": "MuleSoft BMAD Planning",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:18",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-bicep",
        "redhat.vscode-yaml",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GitHub.vscode-pull-request-github",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "rdudiver.bmad-viewer-vscode",
        "anthropic.claude-code",
        "Supabase.vscode-supabase-extension",
        "ArthurSpark.vs-code-ext-mule-munit-helper",
        "cweijan.vscode-postgresql-client2",
        "ms-ossdata.vscode-pgsql"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.associations": {
          "*.xml": "xml",
          "*.dwl": "plaintext"
        }
      }
    }
  },
  "remoteEnv": {
    "GITHUB_TOKEN": "${localEnv:GH_TOKEN}",
    "GITHUB_ORG": "${localEnv:GH_ORG}"
  },
  "postCreateCommand": "npm install -g mulesoft-mcp-server && echo 'MuleSoft MCP Server installed'",
  "remoteUser": "node",
  "mounts": [],
  "forwardPorts": []
}