# BMAD agent framework — stored in Firebase Storage, restored on container rebuild
# Upload: node scripts/upload-agent-framework.js
# Restore: node scripts/restore-agents.js (runs automatically on container rebuild)
.agent/
.agents/

# Node
node_modules/
npm-debug.log*
.npm

# Generated Mule project output — visible locally for inspection, not committed
# (generated code lives in the client GitHub repo, not here)
projects/*/generated/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# Environment / secrets — NEVER commit these
*.env
.env
.env.*
secrets/
*.key
*.p12
*.jks

# Scaffold test output
/output/
/generated/

# Claude Code working files
.claude/todos/

# Scout pipeline logs — verbose Claude output, not source-controlled
logs/
dataskateclients-firebase-adminsdk-fbsvc-6d3f67e197.json
*-firebase-adminsdk-*.json
*.json.key

# Firebase — generated at deploy time, not source-controlled
# resources/ is committed (static sales materials that don't regenerate per-deploy)
firebase/public/intake/
firebase/public/proposal/
firebase/public/portal/
firebase/scripts/node_modules/
firebase/.firebase/

# Bulk customer input files — binary PDFs/docx, not source-controlled (too large)
_bulkinbox/
_inbox/

# Claude Code memory backup — runtime artifact, not source-controlled
.claude-memory-backup/
