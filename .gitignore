# BMAD agent framework — stored in Firebase Storage, restored on container rebuild
# Upload: node pipeline/scripts/upload-agent-framework.js
# Restore: node pipeline/scripts/restore-agents.js (runs automatically on container rebuild)
.agent/
.agents/

# Node
node_modules/
npm-debug.log*
.npm

# Generated Mule project output — visible locally for inspection, not committed
# (generated code lives in the client GitHub repo, not here)
projects/*/generated/

# Per-client API credentials — NEVER commit
projects/*/credentials.json

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# Environment / secrets — NEVER commit these
*.env
.env
.env.*
secrets/
*.key
*.p12
*.jks

# Scaffold test output
/output/
/generated/

# Claude Code working files
.claude/todos/

# Scout pipeline logs — verbose Claude output, not source-controlled
logs/
dataskateclients-firebase-adminsdk-fbsvc-6d3f67e197.json
*-firebase-adminsdk-*.json
*.json.key

# Portal — node_modules and Firebase cache only; all public/ HTML is source-controlled
portal/scripts/node_modules/
portal/.firebase/

# Customer input files — binary PDFs/docx, not source-controlled (too large)
_inbox/

# Per-project ingestion source materials — raw transcripts, PDFs, recordings.
# Confidential client content + often very large (recordings can exceed GitHub's
# 100MB blob limit). Stays on disk for Sage to process; never source-controlled.
# scoping/run/ (agent JSON outputs) IS tracked; only raw source materials are not.
projects/*/scoping/transcripts/
projects/*/scoping/recordings/
projects/*/_inbox/

# Claude Code memory backup — runtime artifact, not source-controlled
.claude-memory-backup/

# Visual regression (BackstopJS) — reference/ is committed; test/report/ci are scratch
portal/tests/backstop/backstop.json
portal/tests/backstop/backstop_data/bitmaps_test/
portal/tests/backstop/backstop_data/html_report/
portal/tests/backstop/backstop_data/ci_report/

# Eleventy build output — generated by 'npm run build:html'
portal/_build/
