{
  "font": {
    "family": {
      "system": {
        "$type": "fontFamily",
        "$value": ["-apple-system", "BlinkMacSystemFont", "'Segoe UI'", "Roboto", "sans-serif"],
        "$description": "Body font stack — system fonts only, no web font load"
      }
    },
    "size": {
      "$type": "dimension",
      "base":  { "$value": "15px" },
      "small": { "$value": "13px" },
      "micro": { "$value": "11px" }
    },
    "lineHeight": {
      "$type": "number",
      "body":    { "$value": 1.6 },
      "heading": { "$value": 1.3 }
    }
  }
}
