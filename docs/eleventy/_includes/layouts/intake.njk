{#
  layouts/intake.njk
  ──────────────────
  DataSkate client intake questionnaire.
  CSS + body structure lifted verbatim from commons/templates/intake-template.html.
  All <!-- FILL:X --> slots replaced by {{ intakeRendered.X | safe }}.
  The entire JS block is in {% raw %}…{% endraw %} so Nunjucks does not touch it;
  only the two per-client constants (CLIENT_SLUG, architect email) are injected
  above the raw block via window.__ vars — same pattern as integration-deck.njk.
  Interactive features preserved:
    • expand/collapse sections + UC blocks (toggleAllSections, summary click)
    • sticky cat-tabs + scroll-to-anchor on click
    • right-rail section nav + IntersectionObserver active highlight
    • unanswered-only filter (toggleUnansweredFilter, refreshFilterChip)
    • .is-unanswered animated highlight on every empty field (updateProgress)
    • Needs-Attention rail with P0 blockers + dynamic required-unanswered count
    • row-status traffic-light dots on fillable table rows
    • pill multi-choice (pickPill → hidden textarea value)
    • print/save PDF: force-open all <details>, restore after afterprint
    • Firestore submit: arrayUnion versioned write to intake_responses/{slug}
    • soft-lock banner: localStorage version counter + v(N+1) next-save message
    • auto-fill: prefilled textareas from project.json / company_context.json (MD path)
#}
{% extends "layouts/base.njk" %}

{% block head %}
<style>
/* ── LAYOUT ─────────────────────────────────────────────────────────────────
   Main + right rail. Rail collapses below content on narrow viewports. */
.wrap {
  max-width: 1480px;
  margin: 0 auto;
  padding: 0 24px 60px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 260px;
  gap: 32px;
  align-items: start;
}
.main-col { min-width: 0; }
.rail-col {
  position: sticky;
  top: 56px;
  align-self: start;
  max-height: calc(100vh - 72px);
  overflow-y: auto;
  padding-bottom: 24px;
}
@media (max-width: 1100px) {
  .wrap { grid-template-columns: 1fr; gap: 16px; }
  .rail-col { position: static; max-height: none; order: 2; }
}

/* ── STICKY ACTION BAR ── */
.sticky-bar {
  position: sticky; top: 0; z-index: 200;
  background: rgba(255,255,255,0.97);
  backdrop-filter: blur(4px);
  border-bottom: 1px solid var(--border);
  padding: 8px 32px;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
}
.bar-logo { display: flex; align-items: center; flex-shrink: 0; }
.bar-tools { display: flex; gap: 4px; flex-shrink: 0; margin-left: 14px; padding-left: 14px; border-left: 1px solid var(--border); }
.bar-tool {
  background: none; border: 1px solid var(--border); border-radius: 4px;
  padding: 4px 9px; font-size: 11px; font-weight: 700; color: var(--mid);
  cursor: pointer; font-family: inherit; line-height: 1.3;
  display: inline-flex; align-items: center; gap: 4px;
  transition: color 0.1s, border-color 0.1s, background 0.1s;
}
.bar-tool:hover { color: var(--brand); border-color: var(--brand); background: var(--light); }
.bar-tool .bt-icon { font-size: 10px; }

/* ── FILTER LINK ── Count-as-link in the sticky bar that toggles
   "show all" ↔ "show unanswered only". Self-hides when nothing unanswered. */
.bar-filter {
  display: inline-block;             /* inline-flex collapses whitespace between children */
  vertical-align: middle;
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  color: var(--brand-dk);
  text-decoration: none;
  background: var(--light);
  border: 1px solid var(--border);
  padding: 4px 12px;
  border-radius: 12px;
  margin-left: 6px;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
}
.bar-filter:hover { background: #FFE4E4; border-color: var(--brand); color: var(--brand); }
.bar-filter .bf-count { font-weight: 800; }
.bar-filter .bf-arrow { margin-left: 4px; opacity: 0.7; }
.bar-filter.is-hidden { display: none; }
/* Active state: filter is on. Switch to filled red treatment. The chip's
   text content is rewritten by refreshFilterChip() — no ::before/::after
   trickery needed; CSS just handles colors. */
body.filter-unanswered .bar-filter {
  background: var(--brand);
  border-color: var(--brand);
  color: #fff;
}
body.filter-unanswered .bar-filter:hover { background: var(--brand-dk); border-color: var(--brand-dk); }

/* ── FILTER FILTER MODE ── hide answered Qs + empty UCs + empty sections */
body.filter-unanswered .q:not(.is-unanswered)                          { display: none; }
body.filter-unanswered details.uc:not(:has(.is-unanswered))            { display: none; }
body.filter-unanswered details.section-block:not(:has(.is-unanswered)) { display: none; }
/* Empty cat-anchor blocks following a hidden section get hidden too via
   their lack of following visible siblings — no rule needed, they're just
   invisible 0-height anchors. */
/* Hide tables/grids inside section bodies — they don't carry .is-unanswered
   so the filter would leave them visibly orphaned when their parent UC has
   one or more unanswered Q blocks. We still WANT them visible in that case
   so the user has full context for filling in the blank. */
body.filter-unanswered details.uc.has-unanswered .scope-grid,
body.filter-unanswered details.uc.has-unanswered .uc-note,
body.filter-unanswered details.uc.has-unanswered .p0-block { display: block; }
.progress-pill { font-size: 12px; font-weight: 600; color: var(--mid); }
.progress-pill span { color: var(--brand); font-weight: 800; }
.bar-actions { display: flex; gap: 8px; flex-shrink: 0; }

/* ── BUTTONS ── */
.btn {
  padding: 7px 16px; border-radius: 6px;
  font-size: 13px; font-weight: 700;
  cursor: pointer; border: none;
}
.btn-primary { background: var(--brand); color: #fff; }
.btn-outline { background: #fff; color: var(--dark); border: 2px solid var(--border); }

/* ── BOTTOM SUBMIT BLOCK ── */
.submit-block { text-align: center; padding: 40px 0 20px; }
.btn-submit { font-size: 15px; padding: 12px 36px; }
.submit-success {
  display: none;
  background: #F0FFF4;
  border: 1px solid #68D391;
  border-left: 4px solid var(--green);
  border-radius: 6px;
  padding: 14px 20px; margin-top: 16px;
  font-size: 14px; font-weight: 600; color: #276749;
}

/* ── HEADER ── 2-column: title on left, meta on right. Meta aligns to the
   baseline of the H1 so the eye reads the title first, then the provenance. */
.doc-header {
  padding: 18px 0 14px;
  border-bottom: 3px solid var(--brand);
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 4px 28px;
  align-items: end;
}
.doc-header-main { min-width: 0; }
.doc-header .eyebrow {
  font-size: 11px; font-weight: 700; letter-spacing: 2px;
  text-transform: uppercase; color: var(--mid); margin-bottom: 8px;
}
.doc-header h1 {
  font-size: 24px; font-weight: 800; color: var(--dark);
  margin-bottom: 4px; line-height: 1.25;
}
.doc-header .subtitle {
  font-size: 13px; color: var(--mid); margin: 0;
}
.doc-header-meta {
  font-size: 12px;
  color: var(--mid);
  line-height: 1.55;
  text-align: right;
  align-self: end;
  white-space: nowrap;
}
.doc-header-meta div { padding: 1px 0; }
.doc-header-meta strong {
  color: var(--dark); font-weight: 600;
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;
  margin-right: 4px;
}
.doc-header-meta .source-link {
  color: var(--brand-dk);
  text-decoration: none;
  border-bottom: 1px dotted var(--brand-dk);
}
.doc-header-meta .source-link:hover { color: var(--brand); border-bottom-color: var(--brand); }
.doc-header-meta .src-icon { font-size: 10px; opacity: 0.7; }
/* On narrow viewports, meta drops below the title so it doesn't crash */
@media (max-width: 900px) {
  .doc-header { grid-template-columns: 1fr; }
  .doc-header-meta { text-align: left; white-space: normal; padding-top: 10px; border-top: 1px solid var(--border); margin-top: 8px; }
}

/* ── BUSINESS CONTEXT — TEASER BY DEFAULT ──────────────────────────────────
   Collapsed shows: title + phase chip + 1-line snapshot. Click expands. */
.biz-context {
  border: 1px solid var(--border);
  border-left: 4px solid var(--brand);
  border-radius: 8px;
  margin: 16px 0 0;
  background: var(--light);
  overflow: hidden;
}
.bc-header {
  padding: 10px 16px;
  cursor: pointer;
  user-select: none;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 4px 12px;
  align-items: center;
}
.bc-title-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.bc-title {
  font-size: 12px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.5px;
  color: var(--brand-dk);
}
.bc-phase-chip {
  font-size: 10px; font-weight: 700; letter-spacing: 0.5px;
  background: #fff; color: var(--brand-dk);
  border: 1px solid var(--border);
  padding: 2px 8px; border-radius: 10px;
  text-transform: uppercase;
}
.bc-chevron { font-size: 12px; color: var(--brand-dk); transition: transform 0.2s; grid-row: 1 / span 2; }
.biz-context.is-open .bc-chevron { transform: rotate(180deg); }
.bc-snapshot-teaser {
  grid-column: 1;
  font-size: 13px; color: var(--dark); line-height: 1.5;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden;
}
.biz-context.is-open .bc-snapshot-teaser { display: none; }
.bc-body { display: none; padding: 0 16px 16px; }
.biz-context.is-open .bc-body { display: block; }
.bc-snapshot { font-size: 14px; color: var(--dark); margin-bottom: 14px; line-height: 1.6; }

/* AI Journey cards */
.journey-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 14px; }
.journey-card { border-radius: 0 0 6px 6px; padding: 14px 16px; background: #fff; border: 1px solid var(--border); }
.journey-card.phase-1 { border-top: 3px solid var(--green); }
.journey-card.phase-2 { border-top: 3px solid var(--amber); }
.journey-card.phase-3 { border-top: 3px solid #C084FC; }
.jc-phase    { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 2px; color: var(--mid); }
.jc-label    { font-size: 13px; font-weight: 700; color: var(--dark); margin-bottom: 4px; }
.jc-headline { font-size: 12px; font-weight: 600; color: var(--dark); margin-bottom: 4px; }
.jc-body     { font-size: 12px; color: var(--mid); line-height: 1.5; }

/* ── ACTION REQUIRED (in biz-context expanded body) ── */
.action-required { background: #FEF2F2; border: 1px solid #FECACA; border-left: 4px solid var(--brand); border-radius: 0 8px 8px 0; padding: 14px 18px; }
.action-required h4 { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #991B1B; margin-bottom: 8px; }
.action-required ul { list-style: none; padding: 0; margin: 0; }
.action-required li { font-size: 13px; color: #7F1D1D; padding: 7px 0 7px 22px; position: relative; border-bottom: 1px solid #FECACA; line-height: 1.5; }
.action-required li:last-child { border-bottom: none; padding-bottom: 0; }
.action-required li::before { content: '→'; position: absolute; left: 0; color: var(--brand); font-weight: 700; }
.action-required li strong { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #991B1B; margin-bottom: 2px; }

/* ── CATEGORY TABS — sticky pinned navigation at top of main column ── */
.cat-tabs {
  position: sticky;
  top: 44px;             /* directly below .sticky-bar */
  z-index: 150;
  background: #fff;
  border-bottom: 2px solid var(--brand);
  display: flex;
  margin: 20px -24px 0;  /* full-bleed against .wrap padding */
  padding: 0 24px;
}
.cat-tab {
  flex: 1;
  background: none;
  border: none;
  cursor: pointer;
  padding: 10px 18px 9px;
  text-align: left;
  border-bottom: 3px solid transparent;
  margin-bottom: -2px;
  font-family: inherit;
  transition: background 0.15s, border-color 0.15s;
}
.cat-tab:hover { background: var(--light); }
.cat-tab.is-active { border-bottom-color: var(--brand); background: var(--light); }
.cat-tab .ct-num   { font-size: 10px; font-weight: 800; color: var(--brand); letter-spacing: 1.2px; display: block; }
.cat-tab .ct-title { font-size: 15px; font-weight: 800; color: var(--dark); display: block; margin-top: 2px; }
.cat-tab .ct-meta  { font-size: 11px; color: var(--mid); margin-top: 1px; display: block; }
.cat-tab.is-active .ct-title { color: var(--brand-dk); }

/* Hidden anchors that the tabs scroll to */
.cat-anchor { display: block; height: 0; scroll-margin-top: 112px; }

/* Future bucket — amber-tinted to signal "not in current scope" */
.cat-tab[data-cat="future"] .ct-num { color: #92400E; }
.cat-tab[data-cat="future"].is-active { border-bottom-color: var(--amber); background: var(--amber-bg); }
.cat-tab[data-cat="future"].is-active .ct-title { color: #92400E; }
details.section-block[data-cat="future"] { border-left: 3px solid var(--amber); }
details.section-block[data-cat="future"] summary.section-head { background: var(--amber-bg); }

/* Right-rail Future card — same amber accent */
.rail-future { border-left: 3px solid var(--amber); background: var(--amber-bg); }
.rail-future .rail-label { color: #92400E; }
.rail-future .rail-future-count { font-size: 22px; font-weight: 800; color: #92400E; line-height: 1.1; }
.rail-future .rail-future-meta  { font-size: 11px; color: #92400E; margin-top: 2px; }
.rail-future a { display: inline-flex; align-items: center; gap: 4px; margin-top: 8px; font-size: 12px; font-weight: 700; color: #92400E; text-decoration: none; }
.rail-future a:hover { text-decoration: underline; }
.rail-future a::after { content: '→'; }

/* ── SECTION BLOCKS — collapsible tiles ── */
details.section-block { border: 1px solid var(--border); margin-bottom: 6px; scroll-margin-top: 64px; }
details.section-block:last-of-type { margin-bottom: 0; }
details.section-block[open] { border-left: 3px solid var(--brand); }
summary.section-head { display: flex; align-items: center; gap: 10px; cursor: pointer; list-style: none; padding: 12px 16px; user-select: none; background: #FAFAFA; }
summary.section-head::-webkit-details-marker { display: none; }
details.section-block[open] summary.section-head { background: #fff; border-bottom: 1px solid var(--border); }
.section-num   { font-size: 10px; font-weight: 700; color: var(--mid); text-transform: uppercase; letter-spacing: 1px; flex-shrink: 0; }
.section-title { font-size: 14px; font-weight: 700; color: var(--dark); }
.section-count { font-size: 10px; font-weight: 700; color: var(--mid); margin-left: 6px; }
.section-count.has-required { color: var(--brand); }
.section-chevron { font-size: 11px; color: var(--mid); margin-left: auto; transition: transform 0.2s; }
details.section-block[open] .section-chevron { transform: rotate(180deg); }
.section-body { padding: 16px 16px 20px; }
.section-body h3 { font-size: 12px; font-weight: 700; color: var(--mid); text-transform: uppercase; letter-spacing: 1px; margin: 18px 0 12px; padding-bottom: 5px; border-bottom: 1px solid var(--border); }
.req { display: none; }

/* ── UC BLOCKS — collapsible details/summary ── */
details.uc { margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
details.uc:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
summary.uc-hd { display: flex; align-items: center; gap: 10px; cursor: pointer; list-style: none; padding: 6px 0; margin-bottom: 0; }
summary.uc-hd::-webkit-details-marker { display: none; }
details.uc[open] summary.uc-hd { margin-bottom: 6px; }
.uc-tag { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; background: var(--brand); color: #fff; padding: 2px 8px; border-radius: 4px; }
summary.uc-hd h3 { font-size: 14px; font-weight: 600; color: var(--dark); text-transform: none; letter-spacing: normal; margin: 0; }
.uc-count {
  font-size: 10px; font-weight: 700;
  color: var(--mid);
  margin-left: auto;            /* pushes count to the right; chevron follows */
  padding: 1px 6px;
  border-radius: 3px;
}
.uc-count.has-required { color: var(--brand); background: #FFE4E4; }
.uc-count.is-complete  { color: var(--green); }
/* When uc-count exists, chevron no longer takes margin-left:auto — fix manually */
summary.uc-hd:has(.uc-count) .uc-chevron { margin-left: 8px; }
.uc-chevron { font-size: 11px; color: var(--mid); margin-left: auto; transition: transform 0.2s; }
details.uc[open] .uc-chevron { transform: rotate(180deg); }
.uc-body { padding: 0 0 4px; }
.uc-note { font-size: 14px; color: var(--mid); margin: 0 0 12px; line-height: 1.55; }

/* ── P0 BLOCKER ── */
.p0-block { background: #FEF2F2; border-left: 3px solid var(--brand); padding: 12px 16px; margin-bottom: 16px; border-radius: 0 6px 6px 0; }
.p0-block .p0-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #991B1B; margin-bottom: 4px; }
.p0-block p { font-size: 13px; color: #7F1D1D; margin: 0; line-height: 1.6; }
.p0-block p strong { color: #991B1B; }
.p0-block code { background: #FEE2E2; padding: 1px 4px; border-radius: 3px; font-family: monospace; font-size: 12px; }

/* ── SCOPE BOUNDARY ── */
.scope-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-top: 16px; }
.scope-item { padding: 10px 14px; border-radius: 6px; font-size: 12px; line-height: 1.5; background: #FAFAFA; border: 1px solid var(--border); color: var(--dark); }
.scope-item .scope-label { font-weight: 700; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 4px; }
.scope-in .scope-label      { color: #276749; }
.scope-assumed .scope-label { color: #7C5E10; }
.scope-out .scope-label     { color: #9B2335; }

/* ── QUESTION BLOCKS ── */
.q { display: grid; grid-template-columns: 28px 1fr; gap: 0 8px; margin-bottom: 10px; align-items: start; }
.q:last-child { margin-bottom: 0; }
.q-num { font-size: 10px; font-weight: 700; color: var(--mid); padding-top: 4px; text-align: right; }
.q-body { min-width: 0; }
.q-text { font-size: 15px; font-weight: 500; color: var(--dark); margin-bottom: 6px; line-height: 1.5; }

/* ── UNANSWERED HIGHLIGHT ── Impossible-to-miss eye-catcher for required-but-
   empty questions. Saturated red wash + 6px brand border-left + 3px brand
   border-top + giant "⚠ NEEDS ANSWER" pulsing banner-chip + thick red textarea
   border with halo glow + drop shadow on the whole block. Drops the moment
   the user types into the field (JS toggles is-unanswered). */
.q.is-unanswered {
  position: relative;
  background: #FEE2E2;
  border-left: 6px solid var(--brand);
  border-top: 3px solid var(--brand);
  border-right: 1px solid #FECACA;
  border-radius: 0 0 8px 0;
  padding: 22px 16px 18px 14px;         /* extra top padding for the banner */
  margin: 16px -8px 18px -12px;
  box-shadow: 0 0 0 1px #FECACA, 0 4px 16px rgba(237, 28, 36, 0.28);
  transition: background 0.15s;
  animation: ds-unanswered-glow 2s ease-in-out infinite;
}
@keyframes ds-unanswered-glow {
  0%, 100% { box-shadow: 0 0 0 1px #FECACA, 0 4px 16px rgba(237, 28, 36, 0.28); }
  50%      { box-shadow: 0 0 0 1px #FECACA, 0 6px 22px rgba(237, 28, 36, 0.42); }
}
.q.is-unanswered .q-num {
  color: var(--brand);
  font-weight: 800;
  font-size: 12px;
}
.q.is-unanswered .q-text {
  color: var(--dark);
  font-weight: 700;
}
.q.is-unanswered textarea.answer,
.q.is-unanswered input.tbl-ans {
  border: 2px solid var(--brand);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(237, 28, 36, 0.22), inset 0 0 0 1px rgba(237, 28, 36, 0.1);
}
.q.is-unanswered textarea.answer::placeholder,
.q.is-unanswered input.tbl-ans::placeholder {
  color: var(--brand);
  font-weight: 600;
  opacity: 0.7;
}
/* Giant banner-style chip in the top-right corner — big text, white on red,
   pulses with an expanding ring shadow so it really catches the eye. */
.q.is-unanswered::after {
  content: '⚠ NEEDS ANSWER';
  position: absolute;
  right: -1px;                          /* flush with the border-right */
  top: -3px;                            /* sits on top of the border-top */
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: #fff;
  background: var(--brand);
  padding: 5px 14px;
  border-radius: 0 0 0 8px;             /* ribbon shape — flat top + right */
  box-shadow: 0 3px 8px rgba(237, 28, 36, 0.45);
  animation: ds-pulse-chip 1.4s ease-in-out infinite;
  pointer-events: none;
  z-index: 2;
}
@keyframes ds-pulse-chip {
  0%, 100% { transform: scale(1);    box-shadow: 0 3px 8px rgba(237, 28, 36, 0.45), 0 0 0 0  rgba(237, 28, 36, 0.6); }
  50%      { transform: scale(1.05); box-shadow: 0 3px 8px rgba(237, 28, 36, 0.45), 0 0 0 12px rgba(237, 28, 36, 0); }
}
@media (prefers-reduced-motion: reduce) {
  .q.is-unanswered           { animation: none; }
  .q.is-unanswered::after    { animation: none; }
}
/* Print — strip all the animated noise; keep a quiet visual marker only */
@media print {
  .q.is-unanswered::after { display: none; }
  .q.is-unanswered {
    background: #fff;
    border-top: none;
    border-left: 2px solid var(--border);
    border-right: none;
    box-shadow: none;
    animation: none;
    padding: 6px 0;
  }
  .q.is-unanswered textarea.answer { box-shadow: none; border-width: 1px; }
}
.q-text em { font-size: 12px; font-weight: 400; color: var(--mid); display: block; margin-top: 3px; font-style: italic; }
.q-hint { font-size: 12px; color: var(--mid); font-style: italic; margin-bottom: 8px; padding: 5px 10px; background: #FAFAFA; border-left: 2px solid var(--border); }
.q-options { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 8px; }
.pill { padding: 4px 12px; border-radius: 20px; font-size: 12px; cursor: pointer; border: 1px solid var(--border); background: #fff; color: var(--mid); transition: all 0.15s; }
.pill:hover    { background: var(--light); border-color: var(--brand); color: var(--brand); }
.pill.selected { background: var(--brand); color: #fff; border-color: var(--brand); font-weight: 600; }
textarea.answer { width: 100%; border: 1px solid var(--border); border-radius: 4px; padding: 7px 12px; font-size: 13px; font-family: inherit; resize: vertical; min-height: 34px; color: var(--dark); background: #fff; transition: border-left 0.15s, border-color 0.15s; line-height: 1.5; }
textarea.answer:focus    { outline: none; border-color: var(--brand); box-shadow: 0 0 0 2px rgba(237,28,36,0.08); }
textarea.answer.is-prefilled { border-left: 3px solid var(--amber); background: #fff; }
textarea.answer.is-answered  { border-left: 3px solid var(--green); background: #fff; }
textarea.answer.mandatory-empty { background: var(--light); border-color: #F87171; }

/* ── TABLES ── */
table.dtbl { width: 100%; border-collapse: collapse; font-size: 13px; margin: 8px 0; }
table.dtbl th { background: var(--dark); color: #fff; font-size: 11px; font-weight: 600; letter-spacing: 0.5px; padding: 10px 14px; text-align: left; }
table.dtbl td { padding: 10px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
table.dtbl tr:nth-child(even) td { background: #FAFAFA; }
table.dtbl tr:last-child td { border-bottom: none; }
table.dtbl input.tbl-ans { width: 100%; border: 1px solid var(--border); border-radius: 4px; padding: 5px 8px; font-size: 12px; font-family: inherit; background: #fff; }
table.dtbl input.tbl-ans.is-prefilled { background: var(--amber-bg); border-color: #FDE68A; }
.tbl-hint { font-size: 12px; color: var(--mid); font-style: italic; margin-bottom: 8px; padding: 8px 14px; background: #FAFAFA; border-left: 3px solid var(--border); border-radius: 0 4px 4px 0; }

/* ── INTERNAL FLAGS ── */
.internal-block { display: none; border-top: 2px solid #FDE68A; padding: 32px 0; }
.internal-block h3 { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #92400E; margin-bottom: 20px; }
.flag-item { margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px solid #FDE68A; }
.flag-item:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
.flag-num  { font-size: 10px; font-weight: 700; color: #92400E; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 3px; }
.flag-body { font-size: 13px; color: #78350F; line-height: 1.6; }
.flag-body code { background: #FEF3C7; padding: 1px 5px; border-radius: 3px; font-family: monospace; font-size: 12px; }

/* ── ACCESS CHAIN TABLE ── */
.access-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.access-table th { background: var(--dark); color: #fff; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; padding: 8px 12px; text-align: left; }
.access-table td { padding: 9px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
.access-table tr:nth-child(even) td { background: #FAFAFA; }
.access-table tr:last-child td { border-bottom: none; }
.status-badge { display: inline-block; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; }
.status-ok      { background: #D1FAE5; color: #065F46; }
.status-pending { background: #FEF3C7; color: #92400E; }
.status-blocked { background: #FEE2E2; color: #991B1B; }

/* ── ROW-STATUS DOT ── Auto-computed traffic-light marker for any table row
   whose cells contain fillable inputs. Replaces the static "Pending" badge
   with a colored circle that updates live as the user types:
     red    (default)     → 0 fields filled
     amber  (.is-partial) → some fields filled
     green  (.is-complete)→ all fields filled
   Injected by injectRowStatusDots() on init; refreshed by refreshRowStatusDots()
   on every input event. Hides the static .status-badge text in the same cell. */
.row-status-dot {
  display: inline-block;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--brand);                         /* red = nothing filled yet */
  vertical-align: middle;
  box-shadow: 0 0 0 2px rgba(255,255,255,0.7), 0 1px 2px rgba(0,0,0,0.15);
  cursor: help;
  transition: background 0.2s;
}
.row-status-dot.is-partial  { background: var(--amber); }
.row-status-dot.is-complete { background: var(--green); }
/* When a dot exists in the same cell as a static status-badge, hide the badge —
   the dot is the source of truth visually. */
td:has(.row-status-dot) .status-badge { display: none; }
/* Print — degrade to neutral text labels so the PDF still communicates state */
@media print {
  .row-status-dot { box-shadow: none; }
  .row-status-dot::after {
    content: 'not started';
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    color: var(--brand); margin-left: 16px;
  }
  .row-status-dot.is-partial::after  { content: 'in progress'; color: #92400E; }
  .row-status-dot.is-complete::after { content: 'complete';    color: #065F46; }
}

/* ── RIGHT RAIL ─────────────────────────────────────────────────────────── */
.rail-card {
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 12px 14px;
  margin-bottom: 12px;
  background: #fff;
}
.rail-card:last-child { margin-bottom: 0; }
.rail-label {
  font-size: 10px; font-weight: 800;
  text-transform: uppercase; letter-spacing: 1.2px;
  color: var(--mid);
  margin-bottom: 8px;
}

/* Progress card */
.rail-progress {
  border-left: 3px solid var(--brand);
}
.progress-num {
  font-size: 22px; font-weight: 800; color: var(--dark);
  line-height: 1.1;
}
.progress-num .num-total { color: var(--mid); font-weight: 600; }
.progress-meta { font-size: 11px; color: var(--mid); margin-top: 2px; }
.progress-bar {
  height: 6px; background: #F1EEEE; border-radius: 3px;
  margin: 10px 0 4px; overflow: hidden;
}
.progress-fill {
  height: 100%; background: var(--brand);
  width: 0%; transition: width 0.25s ease;
}

/* Subsection jump-nav */
.rail-nav { font-size: 12px; }
.rail-nav .nav-cat {
  font-size: 10px; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.8px;
  color: var(--brand);
  margin: 10px 0 4px;
  padding-top: 8px;
  border-top: 1px solid var(--border);
}
.rail-nav .nav-cat:first-child { margin-top: 0; padding-top: 0; border-top: none; }
.rail-nav a {
  display: flex; justify-content: space-between; align-items: center;
  padding: 4px 0;
  color: var(--dark); text-decoration: none;
  border-left: 2px solid transparent;
  padding-left: 8px;
  margin-left: -8px;
  border-radius: 0;
  transition: background 0.1s, border-color 0.1s;
}
.rail-nav a:hover { background: var(--light); }
.rail-nav a.is-active { border-left-color: var(--brand); background: var(--light); color: var(--brand-dk); font-weight: 700; }
.rail-nav .nav-count {
  font-size: 10px; color: var(--mid); font-weight: 600;
  margin-left: 6px;
}
.rail-nav a.is-complete .nav-count { color: var(--green); }
.rail-nav a.has-required .nav-count { color: var(--brand); font-weight: 800; }

/* Needs Attention card */
.rail-attention {
  border-left: 3px solid var(--brand);
  background: #FFFAFA;
}
.rail-attention .rail-label { color: #991B1B; }
.attention-list { list-style: none; padding: 0; margin: 0; }
.attention-list li {
  font-size: 12px;
  padding: 8px 18px 10px;
  border-bottom: 1px solid #FECACA;
  position: relative;
  color: #7F1D1D;
  line-height: 1.45;
}
.attention-list li:last-child { border-bottom: none; padding-bottom: 4px; }
.attention-list li::before { content: '!'; position: absolute; left: 4px; top: 9px; font-weight: 800; color: var(--brand); font-size: 11px; width: 12px; height: 12px; line-height: 12px; text-align: center; }
.attention-list .attn-title {
  display: block;
  font-size: 11px; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.4px;
  color: #991B1B;
  margin-bottom: 4px;
  padding-left: 16px;             /* clear the ::before "!" marker */
}
.attention-list .attn-body {
  display: none;                  /* title-only by default */
  font-size: 12px; font-weight: 400;
  color: #7F1D1D;
  line-height: 1.5;
  margin-top: 4px;
}
/* Reveal body on hover/focus or when the user expands the li by clicking */
.attention-list li:hover  .attn-body,
.attention-list li:focus  .attn-body,
.attention-list li.is-expanded .attn-body { display: block; }
.attention-list li[data-target] { cursor: pointer; border-radius: 3px; transition: background 0.1s; }
.attention-list li[data-target]:hover { background: #FFE4E4; }
.attention-list li[data-target]:focus { outline: 2px solid var(--brand); outline-offset: 1px; }
.attention-list li[data-target]::after { content: '→'; position: absolute; right: 6px; top: 9px; color: var(--brand); font-weight: 800; font-size: 13px; }
.attention-empty {
  font-size: 12px; color: var(--mid); font-style: italic;
  padding: 4px 0;
}

/* Rail links */
.rail-links { list-style: none; padding: 0; margin: 0; }
.rail-links li { padding: 4px 0; font-size: 12px; }
.rail-links a { color: var(--brand-dk); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
.rail-links a:hover { text-decoration: underline; }
.rail-links a::after { content: '↗'; font-size: 10px; opacity: 0.6; }

/* ── FOOTER ── */
/* Footer spans the full wrap width via grid-column: 1/-1 so the right rail
   doesn't leave a tall white gap beside it on long pages. */
.footer { grid-column: 1 / -1; border-top: 1px solid var(--border); padding: 16px 32px; font-size: 12px; color: var(--mid); display: flex; justify-content: space-between; align-items: center; margin-top: 32px; }
.footer strong { color: var(--dark); }
.footer a { color: var(--mid); text-decoration: none; }

/* ── PRINT — collapse rail, expand everything, paginate cleanly ── */
/* @page margins control the gap between page edge and content. 13mm ≈ 3 lines
   at print font-size, applied symmetrically top + bottom so every page has the
   same breathing room (header gap = footer gap). 16mm sides keep the printer's
   built-in URL/page-number chrome from crowding the form text. */
@page {
  margin: 13mm 16mm;
}
@media print {
  .sticky-bar, .no-print, .rail-col, .cat-tabs { display: none !important; }
  /* Belt + suspenders: if JS didn't clear the unanswered-filter, the printed
     PDF must STILL contain the whole form. Forcibly show what filter hid. */
  body.filter-unanswered .q,
  body.filter-unanswered details.uc,
  body.filter-unanswered details.section-block { display: block !important; }
  .wrap { display: block; padding: 0; }
  /* Question blocks should never split across a page boundary mid-answer */
  .q { break-inside: avoid; page-break-inside: avoid; }
  details.uc { break-inside: auto; page-break-inside: auto; }
  /* Encourage each top-level section to start cleanly. Browsers will still
     pack tightly when content fits; this only kicks in at natural breaks. */
  details.section-block { break-before: auto; }
  details.section-block > summary.section-head { break-after: avoid; }
  /* Give sections + UCs a touch of top spacing on print for visual rhythm */
  details.section-block + details.section-block { margin-top: 12px; }
  body { background: #fff; font-size: 11px; }
  textarea.answer, .tbl-ans { background: #fff !important; border: 1px solid #ccc !important; }
  .bc-blockers { display: none !important; }
  .biz-context .bc-body { display: block !important; }
  .biz-context .bc-snapshot-teaser { display: none !important; }
  .p0-block { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  details.section-block, details.section-block[open] { display: block; border: none; border-bottom: 1px solid var(--border); margin-bottom: 0; }
  summary.section-head { background: none; border-bottom: 2px solid var(--border); margin-bottom: 12px; padding: 8px 0; }
  .section-chevron, .section-count { display: none; }
  details.uc { border: none; }
  details.uc[open], details.uc:not([open]) { display: block; }
  summary.uc-hd { background: none; padding: 8px 0; border-bottom: 1px solid var(--border); }
  .uc-chevron { display: none; }
  details.section-block { page-break-inside: avoid; }
  .pill { display: none; }
  .pill.selected::before { content: '✓ '; }
  .pill.selected { display: inline; background: none; color: var(--dark); border: none; font-weight: 600; }
}
</style>
{% endblock %}

