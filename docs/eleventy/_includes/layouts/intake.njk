  <div class="bar-tools">
    <button type="button" class="bar-tool" onclick="toggleAllSections(true)" title="Open every section + use case">
      <span class="bt-icon">▼</span> Expand all
    </button>
    <button type="button" class="bar-tool" onclick="toggleAllSections(false)" title="Collapse every section + use case">
      <span class="bt-icon">▲</span> Collapse all
    </button>
    <a href="#" class="bar-filter is-hidden" id="filter-link" role="button"
       onclick="toggleUnansweredFilter(event)"
       title="Hide answered questions so only the blanks remain">
      <span class="bf-count">0</span><span class="bf-label"> unanswered</span><span class="bf-arrow"> ›</span>
    </a>
  </div>
  <div class="progress-pill">Questions answered: <span id="answered-count">0</span> / <span id="total-count">0</span></div>
  <div class="bar-actions">
    <button class="btn btn-outline" onclick="printAllExpanded()">Print / Save PDF</button>
    <button class="btn btn-primary" onclick="submitForm()">Submit to DataSkate</button>
  </div>
</div>

<div class="wrap">

<!-- ──────────────────────── MAIN COLUMN ──────────────────────── -->
<div class="main-col">

<!-- DOCUMENT HEADER — title left, meta right -->
<div class="doc-header">
  <div class="doc-header-main">
    <div class="eyebrow">{{ intakeRendered.eyebrow | safe }}</div>
    <h1>{{ intakeRendered.docTitle | safe }}</h1>
    <div class="subtitle">{{ intakeRendered.docSubtitle | safe }}</div>
  </div>
  <div class="doc-header-meta">
    <div><strong>Prepared by</strong>{{ intakeRendered.architect | esc }} · DataSkate</div>
    <div><strong>Date</strong>{{ intakeRendered.date | esc }}</div>
    <div><strong>Source</strong>{{ intakeRendered.sourceHtml | safe }}</div>
  </div>
</div>

<!-- BUSINESS CONTEXT — collapsed teaser by default -->
<div class="biz-context" id="biz-context">
  <div class="bc-header" onclick="toggleBC()">
    <div class="bc-title-row">
      <span class="bc-title">How We See Your Business</span>
      {{ intakeRendered.phaseChipHtml | safe }}
    </div>
    <span class="bc-chevron" id="bc-chevron">▼</span>
    <span class="bc-snapshot-teaser">{{ intakeRendered.bcSnapshot | safe }}</span>
  </div>
  <div class="bc-body" id="bc-body">
    <p class="bc-snapshot">{{ intakeRendered.bcSnapshot | safe }}</p>
    <div class="journey-grid">
      {{ intakeRendered.journeyCardsHtml | safe }}
    </div>
    {{ intakeRendered.p0BlockersHtml | safe }}
  </div>
</div>

<!-- CATEGORY TABS — sticky, clickable; jumps to bucket anchor -->
<div class="cat-tabs no-print" id="cat-tabs">
  {{ intakeRendered.catTabsHtml | safe }}
</div>

<!-- FORM SECTIONS — DOM ordered Business → Technical → Production -->
{{ intakeRendered.formSectionsHtml | safe }}

<!-- INTERNAL FLAGS — no-print -->
{{ intakeRendered.internalFlagsHtml | safe }}

<!-- PRICING SUMMARY — no-print -->
{{ intakeRendered.pricingSummaryHtml | safe }}

<!-- BOTTOM SUBMIT BLOCK -->
<div class="submit-block no-print">
  <button class="btn btn-primary btn-submit" onclick="submitForm()">Submit to DataSkate</button>
  <div class="submit-success" id="submit-success">
    ✓ Your responses have been submitted to DataSkate. We'll be in touch shortly.
  </div>
</div>

</div><!-- /.main-col -->

<!-- ──────────────────────── RIGHT RAIL ──────────────────────── -->
<aside class="rail-col no-print" aria-label="Form status and navigation">

  <!-- Progress -->
  <div class="rail-card rail-progress">
    <div class="rail-label">Progress</div>
    <div class="progress-num">
      <span id="rail-answered">0</span><span class="num-total"> / <span id="rail-total">0</span></span>
    </div>
    <div class="progress-meta">questions answered · <span id="rail-pct">0</span>%</div>
    <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
  </div>

  <!-- Subsections jump-nav -->
  <div class="rail-card">
    <div class="rail-label">Subsections</div>
    <nav class="rail-nav" id="rail-nav">
      {{ intakeRendered.railNavHtml | safe }}
    </nav>
  </div>

  <!-- Needs Attention -->
  <div class="rail-card rail-attention">
    <div class="rail-label">Needs Attention</div>
    <ul class="attention-list" id="attention-list">
      {{ intakeRendered.railAttentionHtml | safe }}
    </ul>
    <div class="attention-empty" id="attention-empty" style="display:none">Nothing flagged. Good to go.</div>
  </div>

  <!-- Links -->
  <div class="rail-card">
    <div class="rail-label">Links</div>
    <ul class="rail-links">
      {{ intakeRendered.railLinksHtml | safe }}
    </ul>
  </div>

</aside>

<!-- Footer lives INSIDE .wrap and spans both columns (grid-column: 1/-1)
     so the right rail doesn't leave a tall empty band beside it. -->
<div class="footer no-print">
  <span>{{ intakeRendered.architect | esc }} · {{ intakeRendered.architectEmail | esc }} · DataSkate</span>
  <strong>Confidential</strong>
</div>

</div><!-- /.wrap -->
{% endblock %}

{% block scripts %}
{# Inject per-client constants. Kept outside {% raw %} so Nunjucks can interpolate.
   CLIENT_SLUG drives Firestore save path + localStorage version key.
   __INTAKE_ARCH_EMAIL is used in the error alert when the Firestore save fails. #}
<script>window.__INTAKE_SLUG = "{{ intakeRendered.clientSlug | esc }}"; window.__INTAKE_ARCH_EMAIL = "{{ intakeRendered.architectEmail | esc }}";</script>
{% raw %}<script>
// ── FIREBASE CONFIG ──────────────────────────────────────────────────────────
const FIREBASE_CONFIG = {
  apiKey:            "AIzaSyDCpzgZAMWWGwedG5At5Ml3gn_yA0dRVZk",
  authDomain:        "dataskateclients.firebaseapp.com",
  projectId:         "dataskateclients",
  storageBucket:     "dataskateclients.firebasestorage.app",
  messagingSenderId: "620173241148",
  appId:             "1:620173241148:web:d5bf84e63e93ef94758c39"
};
const CLIENT_SLUG = window.__INTAKE_SLUG;

// ── FIREBASE INIT ────────────────────────────────────────────────────────────
(function() {
  const scripts = [
    "https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js",
    "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"
  ];
  scripts.forEach(src => {
    const s = document.createElement('script');
    s.src = src; s.async = false;
    document.head.appendChild(s);
  });
})();

// ── FORM LOGIC ───────────────────────────────────────────────────────────────
function toggleBC() {
  document.getElementById('biz-context').classList.toggle('is-open');
}

// Open or close every section + UC at once. Used by the "Expand all" /
// "Collapse all" tools on the left of the sticky bar. After expanding, also
// scroll the first unanswered required question into view so the user lands
// directly on what still needs their input — otherwise they're stuck staring
// at the top of an enormous expanded form.
function toggleAllSections(open) {
  if (open && document.body.classList.contains('filter-unanswered')) {
    // Filter is on — only expand UCs/sections that have an unanswered Q;
    // expanding the hidden (fully-answered) ones would un-collapse blocks
    // the filter then hides, which feels wrong.
    document.querySelectorAll(
      'details.section-block:has(.is-unanswered), details.uc:has(.is-unanswered)'
    ).forEach(d => d.setAttribute('open', ''));
    jumpToFirstUnanswered();
    return;
  }
  document.querySelectorAll('details.section-block, details.uc').forEach(d => {
    if (open) d.setAttribute('open', '');
    else      d.removeAttribute('open');
  });
  if (open) jumpToFirstUnanswered();
}

// ── UNANSWERED-ONLY FILTER ──────────────────────────────────────────────
// Two states on body: default (show all) ↔ `.filter-unanswered` (hide answered
// Qs + empty UCs + empty sections via :has() CSS). The chip in the sticky bar
// is both the count display and the toggle affordance.
function toggleUnansweredFilter(e) {
  if (e) e.preventDefault();
  const body = document.body;
  const turningOn = !body.classList.contains('filter-unanswered');
  body.classList.toggle('filter-unanswered', turningOn);

  if (turningOn) {
    // Auto-open the UCs and sections that have unanswered Qs so the user
    // sees the actual blanks right away (not collapsed headers).
    document.querySelectorAll('details.section-block:has(.is-unanswered)').forEach(s => s.setAttribute('open', ''));
    document.querySelectorAll('details.uc:has(.is-unanswered)').forEach(u => u.setAttribute('open', ''));
    requestAnimationFrame(() => jumpToFirstUnanswered());
  }
  refreshFilterChip();
  refreshCatTabLabels();
}

// Update the chip's count, label, and visibility (self-hide when 0 unanswered).
// Default state: "26 unanswered ›". Active state: "Showing 26 · clear ✕".
// Counts EVERY empty answer field (textareas + table inputs), so the number
// matches `total - answered` from the progress pill. Earlier this only counted
// .q.is-unanswered blocks and missed empty inputs inside tables (~16 in homage).
function refreshFilterChip() {
  const link = document.getElementById('filter-link');
  if (!link) return;
  const all   = document.querySelectorAll('textarea.answer, input.tbl-ans');
  const count = Array.from(all).filter(t => (t.value || '').trim().length === 0).length;
  link.classList.toggle('is-hidden', count === 0);
  const filterOn = document.body.classList.contains('filter-unanswered');
  link.innerHTML = filterOn
    ? `Showing <span class="bf-count">${count}</span> · clear ✕`
    : `<span class="bf-count">${count}</span> unanswered ›`;
}

// Inject a .row-status-dot into every table row that has both a status-badge
// AND at least one fillable input. Runs once on init; refreshRowStatusDots()
// updates the color on every input event.
function injectRowStatusDots() {
  document.querySelectorAll('table tr').forEach(tr => {
    const badge = tr.querySelector('.status-badge');
    if (!badge) return;
    const inputs = tr.querySelectorAll('input.tbl-ans, textarea.answer');
    if (inputs.length === 0) return;
    const cell = badge.closest('td');
    if (!cell || cell.querySelector('.row-status-dot')) return;
    const dot = document.createElement('span');
    dot.className = 'row-status-dot';
    dot.setAttribute('aria-label', 'row completion status');
    dot.title = '0 of ' + inputs.length + ' filled';
    cell.insertBefore(dot, badge);
  });
}

// Refresh the color + tooltip of every injected dot based on the current
// fill state of its row's inputs. Called from updateProgress() so it stays
// live as the user types.
function refreshRowStatusDots() {
  document.querySelectorAll('.row-status-dot').forEach(dot => {
    const tr = dot.closest('tr');
    if (!tr) return;
    const inputs = tr.querySelectorAll('input.tbl-ans, textarea.answer');
    const filled = Array.from(inputs).filter(t => (t.value || '').trim().length > 0).length;
    const total  = inputs.length;
    dot.classList.toggle('is-complete', total > 0 && filled === total);
    dot.classList.toggle('is-partial',  filled > 0 && filled < total);
    dot.title = filled + ' of ' + total + ' filled';
  });
}

// When filter is on, replace each cat-tab's metadata line with an unanswered
// count for that bucket. When filter is off, restore the original "N sections
// · {blurb}" text (cached on the element the first time we read it).
function refreshCatTabLabels() {
  const filterOn = document.body.classList.contains('filter-unanswered');
  document.querySelectorAll('.cat-tab').forEach(tab => {
    const meta = tab.querySelector('.ct-meta');
    if (!meta) return;
    if (!meta.dataset.original) meta.dataset.original = meta.textContent;
    if (filterOn) {
      const cat = tab.dataset.cat;
      // Count every empty answer field in this bucket (including table cells),
      // not just .q.is-unanswered — matches the global chip/progress arithmetic.
      const fields = document.querySelectorAll(
        `details.section-block[data-cat="${cat}"] textarea.answer, ` +
        `details.section-block[data-cat="${cat}"] input.tbl-ans`
      );
      const n = Array.from(fields).filter(t => (t.value || '').trim().length === 0).length;
      meta.textContent = n === 0
        ? 'all answered ✓'
        : `${n} unanswered`;
      tab.classList.toggle('is-empty-in-filter', n === 0);
    } else {
      meta.textContent = meta.dataset.original;
      tab.classList.remove('is-empty-in-filter');
    }
  });
}

// Find + scroll to the first empty answer field. Pass a scope element to
// restrict the search (e.g. a single section); omit for the whole form.
// Focuses the field after a short delay so the scroll completes first.
function jumpToFirstUnanswered(scope) {
  const root = scope || document;
  const fields = root.querySelectorAll('textarea.answer, input.tbl-ans');
  for (const f of fields) {
    if ((f.value || '').trim().length === 0) {
      // Ensure the surrounding details blocks are open so the field is visible
      let p = f.parentElement;
      while (p) {
        if (p.tagName === 'DETAILS') p.setAttribute('open', '');
        p = p.parentElement;
      }
      f.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => f.focus({ preventScroll: true }), 350);
      return true;
    }
  }
  return false;
}

// Print/Save-PDF — force-open every <details>, expand the biz-context, and
// clear the unanswered-only filter so the PDF contains the FULL questionnaire
// regardless of the current screen state. Then restore the user's prior state
// once the print dialog closes.
//
// Two subtleties:
//   1. `display:block` in @media print can't override the UA <details>
//      hiding — the `[open]` attribute has to be present for the body to
//      render.
//   2. window.print() runs synchronously and captures the layout AT THAT
//      MOMENT. If we set [open] then immediately call print, Chrome captures
//      the still-collapsed state. We defer the print call until after a
//      double-rAF so the layout has time to repaint.
function printAllExpanded() {
  // 1. Snapshot current state
  const details      = Array.from(document.querySelectorAll('details.section-block, details.uc'));
  const wasOpen      = new Set();
  const bc           = document.getElementById('biz-context');
  const bcWasOpen    = bc ? bc.classList.contains('is-open') : false;
  const filterWasOn  = document.body.classList.contains('filter-unanswered');

  // 2. Force every collapsible into its expanded state
  details.forEach(d => {
    if (d.hasAttribute('open')) wasOpen.add(d);
    else d.setAttribute('open', '');
  });
  if (bc) bc.classList.add('is-open');
  if (filterWasOn) document.body.classList.remove('filter-unanswered');

  // 3. Restore once the print dialog closes
  function restore() {
    details.forEach(d => { if (!wasOpen.has(d)) d.removeAttribute('open'); });
    if (bc && !bcWasOpen) bc.classList.remove('is-open');
    if (filterWasOn)      document.body.classList.add('filter-unanswered');
    window.removeEventListener('afterprint', restore);
  }
  window.addEventListener('afterprint', restore);

  // 4. Defer window.print() until the layout has actually repainted with the
  //    new [open] attributes — Chrome's print preview snapshots the layout
  //    at the time of the call, not after pending paints.
  requestAnimationFrame(() => requestAnimationFrame(() => {
    window.print();
  }));
}

// Needs-Attention click → jump to the relevant place.
//   data-target="biz"      → expand biz-context (full P0 detail)
//   data-target="sec:<id>" → open that section block + scroll to it
function focusAttentionTarget(target) {
  if (!target) return;
  // Dynamic "X required unanswered" item — jump straight to the first one.
  if (target === 'first-unanswered') {
    jumpToFirstUnanswered();
    return;
  }
  if (target === 'biz') {
    const bc = document.getElementById('biz-context');
    if (bc) {
      bc.classList.add('is-open');
      bc.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    return;
  }
  if (target.startsWith('sec:')) {
    const id  = target.slice(4);
    const sec = document.getElementById(id) || document.getElementById('sec-' + id);
    if (sec) {
      sec.setAttribute('open', '');
      // Prefer landing on the first unanswered required question inside the
      // section; fall back to the section header when nothing's outstanding.
      if (!jumpToFirstUnanswered(sec)) {
        sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  }
}

function pickPill(el, fieldId) {
  const group = el.closest('.q-options');
  group.querySelectorAll('.pill').forEach(p => p.classList.remove('selected'));
  el.classList.add('selected');
  const ta = document.getElementById(fieldId);
  if (ta) {
    ta.value = el.textContent.trim();
    ta.classList.add('is-answered');
    ta.classList.remove('mandatory-empty');
    updateProgress();
  }
}

function updateProgress() {
  const all      = document.querySelectorAll('textarea.answer, input.tbl-ans');
  const answered = Array.from(all).filter(t => (t.value || '').trim().length > 0);
  const total    = all.length;
  const ans      = answered.length;
  const pct      = total > 0 ? Math.round((ans / total) * 100) : 0;

  // Top sticky bar
  const sb1 = document.getElementById('answered-count'); if (sb1) sb1.textContent = ans;
  const sb2 = document.getElementById('total-count');    if (sb2) sb2.textContent = total;

  // Right rail progress card
  const ra = document.getElementById('rail-answered'); if (ra) ra.textContent = ans;
  const rt = document.getElementById('rail-total');    if (rt) rt.textContent = total;
  const rp = document.getElementById('rail-pct');      if (rp) rp.textContent = pct;
  const pf = document.getElementById('progress-fill'); if (pf) pf.style.width = pct + '%';

  // Per-section counts (and per-rail-nav-link counts)
  document.querySelectorAll('details.section-block').forEach(sec => {
    const inputs   = sec.querySelectorAll('textarea.answer, input.tbl-ans');
    const filled   = Array.from(inputs).filter(t => (t.value || '').trim().length > 0).length;
    const required = sec.querySelectorAll('textarea.answer[data-required="true"], input.tbl-ans[data-required="true"]');
    const reqEmpty = Array.from(required).filter(t => (t.value || '').trim().length === 0).length;

    // Update section-head badge
    const badge = sec.querySelector('.section-count');
    if (inputs.length > 0) {
      if (badge) {
        badge.textContent = `${filled}/${inputs.length}`;
        badge.classList.toggle('has-required', reqEmpty > 0);
      }
    } else if (badge) {
      badge.textContent = '';
    }

    // Update matching rail-nav link
    const navLink = document.querySelector(`.rail-nav a[data-section="${sec.id}"]`);
    if (navLink) {
      const cnt = navLink.querySelector('.nav-count');
      if (inputs.length > 0 && cnt) cnt.textContent = `${filled}/${inputs.length}`;
      navLink.classList.toggle('is-complete', inputs.length > 0 && filled === inputs.length);
      navLink.classList.toggle('has-required', reqEmpty > 0);
    }
  });

  // Per-UC counts — same logic, scoped to each <details class="uc">. Lets the
  // user scan all UC headers and immediately see which still need answers,
  // without having to expand every block to find out.
  document.querySelectorAll('details.uc').forEach(uc => {
    const inputs   = uc.querySelectorAll('textarea.answer, input.tbl-ans');
    const filled   = Array.from(inputs).filter(t => (t.value || '').trim().length > 0).length;
    const required = uc.querySelectorAll('textarea.answer[data-required="true"], input.tbl-ans[data-required="true"]');
    const reqEmpty = Array.from(required).filter(t => (t.value || '').trim().length === 0).length;
    const badge = uc.querySelector('.uc-count');
    if (!badge) return;
    if (inputs.length > 0) {
      badge.textContent = `${filled}/${inputs.length}`;
      badge.classList.toggle('has-required', reqEmpty > 0);
      badge.classList.toggle('is-complete',  filled === inputs.length);
    } else {
      badge.textContent = '';
      badge.classList.remove('has-required', 'is-complete');
    }
  });

  // Toggle the `.is-unanswered` highlight on each .q block. Fires on ANY
  // empty answer field — required or not. For a discovery questionnaire,
  // every blank deserves a visual nudge; the client should fill them all.
  // Drops the moment the user types into the field (this runs on every input).
  document.querySelectorAll('.q').forEach(q => {
    const field = q.querySelector('textarea.answer, input.tbl-ans');
    const isEmpty = field && (field.value || '').trim().length === 0;
    q.classList.toggle('is-unanswered', !!isEmpty);
  });

  // Keep the sticky-bar filter chip count + cat-tab subtitles + row-status dots in sync.
  refreshFilterChip();
  refreshRowStatusDots();
  if (document.body.classList.contains('filter-unanswered')) refreshCatTabLabels();

  rebuildAttention();
}

function rebuildAttention() {
  // Combine static P0 blockers (rendered at fill time) with dynamic required-unanswered
  const list = document.getElementById('attention-list');
  if (!list) return;
  list.querySelectorAll('li[data-source="dynamic"]').forEach(li => li.remove());

  // Required-unanswered summary — clickable, jumps to the first offending section
  const reqEmpty = Array.from(
    document.querySelectorAll('textarea.answer[data-required="true"], input.tbl-ans[data-required="true"]')
  ).filter(t => (t.value || '').trim().length === 0);
  if (reqEmpty.length > 0) {
    const li = document.createElement('li');
    li.setAttribute('data-source', 'dynamic');
    li.setAttribute('data-target', 'first-unanswered');
    li.setAttribute('tabindex', '0');
    li.setAttribute('role', 'link');
    li.innerHTML =
      `<strong class="attn-title">${reqEmpty.length} required ${reqEmpty.length === 1 ? 'question' : 'questions'} unanswered</strong>` +
      `<span class="attn-body">Click to jump to the first unanswered question.</span>`;
    list.appendChild(li);
  }

  const empty = document.getElementById('attention-empty');
  if (empty) empty.style.display = list.children.length === 0 ? 'block' : 'none';
}

// One-time delegated handler for attention-list. Wired in DOMContentLoaded.
function wireAttentionClicks() {
  const list = document.getElementById('attention-list');
  if (!list || list.dataset.wired === '1') return;
  list.dataset.wired = '1';
  list.addEventListener('click', e => {
    const li = e.target.closest('li[data-target]');
    if (li) focusAttentionTarget(li.dataset.target);
  });
  list.addEventListener('keydown', e => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const li = e.target.closest('li[data-target]');
    if (li) { e.preventDefault(); focusAttentionTarget(li.dataset.target); }
  });
}

function collectAnswers() {
  const answers = {};
  document.querySelectorAll('textarea.answer').forEach(ta => {
    if (ta.id) answers[ta.id] = ta.value.trim();
  });
  document.querySelectorAll('input.tbl-ans').forEach(inp => {
    if (inp.id) answers[inp.id] = inp.value.trim();
  });
  return answers;
}

// Versioning state — localStorage tracks best-effort version count for the
// submit banner UX. Server array (intake_responses/{client}.versions[]) is the
// source of truth; arch portal can sort versions[] by submittedAt to inspect
// history. Per-browser counter means cross-device counts can drift — that's
// acceptable because every submit becomes a distinct entry in versions[].
const VERSION_KEY = 'intake_version_' + CLIENT_SLUG;

function getLocalVersionState() {
  try { return JSON.parse(localStorage.getItem(VERSION_KEY) || 'null'); }
  catch { return null; }
}

function setLocalVersionState(versionCount, lastSubmittedAt) {
  try {
    localStorage.setItem(VERSION_KEY, JSON.stringify({
      versionCount, lastSubmittedAt: lastSubmittedAt || new Date().toISOString()
    }));
  } catch { /* private mode / quota — silently degrade */ }
}

function formatSubmitDate(iso) {
  if (!iso) return '';
  try {
    return new Date(iso).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' });
  } catch { return ''; }
}

function showSoftLockBanner(versionCount, lastSubmittedAt) {
  const banner = document.getElementById('submit-success');
  if (!banner || !versionCount) return;
  const date = formatSubmitDate(lastSubmittedAt);
  const next = versionCount + 1;
  banner.innerHTML =
    `✓ <strong>v${versionCount} submitted${date ? ' on ' + date : ''}.</strong> ` +
    `You can keep editing — your next save will be v${next}.`;
  banner.style.display = 'block';
}

function saveToFirestore(answers, pct) {
  if (typeof firebase === 'undefined') {
    console.warn('Firebase not loaded — submission skipped in offline mode');
    return Promise.resolve({ versionCount: 0, lastSubmittedAt: new Date().toISOString() });
  }
  if (!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
  const db = firebase.firestore();
  // Collection name must match firebase/firestore.rules + portal reads —
  // snake_case `intake_responses`. Mismatch causes silent permission-denied.
  const docRef = db.collection('intake_responses').doc(CLIENT_SLUG);
  const nowIso = new Date().toISOString();

  // localStorage gives us a best-effort version number for the banner. The
  // server's versions[] array (appended via arrayUnion) is the durable record.
  const local = getLocalVersionState();
  const newVersionCount = (local && local.versionCount ? local.versionCount : 0) + 1;

  const versionSnapshot = {
    v: newVersionCount,
    answers,
    completionPct: pct,
    submittedAt: nowIso,           // ISO inside array; serverTimestamp not allowed in arrayUnion
  };

  return docRef.set({
    client: CLIENT_SLUG,
    answers,                       // top-level mirror of the LATEST snapshot
    completionPct: pct,
    versionCount: newVersionCount, // best-effort top-level count (architect view truth = versions.length)
    submittedAt: firebase.firestore.FieldValue.serverTimestamp(),
    lastSubmittedAt: firebase.firestore.FieldValue.serverTimestamp(),
    versions: firebase.firestore.FieldValue.arrayUnion(versionSnapshot),
  }, { merge: true }).then(() => ({ versionCount: newVersionCount, lastSubmittedAt: nowIso }));
}

function submitForm() {
  const all = document.querySelectorAll('textarea.answer[data-required="true"]');
  const unanswered = Array.from(all).filter(t => t.value.trim().length === 0);
  if (unanswered.length > 0) {
    const proceed = confirm(
      `${unanswered.length} required question${unanswered.length > 1 ? 's are' : ' is'} unanswered. Submit anyway?`
    );
    if (!proceed) { unanswered[0].focus(); return; }
  }
  const answers = collectAnswers();
  const total = document.querySelectorAll('textarea.answer').length;
  const filled = Object.values(answers).filter(v => v.length > 0).length;
  const pct = total > 0 ? Math.round((filled / total) * 100) : 0;

  saveToFirestore(answers, pct).then(result => {
    setLocalVersionState(result.versionCount, result.lastSubmittedAt);
    showSoftLockBanner(result.versionCount, result.lastSubmittedAt);
    const banner = document.getElementById('submit-success');
    if (banner) banner.scrollIntoView({ behavior: 'smooth' });
  }).catch(err => {
    console.error('Firestore save failed:', err);
    alert('Submission failed — please email your responses directly to ' + window.__INTAKE_ARCH_EMAIL);
  });
}

// ── INIT ─────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  // Force-collapse all collapsible blocks
  document.querySelectorAll('details.uc, details.section-block').forEach(d => d.removeAttribute('open'));

  // Show internal content only for architect review (?internal=1)
  if (new URLSearchParams(window.location.search).get('internal') === '1') {
    document.querySelectorAll('.internal-block, .bc-blockers').forEach(el => el.style.display = 'block');
  }

  // Sequential Q numbering
  let qNum = 1;
  document.querySelectorAll('.q-num').forEach(el => { el.textContent = `Q${qNum++}`; });

  // Inject a per-UC count badge into every UC summary so the user can scan
  // collapsed UC headers and immediately see which still need answers without
  // having to expand each block. updateProgress() populates the textContent.
  document.querySelectorAll('details.uc > summary.uc-hd').forEach(sum => {
    if (sum.querySelector('.uc-count')) return;          // already injected
    const count = document.createElement('span');
    count.className = 'uc-count';
    const chevron = sum.querySelector('.uc-chevron');
    if (chevron) sum.insertBefore(count, chevron);
    else         sum.appendChild(count);
  });

  // Wire textarea inputs to progress
  document.querySelectorAll('textarea.answer').forEach(ta => {
    ta.addEventListener('input', () => {
      ta.classList.toggle('is-answered', ta.value.trim().length > 0);
      updateProgress();
    });
  });
  document.querySelectorAll('input.tbl-ans').forEach(inp => {
    inp.addEventListener('input', updateProgress);
  });

  // Rail-nav link click — open the section AND land on the first unanswered
  // question inside it. If the section is fully answered AND the unanswered-only
  // filter is on, the section would otherwise be hidden — auto-clear the filter
  // so the user can still navigate to it.
  document.querySelectorAll('.rail-nav a[data-section]').forEach(a => {
    a.addEventListener('click', e => {
      const sec = document.getElementById(a.dataset.section);
      if (!sec) return;
      const hasUnanswered = !!sec.querySelector('.q.is-unanswered');
      if (!hasUnanswered && document.body.classList.contains('filter-unanswered')) {
        // Auto-clear the filter so the fully-answered section becomes visible
        toggleUnansweredFilter();
      }
      sec.setAttribute('open', '');
      requestAnimationFrame(() => {
        if (!jumpToFirstUnanswered(sec)) {
          sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
      e.preventDefault();
    });
  });

  // Manual click on ANY <details> summary — when the section is about to OPEN
  // (sec.open is still false at click-time), defer two frames so the toggle
  // takes effect, then jump to the first unanswered required field inside.
  // Works for section blocks AND inner UC blocks. Programmatic opens (rail-nav,
  // cat-tab, Expand-all) don't trigger summary click events, so no double-jump.
  document.querySelectorAll('details > summary').forEach(sum => {
    sum.addEventListener('click', () => {
      const det = sum.parentElement;
      if (!det || det.tagName !== 'DETAILS') return;
      if (det.open) return;             // closing — no jump
      requestAnimationFrame(() => requestAnimationFrame(() => jumpToFirstUnanswered(det)));
    });
  });

  // Category tab click — opens every section in that bucket then jumps to the
  // first unanswered required question across the bucket. If everything in the
  // bucket is answered, falls back to scrolling to the bucket anchor.
  document.querySelectorAll('.cat-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const cat = tab.dataset.cat;
      const sections = document.querySelectorAll(`details.section-block[data-cat="${cat}"]`);
      sections.forEach(s => s.setAttribute('open', ''));
      requestAnimationFrame(() => {
        // Try first-unanswered within the bucket
        for (const s of sections) {
          if (jumpToFirstUnanswered(s)) return;
        }
        // Otherwise scroll to the bucket anchor
        const target = document.getElementById('cat-' + cat);
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  });

  if ('IntersectionObserver' in window) {
    // Section-level active highlight on right rail
    const navLinks = new Map();
    document.querySelectorAll('.rail-nav a[data-section]').forEach(a => navLinks.set(a.dataset.section, a));
    if (navLinks.size > 0) {
      const ioSec = new IntersectionObserver(entries => {
        entries.forEach(e => {
          const link = navLinks.get(e.target.id);
          if (!link) return;
          if (e.isIntersecting) {
            navLinks.forEach(l => l.classList.remove('is-active'));
            link.classList.add('is-active');
          }
        });
      }, { rootMargin: '-30% 0px -55% 0px', threshold: 0 });
      document.querySelectorAll('details.section-block[id]').forEach(s => ioSec.observe(s));
    }

    // Category-level active highlight on the sticky top tabs
    const catTabs = new Map();
    document.querySelectorAll('.cat-tab[data-cat]').forEach(t => catTabs.set(t.dataset.cat, t));
    if (catTabs.size > 0) {
      const ioCat = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (!e.isIntersecting) return;
          const cat = e.target.dataset.cat;
          if (!cat) return;
          catTabs.forEach(t => t.classList.remove('is-active'));
          const active = catTabs.get(cat);
          if (active) active.classList.add('is-active');
        });
      }, { rootMargin: '-25% 0px -65% 0px', threshold: 0 });
      document.querySelectorAll('details.section-block[data-cat]').forEach(s => ioCat.observe(s));
    }
  }

  wireAttentionClicks();
  injectRowStatusDots();  // adds the dot element to every fillable table row
  updateProgress();       // first paint of progress, dot colors, filter chip, etc.
  refreshFilterChip();    // ensure the sticky-bar count chip is correct on first paint

  // Soft-lock banner — if this browser has submitted before, surface the
  // version + "edits create v(N+1)" note so the user knows what's saved.
  const prior = getLocalVersionState();
  if (prior && prior.versionCount > 0) {
    showSoftLockBanner(prior.versionCount, prior.lastSubmittedAt);
  }
});
</script>{% endraw %}
