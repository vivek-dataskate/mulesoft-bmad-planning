rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isArchitect() {
      return request.auth != null &&
             request.auth.token.email.matches('.*@dataskate\\.ai');
    }

    // Architects can read and write all project records
    match /projects/{clientId} {
      allow read, write: if isArchitect();
    }

    // Clients write intake responses without auth (public URL, no login)
    // Architects can read all responses
    match /intake_responses/{clientId} {
      allow create, update: if true;
      allow read: if isArchitect();
    }

    // Krisp meeting data — written only by the Cloud Function (server-side admin SDK)
    // Architects can read; no direct client writes
    match /krisp_meetings/{meetingId} {
      allow read: if isArchitect();
      allow write: if false;
    }
  }
}
