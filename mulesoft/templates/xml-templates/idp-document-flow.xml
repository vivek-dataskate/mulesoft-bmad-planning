<?xml version="1.0" encoding="UTF-8"?>
<!--
    idp-document-flows.xml — Anypoint IDP (Intelligent Document Processing)
    Generated by scaffold generator — pattern: idp-document-processing (V)
    Client: {{CLIENT}}

    API FACTS (verified May 2026 from MuleSoft docs):
      Base URL:   https://idp-rt.{region}.anypoint.mulesoft.com/api/v1/
      Submit:     POST /organizations/{orgId}/actions/{actionId}/versions/{versionId}/executions
                  Body (JSON): { "file": "<base64>", "fileName": "<name.pdf>" }
      Poll:       GET  /organizations/{orgId}/actions/{actionId}/versions/{versionId}/executions/{id}/v2
                  (IMPORTANT: /v2 suffix is mandatory — without it hits deprecated endpoint)
      Status:     ACKNOWLEDGED | IN_PROGRESS | RESULTS_PENDING | SUCCEEDED | FAILED |
                  PARTIAL_SUCCESS | MANUAL_VALIDATION_REQUIRED
      Terminal:   SUCCEEDED | FAILED | PARTIAL_SUCCESS | MANUAL_VALIDATION_REQUIRED
      Results:    response.pages[].fields.{fieldLabel}.value  (NOT response.result)
      Min poll:   10 seconds per IDP quota docs
      Auth:       Anypoint Connected App OAuth 2.0 — scope EMPTY (permissions on Connected App)
      P50:        7.6s | P99: 13.4s | Max file: 10MB | Max pages: 50

    Sub-flows:
      idp-execute-and-poll-subflow      — Submit + until-successful poll
      idp-manual-review-route-subflow   — Route failed extractions to ops queue

    Input vars for idp-execute-and-poll-subflow:
      vars.documentBase64     (String) — base64-encoded document bytes
      vars.documentFileName   (String) — filename with extension (e.g. "invoice-2026.pdf")
      vars.idpActionId        (String, optional) — override for multi-action routing
      vars.idpActionVersionId (String, optional) — override for multi-action routing

    Output vars after idp-execute-and-poll-subflow returns:
      vars.idpPages           (Array)  — pages[].fields / pages[].tables / pages[].prompts
      vars.idpExecutionId     (String) — execution ID for correlation
      vars.idpStatus          (String) — SUCCEEDED | PARTIAL_SUCCESS | MANUAL_VALIDATION_REQUIRED

    On FAILED or poll exhaustion: raises IDP:EXTRACTION_FAILED (routes to manual review first).
-->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:anypoint-mq="http://www.mulesoft.org/schema/mule/anypoint-mq"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:validation="http://www.mulesoft.org/schema/mule/validation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
          http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
          http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/anypoint-mq
          http://www.mulesoft.org/schema/mule/anypoint-mq/current/mule-anypoint-mq.xsd
        http://www.mulesoft.org/schema/mule/os
          http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/ee/core
          http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/validation
          http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd">

    <!--
    ═══════════════════════════════════════════════════════════════
    IDP CORE: SUBMIT + POLL SUB-FLOW
    ═══════════════════════════════════════════════════════════════

    Uses until-successful scope to poll IDP every 10s (minimum per IDP quota docs).
    until-successful retries when validation:is-true throws (i.e. status not yet terminal).
    On MULE:RETRY_EXHAUSTED (max attempts reached): routes to manual review + raises error.
    -->
    <sub-flow name="idp-execute-and-poll-subflow" doc:name="IDP — Execute and Poll">

        <logger
            level="INFO"
            message='#["[IDP-SUBMIT] correlationId=" ++ correlationId ++ " | fileName=" ++ (vars.documentFileName default "unknown") ++ " | actionId=" ++ (vars.idpActionId default p("anypoint.idp.actionId"))]'
            doc:name="Log IDP Submission"/>

        <!-- Submit document — JSON body with base64-encoded file -->
        <http:request
            method="POST"
            config-ref="IDP_API_Config"
            path="#['/organizations/' ++ p('anypoint.idp.orgId') ++ '/actions/' ++ (vars.idpActionId default p('anypoint.idp.actionId')) ++ '/versions/' ++ (vars.idpActionVersionId default p('anypoint.idp.actionVersionId')) ++ '/executions']"
            doc:name="Submit IDP Execution">
            <http:body>
                <![CDATA[%dw 2.0
output application/json
---
{
    file:     vars.documentBase64,
    fileName: vars.documentFileName default "document.pdf"
}]]>
            </http:body>
            <http:response-validator>
                <http:success-status-code-validator values="200,201,202"/>
            </http:response-validator>
        </http:request>

        <set-variable variableName="idpExecutionId" value="#[payload.id]"  doc:name="Store Execution ID"/>
        <set-variable variableName="idpPages"       value="#[null]"        doc:name="Init Pages Result"/>
        <set-variable variableName="idpStatus"      value="#['ACKNOWLEDGED']" doc:name="Init Status"/>

        <logger
            level="INFO"
            message='#["[IDP-POLLING] executionId=" ++ vars.idpExecutionId ++ " | correlationId=" ++ correlationId]'
            doc:name="Log Polling Start"/>

        <!--
            Poll using until-successful.
            millisBetweenRetries=10000 — minimum per IDP quota docs (faster polling may be rate-limited).
            maxRetries=18 — covers P99 latency (13.4s) with headroom up to ~3 minutes.
            Retry is triggered when validation:is-true throws (status not yet terminal).
            Terminal statuses: SUCCEEDED | FAILED | PARTIAL_SUCCESS | MANUAL_VALIDATION_REQUIRED
        -->
        <try doc:name="IDP Poll with Cleanup on Exhaustion">
            <until-successful
                maxRetries="18"
                millisBetweenRetries="10000"
                doc:name="Poll IDP Until Terminal Status">

                <http:request
                    method="GET"
                    config-ref="IDP_API_Config"
                    path="#['/organizations/' ++ p('anypoint.idp.orgId') ++ '/actions/' ++ (vars.idpActionId default p('anypoint.idp.actionId')) ++ '/versions/' ++ (vars.idpActionVersionId default p('anypoint.idp.actionVersionId')) ++ '/executions/' ++ vars.idpExecutionId ++ '/v2']"
                    doc:name="Poll IDP Execution Status">
                    <http:response-validator>
                        <http:success-status-code-validator values="200"/>
                    </http:response-validator>
                </http:request>

                <set-variable variableName="idpStatus" value="#[payload.status]"  doc:name="Update Status"/>
                <set-variable variableName="idpPages"  value="#[payload.pages default []]" doc:name="Store Pages"/>

                <logger
                    level="DEBUG"
                    message='#["[IDP-POLL] status=" ++ vars.idpStatus ++ " | executionId=" ++ vars.idpExecutionId]'
                    doc:name="Log Poll Status"/>

                <!-- Throw to trigger retry when status is still non-terminal -->
                <validation:is-true
                    expression="#[['SUCCEEDED','FAILED','PARTIAL_SUCCESS','MANUAL_VALIDATION_REQUIRED'] contains vars.idpStatus]"
                    message="#['IDP not yet terminal: ' ++ vars.idpStatus]"
                    doc:name="Check Terminal Status"/>

            </until-successful>

            <error-handler>
                <on-error-continue type="MULE:RETRY_EXHAUSTED">
                    <!-- Max polls reached and still not terminal — treat as failure -->
                    <set-variable variableName="idpStatus" value="#['FAILED']" doc:name="Mark as Failed on Exhaustion"/>
                    <logger
                        level="ERROR"
                        message='#["[IDP-TIMEOUT] executionId=" ++ vars.idpExecutionId ++ " | never reached terminal status after 18 polls (~3 min) | correlationId=" ++ correlationId]'
                        doc:name="Log Poll Exhaustion"/>
                    <flow-ref name="idp-manual-review-route-subflow" doc:name="Route to Manual Review"/>
                    <raise-error
                        type="IDP:EXTRACTION_FAILED"
                        description="#['IDP polling exhausted after 18 attempts: executionId=' ++ vars.idpExecutionId]"
                        doc:name="Raise Polling Exhausted"/>
                </on-error-continue>
            </error-handler>
        </try>

        <!-- Route non-SUCCEEDED terminal statuses to manual review -->
        <choice doc:name="Route on Terminal Status">
            <when expression="#[vars.idpStatus == 'SUCCEEDED']">
                <logger
                    level="INFO"
                    message='#["[IDP-SUCCEEDED] executionId=" ++ vars.idpExecutionId ++ " | pages=" ++ (sizeOf(vars.idpPages) as String) ++ " | correlationId=" ++ correlationId]'
                    doc:name="Log IDP Succeeded"/>
            </when>
            <when expression="#[vars.idpStatus == 'PARTIAL_SUCCESS']">
                <logger
                    level="WARN"
                    message='#["[IDP-PARTIAL] executionId=" ++ vars.idpExecutionId ++ " | some fields may be missing | correlationId=" ++ correlationId]'
                    doc:name="Log Partial Success"/>
                <!-- Partial success: continue processing with available fields but alert -->
                <flow-ref name="idp-manual-review-route-subflow" doc:name="Also Route to Manual Review"/>
            </when>
            <when expression="#[vars.idpStatus == 'MANUAL_VALIDATION_REQUIRED']">
                <logger
                    level="WARN"
                    message='#["[IDP-MANUAL-VALIDATION] executionId=" ++ vars.idpExecutionId ++ " | human review needed | correlationId=" ++ correlationId]'
                    doc:name="Log Manual Validation Required"/>
                <flow-ref name="idp-manual-review-route-subflow" doc:name="Route to Manual Review"/>
                <raise-error
                    type="IDP:MANUAL_VALIDATION_REQUIRED"
                    description="#['IDP requires manual validation: executionId=' ++ vars.idpExecutionId]"
                    doc:name="Raise Manual Validation Required"/>
            </when>
            <otherwise>
                <!-- FAILED -->
                <logger
                    level="ERROR"
                    message='#["[IDP-FAILED] status=" ++ vars.idpStatus ++ " | executionId=" ++ vars.idpExecutionId ++ " | correlationId=" ++ correlationId]'
                    doc:name="Log IDP Failed"/>
                <flow-ref name="idp-manual-review-route-subflow" doc:name="Route to Manual Review"/>
                <raise-error
                    type="IDP:EXTRACTION_FAILED"
                    description="#['IDP extraction failed: status=' ++ vars.idpStatus ++ ' executionId=' ++ vars.idpExecutionId]"
                    doc:name="Raise Extraction Failed"/>
            </otherwise>
        </choice>

    </sub-flow>

    <!--
    ═══════════════════════════════════════════════════════════════
    MANUAL REVIEW ROUTING SUB-FLOW
    ═══════════════════════════════════════════════════════════════
    -->
    <sub-flow name="idp-manual-review-route-subflow" doc:name="IDP — Route to Manual Review">
        <async doc:name="Async Manual Review Publish">
            <anypoint-mq:publish
                config-ref="Anypoint_MQ_Config"
                destination="{{domain}}-idp-manual-review-${mule.env}-queue"
                messageId="#[correlationId ++ '-' ++ (uuid() replace '-' with '')]"
                doc:name="Publish to IDP Manual Review Queue">
                <anypoint-mq:body>
                    <![CDATA[%dw 2.0
output application/json
---
{
    correlationId:    correlationId,
    executionId:      vars.idpExecutionId      default "not-submitted",
    idpStatus:        vars.idpStatus           default "unknown",
    documentFileName: vars.documentFileName    default "unknown",
    idpActionId:      vars.idpActionId         default p("anypoint.idp.actionId"),
    failedAt:         now() as String { format: "yyyy-MM-dd'T'HH:mm:ss.SSSZ" },
    environment:      p("mule.env"),
    note:             "Manual review required — see idpStatus for reason"
}]]>
                </anypoint-mq:body>
            </anypoint-mq:publish>
        </async>
        <logger
            level="WARN"
            message='#["[IDP-MANUAL-REVIEW] correlationId=" ++ correlationId ++ " | executionId=" ++ (vars.idpExecutionId default "not-submitted") ++ " | status=" ++ (vars.idpStatus default "unknown")]'
            doc:name="Log Manual Review Route"/>
    </sub-flow>

    <!--
    ═══════════════════════════════════════════════════════════════
    MQ CONSUMER FLOW (http-multipart documentSource only)
    ═══════════════════════════════════════════════════════════════
    -->
    {{#if IDP_MQ_CONSUMER}}
    <flow name="mq-process-idp-document-flow" doc:name="IDP — Process Document from Queue">

        <anypoint-mq:subscriber
            config-ref="Anypoint_MQ_Config"
            destination="{{domain}}-idp-inbound-${mule.env}-queue"
            acknowledgementMode="MANUAL"
            maxConcurrency="${anypoint.idp.maxConcurrency}"
            doc:name="MQ Subscriber — IDP Inbound Queue"/>

        <logger
            level="INFO"
            message='#["[IDP-CONSUMER-START] messageId=" ++ attributes.messageId ++ " | correlationId=" ++ correlationId]'
            doc:name="Log Consumer Start"/>

        <try doc:name="IDP Document Processing">

            <!-- Idempotency check -->
            <os:retrieve
                key="#['idp-proc-' ++ attributes.messageId]"
                target="alreadyProcessed"
                objectStore="Idempotency_Object_Store"
                doc:name="Idempotency Check"/>

            <choice doc:name="Skip Duplicate">
                <when expression="#[vars.alreadyProcessed != null]">
                    <anypoint-mq:ack config-ref="Anypoint_MQ_Config" ackToken="#[attributes.ackToken]" doc:name="ACK Duplicate"/>
                    <logger level="INFO" message='#["[IDP-DUPLICATE] skipped: " ++ attributes.messageId]' doc:name="Log Duplicate Skipped"/>
                </when>
                <otherwise>

                    <set-variable variableName="documentBase64"    value="#[payload.documentBase64]"    doc:name="Extract Document"/>
                    <set-variable variableName="documentFileName"   value="#[payload.documentFileName default 'document.pdf']" doc:name="Extract File Name"/>
                    <set-variable variableName="idpActionId"        value="#[payload.idpActionId default p('anypoint.idp.actionId')]" doc:name="Extract Action ID"/>
                    <set-variable variableName="idpActionVersionId" value="#[payload.idpActionVersionId default p('anypoint.idp.actionVersionId')]" doc:name="Extract Version ID"/>

                    <!-- Execute IDP extraction + poll for result -->
                    <flow-ref name="idp-execute-and-poll-subflow" doc:name="IDP Execute and Poll"/>

                    <!--
                        Map IDP result to canonical {{IDP_OUTPUT_ENTITY}} schema.
                        vars.idpPages contains the full pages array.
                        Access fields via: vars.idpPages[0].fields.{fieldLabel}.value
                        See: src/main/resources/dwl/map-idp-result-to-{{IDP_OUTPUT_ENTITY}}.dwl
                    -->
                    <ee:transform doc:name="Map IDP Pages to Canonical Schema">
                        <ee:message>
                            <ee:set-payload resource="dwl/map-idp-result-to-{{IDP_OUTPUT_ENTITY}}.dwl"/>
                        </ee:message>
                    </ee:transform>

                    <!-- TODO: Replace with actual target System API call -->
                    <flow-ref name="{{IDP_OUTPUT_ENTITY}}-create-flow" doc:name="Write to Target System"/>

                    <!-- Mark idempotent (TTL = message TTL: {{MESSAGE_TTL_HOURS}}h) -->
                    <os:store
                        key="#['idp-proc-' ++ attributes.messageId]"
                        value="#[true]"
                        objectStore="Idempotency_Object_Store"
                        entryTtl="{{MESSAGE_TTL_HOURS}}"
                        entryTtlUnit="HOURS"
                        doc:name="Mark Processed"/>

                    <anypoint-mq:ack config-ref="Anypoint_MQ_Config" ackToken="#[attributes.ackToken]" doc:name="ACK Success"/>

                    <logger
                        level="INFO"
                        message='#["[IDP-CONSUMER-END] messageId=" ++ attributes.messageId ++ " | correlationId=" ++ correlationId]'
                        doc:name="Log Consumer End"/>

                </otherwise>
            </choice>

            <error-handler>
                <on-error-propagate>
                    <anypoint-mq:nack config-ref="Anypoint_MQ_Config" ackToken="#[attributes.ackToken]" doc:name="NACK on Error"/>
                    <logger
                        level="ERROR"
                        message='#["[IDP-CONSUMER-ERROR] messageId=" ++ attributes.messageId ++ " | error=" ++ error.description ++ " | correlationId=" ++ correlationId]'
                        doc:name="Log Consumer Error"/>
                </on-error-propagate>
            </error-handler>

        </try>

    </flow>
    {{/if}}

</mule>
