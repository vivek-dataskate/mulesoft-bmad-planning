<?xml version="1.0" encoding="UTF-8"?>
<!--
    MUnit test file for SCHEDULED SYNC flows
    Pattern: scheduled-sync (D) — periodic delta sync with watermark
    Flow trigger: scheduler + watermark Object Store

    Coverage floor: {{MUNIT_COVERAGE}}% (enforced by munit-maven-plugin in pom.xml)

    Test cases generated:
      TC-1: Happy path           — records fetched, transformed, written → watermark advances
      TC-2: Connectivity failure → downstream unavailable → watermark NOT advanced → error envelope
      TC-3: Validation failure   → invalid record → invalid-messages-queue (not DLQ)
      TC-4: Empty result set     → source returns 0 records → downstream NOT called → watermark advances
      TC-5: Watermark advance    — Object Store updated to last processed timestamp
      TC-6: Watermark not advanced on partial failure

    Watermark rules:
      - Object Store type: persistent (not in-memory) — per standards
      - TTL: must equal or exceed maxConcurrency-aware window
      - Key: {flow-name}-watermark (or configured key in Object Store config)
      - Advance: only on COMPLETE successful run — not mid-batch
-->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
          http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit
          http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools
          http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/ee/core
          http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <munit:config name="{{FLOW_NAME}}-test" doc:name="MUnit Config"/>

    <!-- ══════════════════════════════════════════════════════════════════
         TC-1: Happy Path — records fetched → transformed → written → watermark advances
         ══════════════════════════════════════════════════════════════════ -->
    <munit:test
        name="{{FLOW_NAME}}-happy-path-test"
        doc:name="TC-1: Records fetched from source, transformed, written to target, watermark advances"
        description="Scheduler fires → source returns N records → downstream writes N records → OS watermark updated">

        <munit:behavior>
            <!-- Mock: watermark read — return previous watermark value -->
            <munit-tools:mock-when
                processor="os:retrieve"
                doc:name="Mock OS Retrieve watermark — existing value">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="Object_Store_Config"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='"2026-05-01T00:00:00Z"'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <!-- Mock: source system fetch (delta query with watermark) -->
            <!-- TODO: Replace with actual source connector for {{FLOW_SOURCE}} -->
            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock {{FLOW_SOURCE}} delta query — returns 2 records">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="HTTP_Request_Config"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value='#[[
    { "id": "rec-001", "lastModified": "2026-05-10T10:00:00Z", "name": "Record One" },
    { "id": "rec-002", "lastModified": "2026-05-10T11:00:00Z", "name": "Record Two" }
]]'
                        mediaType="application/json"/>
                    <munit-tools:attributes value='#[{ statusCode: 200 }]'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <!-- Mock: target system write — successful upsert -->
            <!-- TODO: Replace with actual target connector for {{FLOW_TARGET}} -->
            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock {{FLOW_TARGET}} upsert — success">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="HTTP_Request_Config_Target"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='#[{ "id": "upserted-001" }]' mediaType="application/json"/>
                    <munit-tools:attributes value='#[{ statusCode: 200 }]'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <!-- Mock: watermark write — store updated watermark -->
            <munit-tools:mock-when
                processor="os:store"
                doc:name="Mock OS Store — capture watermark write">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="Object_Store_Config"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='#[null]'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:run-flow name="{{FLOW_NAME}}">
                <munit:event>
                    <munit:payload value='#[null]' mediaType="application/json"/>
                </munit:event>
            </munit:run-flow>
        </munit:execution>

        <munit:validation>
            <!-- Watermark stored after successful run -->
            <munit-tools:verify-call
                processor="os:store"
                doc:name="Verify watermark advanced (OS store called)"
                times="1"/>
            <!-- Target write called per record (2 records → 2 calls) -->
            <!-- TODO: Adjust times to match actual record count in mock -->
            <munit-tools:verify-call
                processor="http:request"
                doc:name="Verify target write called per record"
                atLeast="1"/>
        </munit:validation>

    </munit:test>

    <!-- ══════════════════════════════════════════════════════════════════
         TC-2: Connectivity Failure → watermark NOT advanced → error envelope
         ══════════════════════════════════════════════════════════════════ -->
    <munit:test
        name="{{FLOW_NAME}}-connectivity-no-watermark-advance-test"
        doc:name="TC-2: Target unavailable → watermark NOT advanced, error envelope returned"
        description="Source returns records but target throws CONNECTIVITY → watermark stays at old value">

        <munit:behavior>
            <munit-tools:mock-when
                processor="os:retrieve"
                doc:name="Mock OS Retrieve — existing watermark">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="Object_Store_Config"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='"2026-05-01T00:00:00Z"'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock source — returns records">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="HTTP_Request_Config"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value='#[[{ "id": "rec-003", "lastModified": "2026-05-10T12:00:00Z" }]]'
                        mediaType="application/json"/>
                    <munit-tools:attributes value='#[{ statusCode: 200 }]'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <!-- Target always throws CONNECTIVITY -->
            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock target — CONNECTIVITY failure">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="HTTP_Request_Config_Target"/>
                </munit-tools:with-attributes>
                <munit-tools:then-throw>
                    <munit-tools:error typeId="HTTP:CONNECTIVITY" description="Target unavailable"/>
                </munit-tools:then-throw>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:run-flow name="{{FLOW_NAME}}">
                <munit:event>
                    <munit:payload value='#[null]' mediaType="application/json"/>
                </munit:event>
            </munit:run-flow>
        </munit:execution>

        <munit:validation>
            <!-- Watermark NOT advanced — run did not complete successfully -->
            <munit-tools:verify-call
                processor="os:store"
                doc:name="Verify watermark NOT advanced (OS store = 0)"
                times="0"/>
            <!-- Error envelope set on flow -->
            <munit-tools:assert-that
                expression="#[vars.httpStatus default 503]"
                is="#[MunitTools::equalTo(503)]"
                doc:name="Assert 503 on connectivity failure"/>
        </munit:validation>

    </munit:test>

    <!-- ══════════════════════════════════════════════════════════════════
         TC-3: Validation Failure → Invalid Message Channel (not DLQ)
         ══════════════════════════════════════════════════════════════════ -->
    <munit:test
        name="{{FLOW_NAME}}-validation-invalid-message-test"
        doc:name="TC-3: Invalid record routes to invalid-messages-queue, not DLQ"
        description="Source record missing required field → invalid-messages-queue → downstream 0 calls"
        ignore="true">

        <munit:behavior>
            <munit-tools:mock-when
                processor="os:retrieve"
                doc:name="Mock OS — existing watermark">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="Object_Store_Config"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='"2026-05-01T00:00:00Z"'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <!-- Source returns record with missing required field -->
            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock source — invalid record (missing id)">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="HTTP_Request_Config"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value='#[[{ "lastModified": "2026-05-10T12:00:00Z" }]]'
                        mediaType="application/json"/>
                    <munit-tools:attributes value='#[{ statusCode: 200 }]'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <munit-tools:mock-when
                processor="anypoint-mq:publish"
                doc:name="Mock invalid-messages-queue publish">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="destination" whereValue="${mq.queue.invalid-messages}"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return><munit-tools:payload value='#[null]'/></munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:run-flow name="{{FLOW_NAME}}">
                <munit:event>
                    <munit:payload value='#[null]' mediaType="application/json"/>
                </munit:event>
            </munit:run-flow>
        </munit:execution>

        <munit:validation>
            <munit-tools:verify-call
                processor="http:request"
                doc:name="Verify target NOT called"
                atMost="0"/>
            <munit-tools:verify-call
                processor="anypoint-mq:publish"
                doc:name="Verify invalid-messages-queue publish"
                times="1"/>
        </munit:validation>

    </munit:test>

    <!-- ══════════════════════════════════════════════════════════════════
         TC-4: Empty Result Set — scheduler fires, source returns 0 records
         ══════════════════════════════════════════════════════════════════ -->
    <munit:test
        name="{{FLOW_NAME}}-empty-source-result-test"
        doc:name="TC-4: Source returns 0 records — downstream NOT called, watermark advances (no data to process)"
        description="No records since last watermark → target not called → watermark still updated to now">

        <munit:behavior>
            <munit-tools:mock-when
                processor="os:retrieve"
                doc:name="Mock OS — existing watermark">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="Object_Store_Config"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='"2026-05-01T00:00:00Z"'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <!-- Source returns empty list -->
            <munit-tools:mock-when
                processor="http:request"
                doc:name="Mock source — 0 records">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="HTTP_Request_Config"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='#[[]]' mediaType="application/json"/>
                    <munit-tools:attributes value='#[{ statusCode: 200 }]'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <munit-tools:mock-when
                processor="os:store"
                doc:name="Mock OS Store — watermark update">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="Object_Store_Config"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return><munit-tools:payload value='#[null]'/></munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:run-flow name="{{FLOW_NAME}}">
                <munit:event>
                    <munit:payload value='#[null]' mediaType="application/json"/>
                </munit:event>
            </munit:run-flow>
        </munit:execution>

        <munit:validation>
            <!-- Target not called when no records -->
            <munit-tools:verify-call
                processor="http:request"
                doc:name="Verify target NOT called (0 records)"
                atMost="0"/>
            <!-- No errors generated -->
            <munit-tools:assert-that
                expression="#[vars.httpStatus default 200]"
                is="#[MunitTools::not(MunitTools::equalTo(500))]"
                doc:name="Assert no error status"/>
        </munit:validation>

    </munit:test>

</mule>
