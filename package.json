{
  "name": "mulesoft-bmad-planning",
  "version": "1.0.0",
  "description": "MuleSoft BMAD Planning System — scaffold generator and pipeline scripts",
  "private": true,
  "scripts": {
    "transcribe": "node scripts/transcribe-recordings.js",
    "load-inbox": "node scripts/load-inbox.js",
    "scout-pipeline": "node scripts/run-scout-pipeline.js --all",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --coverageThreshold='{\"global\":{\"lines\":80,\"functions\":80,\"branches\":70}}'",
    "move-sources": "node scripts/move-sources.js",
    "lint": "eslint scaffold/*.js tests/**/*.js",
    "lint:html": "htmlhint 'firebase/public/**/*.html' 'projects/**/intake/*.html' --config .htmlhintrc && node commons/branding/lint-html.js",
    "lint:style": "stylelint 'firebase/public/**/*.html' 'projects/**/intake/*.html'",
    "lint:format": "prettier --check './*.json' '.htmlhintrc'",
    "lint:a11y": "node scripts/lint-a11y.js",
    "lint:all": "npm run lint:html && npm run lint:style && npm run lint:format",
    "prepare": "cp .claude/hooks/lint-html.sh .git/hooks/lint-html-claude.sh 2>/dev/null; { cp scripts/pre-commit-hook.sh .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit; } 2>/dev/null || true",
    "build:tokens": "node scripts/build-tokens.js",
    "build:html": "npm run build:tokens && eleventy",
    "build:html:watch": "eleventy --serve",
    "vr:baseline": "node scripts/generate-backstop-config.js && npx backstop reference",
    "vr:baseline:intake": "node scripts/generate-backstop-config.js --intake && npx backstop reference",
    "vr:diff": "node scripts/generate-backstop-config.js && npx backstop test",
    "vr:diff:intake": "node scripts/generate-backstop-config.js --intake && npx backstop test",
    "vr:approve": "npx backstop approve"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/unit/**/*.test.js",
      "<rootDir>/tests/integration/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "scaffold/generate.js",
      "scaffold/validate-intake.js",
      "scaffold/check-registry-freshness.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "branches": 70
      }
    },
    "testTimeout": 15000
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "axe-core": "^4.11.4",
    "backstopjs": "^6.3.25",
    "htmlhint": "^1.9.2",
    "jest": "^29.7.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "style-dictionary": "^4.4.0",
    "stylelint": "^16.26.1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "firebase-admin": "^13.9.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^24.43.1"
  }
}
