{# pricing-model-card-iaas.njk — IaaS column on ds-pricing-model.html #}
<div class="model-card iaas">
  <div class="model-title">IaaS — Managed Service</div>
  <div class="model-sub">DataSkate builds, runs, and owns outcomes</div>
  <div class="model-row"><span class="lbl">Monthly rate</span><span class="val big">{{ pricing.formatted.baseRate }}<span style="font-size:10px;font-weight:400;color:var(--mid);">/flow/mo</span></span></div>
  <div class="model-row"><span class="lbl">Implementation</span><span class="val">$0 upfront</span></div>
  <div class="model-row"><span class="lbl">Minimum term</span><span class="val">1 year per flow</span></div>
  <div class="model-row"><span class="lbl">Payment cadence</span><span class="val">Every 6 months, in advance</span></div>
  <div class="model-row"><span class="lbl">Billing starts</span><span class="val">At go-live</span></div>
  <div class="model-row"><span class="lbl">Kickoff retainer</span><span class="val">{{ pricing.formatted.retainerRange }} (credited at go-live)</span></div>
  <div class="model-row"><span class="lbl">Period 2 rate</span><span class="val">{{ pricing.formatted.p2rate }}/flow/mo (month 7+)</span></div>
  <span class="badge recommended">Recommended for most clients</span>
</div>
