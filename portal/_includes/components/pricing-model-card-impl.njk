{# pricing-model-card-impl.njk — Implementation Only column #}
<div class="model-card impl">
  <div class="model-title">Implementation Only</div>
  <div class="model-sub">DataSkate builds and hands off</div>
  <div class="model-row"><span class="lbl">Standard rate</span><span class="val big">{{ pricing.formatted.implPerFlow }}<span style="font-size:10px;font-weight:400;color:var(--mid);">/flow</span></span></div>
  <div class="model-row"><span class="lbl">50% due</span><span class="val">At SOW signing</span></div>
  <div class="model-row"><span class="lbl">50% due</span><span class="val">At UAT sign-off</span></div>
  <div class="model-row"><span class="lbl">Ongoing fees</span><span class="val">None — code transfers at UAT</span></div>
  <div class="model-row"><span class="lbl">Phase 2 path</span><span class="val">Agent development SOW</span></div>
  <span class="badge green">Use when client self-maintains</span>
</div>
