{#
  layouts/pitch-kit.njk
  ─────────────────────
  3-tab internal pitch kit: Overview (diagram) | Pitch (call prep) | Intel (corporate research).
  Overview + Pitch tabs: shells filled at runtime from Firestore (pitchKits/{slug}).
  Intel tab: rendered at build time from projects/{slug}/intake/pitch-kit-content.json.
  Auth gate: Firebase Google Sign-In restricted to @dataskate.ai accounts.
  Inputs (via page data from clientsWithPitchKit):
    client.slug
    client.clientName
    client.pitchKit   — pitch-kit-content.json object
#}
{% extends "layouts/base.njk" %}

{% set pk = client.pitchKit %}

{% block head %}
<style>
a{text-decoration:none}

/* Header */
.header{background:#fff;border-bottom:3px solid var(--brand);padding:18px 48px 14px;max-width:1024px;margin:0 auto}
.header-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.eyebrow{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mid);display:flex;align-items:center;gap:8px}
.internal-badge{background:var(--brand);color:#fff;font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:2px 8px;border-radius:3px}
.header-title{font-size:22px;font-weight:800;color:var(--dark);border-left:4px solid var(--brand);padding-left:14px;margin-bottom:8px}
.fact-chips{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:6px}
.chip{font-size:12px;font-weight:600;color:var(--dark);background:var(--light);border:1px solid var(--border);padding:3px 10px;border-radius:3px;display:inline-flex;gap:5px}
.chip span{color:var(--mid);font-weight:400}
.stack-chips{display:flex;flex-wrap:wrap;gap:5px}
.stack-pill{font-size:11px;font-weight:700;color:var(--brand);background:#fff;border:1px solid var(--brand);padding:2px 9px;border-radius:10px;text-transform:uppercase;letter-spacing:.04em}

/* Tabs */
.tab-bar{max-width:1024px;margin:0 auto;border-bottom:2px solid var(--border);display:flex;padding:0 48px;position:sticky;top:0;background:#fff;z-index:10}
.tab-btn{font-size:13px;font-weight:600;color:var(--mid);padding:10px 20px;border:none;background:none;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;transition:color .15s,border-color .15s}
.tab-btn:hover{color:var(--dark)}
.tab-btn.active{color:var(--brand);border-bottom-color:var(--brand);font-weight:700}
.tab-panel{display:none;max-width:1024px;margin:0 auto;padding:32px 48px 60px}
.tab-panel.active{display:block}

/* Overview */
.diagram-hero{margin-bottom:24px;overflow-x:auto;display:flex;justify-content:center;padding:8px 0}
.diagram-hero svg{max-width:100%;height:auto}
.overview-meta{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px}
.overview-fact{display:flex;flex-direction:column;gap:2px;padding:10px 16px;border:1px solid var(--border);border-radius:6px;min-width:130px}
.overview-fact-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--mid)}
.overview-fact-value{font-size:14px;font-weight:700;color:var(--dark)}
.overview-portfolio{background:var(--light);border-left:4px solid var(--brand);padding:12px 18px;border-radius:0 6px 6px 0;font-size:14px;color:var(--dark);line-height:1.5;margin-bottom:24px}
.overview-portfolio strong{color:var(--brand)}
.btn-next{background:var(--brand);color:#fff;border:none;padding:12px 28px;border-radius:6px;font-size:14px;font-weight:700;cursor:pointer}
.btn-next:hover{background:var(--brand-dk)}
.btn-link{background:none;border:none;color:var(--brand);font-size:13px;font-weight:600;cursor:pointer;text-decoration:underline;padding:8px}

/* Pitch sections */
section{border-bottom:1px solid var(--border);padding:24px 0}
section:last-of-type{border-bottom:none}
section h2{font-size:11px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--brand);margin-bottom:14px;display:flex;align-items:center;gap:10px}
section h2::before{content:'';display:inline-block;width:18px;height:2px;background:var(--brand);flex-shrink:0}
.p-badge{font-size:10px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;padding:3px 9px;border-radius:3px;white-space:nowrap;flex-shrink:0}
.p1{background:var(--brand);color:#fff}
.p2{background:var(--amber-bg);color:var(--amber);border:1px solid var(--amber)}
.p3{background:var(--light);color:var(--mid);border:1px solid var(--border)}
.opener-block{border-left:4px solid var(--brand);padding:14px 18px;margin-bottom:8px;background:var(--light);border-radius:0 6px 6px 0}
.opener-context{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--mid);margin-bottom:6px}
.opener-line{font-size:14px;font-style:italic;color:var(--dark);line-height:1.6}
.opener-line::before{content:'\201C';color:var(--brand);font-style:normal;font-weight:700}
.opener-line::after{content:'\201D';color:var(--brand);font-style:normal;font-weight:700}
.obj-card{border:1px solid var(--border);border-radius:6px;margin-bottom:8px;overflow:hidden}
.obj-head{padding:9px 14px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--border);background:#fafafa}
.obj-trigger{font-size:12px;font-weight:600;color:var(--dark);flex:1;line-height:1.35}
.obj-body{padding:12px 14px}
.obj-say{font-size:14px;font-style:italic;color:var(--dark);line-height:1.6;margin-bottom:6px}
.obj-say::before{content:'\201C';color:var(--brand);font-style:normal}
.obj-say::after{content:'\201D';color:var(--brand);font-style:normal}
.obj-impact{font-size:12px;color:var(--mid);line-height:1.4;border-top:1px solid var(--border);padding-top:6px;margin-top:2px}
.proof-table{width:100%;border-collapse:collapse;font-size:13px}
.proof-table th{background:var(--dark);color:#fff;padding:8px 12px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em}
.proof-table td{padding:10px 12px;border-bottom:1px solid var(--border);vertical-align:top;line-height:1.4}
.proof-table tr:last-child td{border-bottom:none}
.proof-stat{font-weight:700;color:var(--green);display:block;margin-bottom:2px}
.proof-say{font-size:12px;font-style:italic;color:var(--mid);margin-top:5px;padding-top:5px;border-top:1px solid var(--border)}
.proof-say::before{content:'Say: \201C';font-style:normal;font-weight:700;font-size:10px;color:var(--brand);text-transform:uppercase;display:block;margin-bottom:2px}
.tier-exact-badge{font-size:10px;font-weight:700;background:var(--light);color:var(--brand);border:1px solid var(--border);padding:1px 6px;border-radius:3px}
.tier-stat-badge{font-size:10px;font-weight:700;background:var(--light);color:var(--mid);border:1px solid var(--border);padding:1px 6px;border-radius:3px}
.stall-block{background:var(--amber-bg);border-left:4px solid var(--amber);padding:16px 20px;border-radius:0 6px 6px 0}
.stall-label{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--amber);margin-bottom:6px}
.ai-line-block{border-left:4px solid var(--blue-br);padding:12px 16px;background:var(--blue-bg);border-radius:0 6px 6px 0;margin-bottom:10px}
.ai-narrative{font-size:13px;line-height:1.7;color:var(--mid)}
.portfolio-frame{border-left:4px solid var(--brand);background:var(--light);padding:12px 16px;border-radius:0 6px 6px 0;margin-bottom:12px}
.portfolio-greenfield{background:var(--amber-bg);border-left-color:var(--amber)}
.pf-eyebrow{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--mid);margin-bottom:4px}
.portfolio-greenfield .pf-eyebrow{color:var(--amber)}
.pf-platform{font-size:14px;font-weight:700;color:var(--dark);margin-bottom:6px}
.pf-platform span{color:var(--mid);font-weight:400}
.pf-angle{font-size:14px;line-height:1.6;color:var(--dark);font-style:italic;margin-bottom:6px}
.pf-angle::before{content:'\201C';color:var(--brand);font-style:normal;font-weight:700}
.pf-angle::after{content:'\201D';color:var(--brand);font-style:normal;font-weight:700}
.pf-exec{font-size:12px;color:var(--mid);line-height:1.5;border-top:1px solid var(--border);padding-top:6px;margin-top:6px}
.pf-exec strong{color:var(--dark)}
.sib-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}
.sib-row{border:1px solid var(--border);border-radius:5px;padding:8px 10px;background:#fff}
.sib-name{font-size:13px;font-weight:700;color:var(--dark);margin-bottom:2px}
.sib-name a{color:var(--dark)}
.sib-meta{font-size:11px;color:var(--mid);margin-bottom:4px}
.sib-signal{font-size:12px;line-height:1.4;color:var(--dark)}
.sib-signal.unknown{color:var(--mid);font-style:italic}

/* Intel — corporate stack */
.stack-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.stack-card{border:1px solid var(--border);border-radius:7px;padding:12px 14px 14px;background:#fff;display:flex;flex-direction:column;gap:5px}
.stack-role{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--mid)}
.stack-name{font-size:15px;font-weight:800;color:var(--dark);line-height:1.25}
.stack-meta{font-size:12px;color:var(--mid);line-height:1.4}
.brand-card{border-left:3px solid var(--brand)}
.platform-card{border-left:3px solid var(--green)}
.sponsor-card{border-left:3px solid var(--amber)}

/* Intel — why now */
.why-now-list{display:flex;flex-direction:column;gap:8px}
.why-now-item{font-size:13px;color:var(--dark);line-height:1.5;padding:10px 14px;border-left:3px solid var(--brand);background:var(--light);border-radius:0 6px 6px 0}
.why-now-item:first-child{background:var(--amber-bg);border-left-color:var(--amber)}
.why-now-tag{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--brand);display:block;margin-bottom:3px}
.why-now-item:first-child .why-now-tag{color:var(--amber)}

/* Intel — exec grid */
.exec-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.exec-card{border:1px solid var(--border);border-radius:6px;padding:10px 12px;background:#fff}
.exec-name{font-size:13px;font-weight:700;color:var(--dark)}
.exec-title{font-size:12px;color:var(--mid);margin-top:1px}
.exec-scope{font-size:12px;color:var(--dark);line-height:1.5;margin-top:6px}
.exec-source{font-size:11px;color:var(--mid);margin-top:4px}
.exec-sponsor-badge{font-size:9px;background:var(--amber);color:#fff;padding:2px 6px;border-radius:3px;margin-left:6px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}

/* Intel — sibling portfolio (drawn from Drew data) */
.sibling-wrap{display:flex;flex-direction:column;gap:8px}
.sibling-row{display:grid;grid-template-columns:180px 1fr;gap:12px;align-items:start;padding:10px 12px;border:1px solid var(--border);border-radius:6px;background:#fff}
.sibling-name{font-size:13px;font-weight:700;color:var(--dark)}
.sibling-name a{color:var(--dark)}
.sibling-current{font-size:9px;background:var(--brand);color:#fff;padding:2px 6px;border-radius:3px;margin-left:6px;font-weight:800;text-transform:uppercase;vertical-align:middle}
.sibling-meta{font-size:11px;color:var(--mid);margin-top:2px}
.sibling-signal{font-size:12px;color:var(--dark);line-height:1.5}
.sibling-signal.unknown{color:var(--mid);font-style:italic}
.sibling-customers{font-size:11px;color:var(--green);margin-top:4px}

/* Intel — per-person angles */
.person-card{border:1px solid var(--border);border-radius:6px;padding:14px 16px;margin-bottom:8px;background:#FFFEF8}
.person-header{display:flex;justify-content:space-between;align-items:start;margin-bottom:8px}
.person-name{font-size:13px;font-weight:700;color:var(--dark)}
.person-meta{font-size:11px;color:var(--mid);margin-top:2px}
.role-pill{font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:3px 8px;border-radius:3px;background:var(--brand);color:#fff;white-space:nowrap}
.role-pill.eb{background:var(--amber)}
.role-pill.champion{background:var(--green)}
.role-pill.gate{background:var(--mid)}
.person-angle{font-size:12px;color:var(--dark);line-height:1.5;margin-top:6px}
.angle-label{font-weight:700;color:var(--brand-dk);display:inline-block;min-width:80px}
.person-talkpoint{font-size:12px;color:var(--dark);line-height:1.5;padding-top:6px;margin-top:6px;border-top:1px dashed var(--border);font-style:italic}
.person-flag{font-size:11px;color:var(--amber);margin-top:4px}

/* Intel — future biz */
.future-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.future-card{border:1px solid var(--border);border-radius:6px;padding:10px 12px;background:#fff}
.future-name{font-size:12px;font-weight:700;color:var(--dark)}
.future-org{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--brand);margin-top:2px}
.future-why{font-size:12px;color:var(--mid);line-height:1.5;margin-top:6px}

/* Intel — pre-call outreach */
.outreach-list{display:flex;flex-direction:column;gap:8px}
.outreach-item{background:var(--amber-bg);border-left:3px solid var(--amber);padding:10px 14px;border-radius:0 6px 6px 0;font-size:13px;color:var(--dark);line-height:1.5}
.outreach-name{font-weight:700;color:var(--amber);display:block;margin-bottom:3px;font-size:12px;text-transform:uppercase;letter-spacing:.06em}

/* Intel — corporate profile */
.profile-toggle{font-size:12px;font-weight:600;color:var(--brand);cursor:pointer;background:none;border:none;padding:8px 0;display:flex;align-items:center;gap:6px}
.profile-body{display:none;padding-top:12px}
.profile-body.open{display:block}
.profile-narrative{font-size:13px;color:var(--dark);line-height:1.65}
.profile-narrative h2{font-size:13px;font-weight:800;color:var(--brand-dk);margin:16px 0 6px}
.profile-narrative h2::before{display:none}
.profile-narrative p{margin-bottom:10px}
.profile-narrative ul,.profile-narrative ol{margin:8px 0 12px 18px}
.profile-narrative li{margin-bottom:4px}
.profile-meta{font-size:11px;color:var(--mid);padding-top:8px;border-top:1px dashed var(--border);margin-top:10px}

/* Intel — citations */
.citations{display:flex;flex-wrap:wrap;gap:6px}
.citation-chip{font-size:11px;padding:4px 10px;border:1px solid var(--border);border-radius:12px;background:#fff;color:var(--mid)}
.citation-chip a{color:var(--mid)}
.citation-chip a:hover{color:var(--brand)}

/* Auth / Loading */
#login-screen{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;padding:40px;background:#fff}
#login-screen p{font-size:14px;color:var(--mid);text-align:center;max-width:320px;margin:0}
.btn-google{display:flex;align-items:center;gap:12px;background:#fff;border:2px solid var(--border);padding:12px 24px;border-radius:8px;font-size:14px;font-weight:600;color:var(--dark);cursor:pointer;transition:border-color .15s}
.btn-google:hover{border-color:var(--brand)}
.btn-google svg{width:20px;height:20px;flex-shrink:0}
#login-error{color:var(--brand-dk);font-size:13px;font-weight:600;background:var(--light);border:1px solid var(--brand);padding:10px 18px;border-radius:6px;display:none}
#deck-loading{min-height:100vh;display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:#fff}
#deck-loading p{font-size:14px;color:var(--mid)}
.spinner{width:32px;height:32px;border:3px solid var(--border);border-top-color:var(--brand);border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
#deck-content{display:none}

/* Footer */
.footer{border-top:1px solid var(--border);padding:16px 48px;font-size:12px;color:var(--mid);display:flex;justify-content:space-between;align-items:center;max-width:1024px;margin:0 auto}

@media(max-width:700px){
  .header,.tab-panel{padding-left:20px;padding-right:20px}
  .tab-bar{padding:0 20px}
  .stack-grid,.exec-grid,.future-grid,.sib-grid,.sibling-row{grid-template-columns:1fr}
}
</style>
{% endblock %}

{% block body %}

{# ── AUTH GATE ─────────────────────────────────────────────────── #}
