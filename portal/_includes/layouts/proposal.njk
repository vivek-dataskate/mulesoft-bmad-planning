{% block scripts %}
{# ── Inject build-time constants so Firebase JS can read them ── #}
<script>
window.__PROP_SLUG  = "{{ ((proposal.meta.clientSlug if proposal and proposal.meta) or '') | esc }}";
window.__PROP_NAME  = "{{ ((proposal.meta.clientName if proposal and proposal.meta) or '') | esc }}";
window.__PROP_EMAIL = "{{ ((proposal.meta.architectEmail if proposal and proposal.meta) or '') | esc }}";
window.__PROP_ARCH  = "{{ ((proposal.meta.architect if proposal and proposal.meta) or '') | esc }}";
window.__PROP_RATE  = {{ pricing.baseRate if proposalPricing else 0 }};
window.__PROP_FLOWS = {{ ((proposal.meta.flowCount if proposal and proposal.meta) or 0) }};
window.__PROP_MODEL = "{{ ((proposalPricing.recModel if proposalPricing) or '') | esc }}";
</script>
{% raw %}<script>
const CLIENT_SLUG         = window.__PROP_SLUG;
const CLIENT_NAME         = window.__PROP_NAME;
const ARCHITECT_EMAIL     = window.__PROP_EMAIL;
const ARCHITECT_NAME      = window.__PROP_ARCH;
const PROPOSAL_RATE       = window.__PROP_RATE;
const PROPOSAL_FLOW_COUNT = window.__PROP_FLOWS;
const PROPOSAL_MODEL      = window.__PROP_MODEL;

// ── FIREBASE CONFIG ──────────────────────────────────────────────────────────
const FIREBASE_CONFIG = {
  apiKey:            "AIzaSyDCpzgZAMWWGwedG5At5Ml3gn_yA0dRVZk",
  authDomain:        "dataskateclients.firebaseapp.com",
  projectId:         "dataskateclients",
  storageBucket:     "dataskateclients.firebasestorage.app",
  messagingSenderId: "620173241148",
  appId:             "1:620173241148:web:d5bf84e63e93ef94758c39"
};

// ── FIREBASE INIT ─────────────────────────────────────────────────────────────
(function () {
  ["https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js",
   "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"
  ].forEach(src => {
    const s = document.createElement('script');
    s.src = src; s.async = false;
    document.head.appendChild(s);
  });
})();

function getDb() {
  if (typeof firebase === 'undefined') return null;
  if (!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
  return firebase.firestore();
}

// ── VIEW TRACKING ─────────────────────────────────────────────────────────────
function trackView() {
  const db = getDb();
  if (!db || !CLIENT_SLUG) return;
  db.collection('proposalViews').doc(CLIENT_SLUG).set({
    client:       CLIENT_SLUG,
    lastViewedAt: firebase.firestore.FieldValue.serverTimestamp(),
    viewCount:    firebase.firestore.FieldValue.increment(1)
  }, { merge: true }).catch(() => {});
}

// ── TAB SWITCHING ─────────────────────────────────────────────────────────────
function showTab(id, btn) {
  document.querySelectorAll('.tab-panel').forEach(p => { p.style.display = 'none'; });
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + id).style.display = '';
  if (btn) btn.classList.add('active');
  const toggleBtn = document.querySelector('.sticky-bar button[onclick*="toggleAllSections"]');
  if (toggleBtn) toggleBtn.textContent = 'Expand All';
}

// ── LET'S TALK — always goes to investment section on Proposal tab ────────────
function goToInvestment() {
  const proposalBtn = document.querySelector('.tab-btn[data-tab="proposal"]');
  showTab('proposal', proposalBtn);
  setTimeout(() => {
    const inv = document.getElementById('investment-details');
    if (inv) { inv.open = true; inv.scrollIntoView({ behavior: 'smooth' }); }
  }, 80);
}

// ── EXPAND / COLLAPSE ALL (active tab only) ───────────────────────────────────
function toggleAllSections(btn) {
  let activePanel = null;
  document.querySelectorAll('.tab-panel').forEach(p => { if (p.style.display !== 'none') activePanel = p; });
  if (!activePanel) activePanel = document.querySelector('.tab-panel');
  const sections = activePanel.querySelectorAll('details.section-block');
  const isExpand = btn.textContent.trim() === 'Expand All';
  sections.forEach(d => { d.open = isExpand; });
  btn.textContent = isExpand ? 'Collapse All' : 'Expand All';
}

// ── PRICING — MODEL SELECTION ─────────────────────────────────────────────────
function selectModel(type, name, rate) {
  document.querySelectorAll('.model-card').forEach(c => c.style.borderColor = '');
  const card = document.querySelector('.model-card[data-model="' + type + '"]');
  if (card) card.style.borderColor = 'var(--brand)';
  const el = id => document.getElementById(id);

  const rateSection = el('iaas-rate-section');
  const implPitch   = el('impl-persuasion');
  const tmSection   = el('tm-rate-section');
  if (rateSection) rateSection.style.display = type === 'iaas' ? '' : 'none';
  if (implPitch)   implPitch.style.display   = type === 'impl' ? '' : 'none';
  if (tmSection)   tmSection.style.display   = type === 'tm'   ? '' : 'none';

  if (el('selected-model-name')) el('selected-model-name').textContent = name;
  if (el('selected-rate'))       el('selected-rate').textContent       = rate;
  _selectedModel = name;
  _selectedListedRate = rate;

  const rateLabel = el('negotiate-rate-label');
  const rateInput = el('negotiate-rate');
  if (type === 'impl') {
    if (rateLabel) rateLabel.textContent = 'Proposed fee (optional)';
    if (rateInput) rateInput.placeholder = 'e.g. $9,000 total';
  } else if (type === 'tm') {
    if (rateLabel) rateLabel.textContent = 'Proposed total estimate (optional)';
    if (rateInput) rateInput.placeholder = 'e.g. $25,000 total';
  } else {
    if (rateLabel) rateLabel.textContent = 'Proposed rate (optional)';
    if (rateInput) rateInput.placeholder = 'e.g. $275/flow/month';
  }

  openNegotiateModal();
}

// ── NEGOTIATION THREAD ────────────────────────────────────────────────────────
// Thread lives in Firestore: negotiations/{clientId}
// Structure: { thread: [{seq, by, authorName, model, amount, note, ts}], status }
//
// DataSkate responds via Firebase Console (add to thread[] array with by:'dataskate').
// Client submits counter-offers via this form.

const NEG_LS_KEY = 'neg_thread_' + CLIENT_SLUG;
let _negThread = [];   // in-memory cache of the thread
let _selectedModel = '', _selectedListedRate = '';

function saveNegThreadLocally(thread) {
  try { localStorage.setItem(NEG_LS_KEY, JSON.stringify(thread)); } catch(e) {}
}
function loadNegThreadLocally() {
  try { const r = localStorage.getItem(NEG_LS_KEY); return r ? JSON.parse(r) : null; } catch(e) { return null; }
}

function loadNegotiationThread(attempt) {
  // 1. Render from localStorage immediately
  const local = loadNegThreadLocally();
  if (local && local.length) { _negThread = local; renderNegThread(); }

  // 2. Sync from Firestore
  attempt = attempt || 0;
  const db = getDb();
  if (!db) { if (attempt < 10) setTimeout(() => loadNegotiationThread(attempt + 1), 400); return; }
  db.collection('negotiations').doc(CLIENT_SLUG).get().then(snap => {
    if (!snap.exists) return;
    const thread = snap.data().thread || [];
    _negThread = thread;
    saveNegThreadLocally(thread);
    renderNegThread();
  }).catch(() => {});
}

function renderNegThread() {
  const wrap = document.getElementById('neg-thread-wrap');
  const list  = document.getElementById('neg-thread-list');
  if (!wrap || !list || !_negThread.length) return;
  wrap.style.display = '';
  list.innerHTML = _negThread.map(entry => {
    const isDS   = entry.by === 'dataskate';
    const align  = isDS ? 'right' : 'left';
    const bg     = isDS ? '#EBF4FF' : '#F9FAFB';
    const border = isDS ? '#BFDBFE' : '#E5E7EB';
    const label  = isDS ? (entry.authorName || 'DataSkate') : (entry.authorName || 'You');
    const date   = entry.ts ? new Date(entry.ts).toLocaleDateString('en-US', {month:'short',day:'numeric'}) : '';
    return `<div style="display:flex;flex-direction:column;align-items:${isDS?'flex-end':'flex-start'};margin-bottom:10px">
      <div style="font-size:10px;color:#9ca3af;margin-bottom:3px;text-align:${align}">${label} · ${date}</div>
      <div style="background:${bg};border:1px solid ${border};border-radius:8px;padding:10px 14px;max-width:80%">
        ${entry.amount ? `<div style="font-size:16px;font-weight:800;color:#111827;margin-bottom:2px">${entry.amount}</div>` : ''}
        ${entry.model  ? `<div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:#6b7280;margin-bottom:4px">${entry.model}</div>` : ''}
        ${entry.note   ? `<div style="font-size:12px;color:#374151;line-height:1.5">${entry.note}</div>` : ''}
      </div>
    </div>`;
  }).join('');

  // Show the last DataSkate offer as the "current offer" banner
  const lastDS = [..._negThread].reverse().find(e => e.by === 'dataskate');
  const banner = document.getElementById('neg-current-offer');
  if (banner && lastDS && lastDS.amount) {
    banner.style.display = '';
    const el = id => document.getElementById(id);
    if (el('neg-offer-amount')) el('neg-offer-amount').textContent = lastDS.amount;
    if (el('neg-offer-model'))  el('neg-offer-model').textContent  = lastDS.model || '';
  }

  const alreadyAccepted = !!localStorage.getItem('proposal_accepted_' + CLIENT_SLUG);
  const counterBtnEl = document.getElementById('neg-counter-btn');
  if (counterBtnEl) counterBtnEl.style.display = alreadyAccepted ? 'none' : '';
}

async function submitCounterOffer() {
  const el = id => document.getElementById(id);
  const name  = (el('negotiate-name')  || {}).value || '';
  const rate  = (el('negotiate-rate')  || {}).value || '';
  const notes = (el('negotiate-notes') || {}).value || '';
  if (!name.trim()) { el('negotiate-name') && el('negotiate-name').focus(); return; }

  const btn = el('negotiate-btn');
  if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }

  const entry = {
    seq:        _negThread.length + 1,
    by:         'client',
    authorName: name.trim(),
    model:      _selectedModel,
    amount:     rate.trim() || null,
    note:       notes.trim() || (_selectedModel ? 'Selected ' + _selectedModel + ' at listed rate.' : null),
    ts:         new Date().toISOString(),
  };

  // Also keep the legacy discountLog write for reporting
  const db = getDb();
  if (db) {
    try {
      await Promise.all([
        db.collection('negotiations').doc(CLIENT_SLUG).set({
          client:      CLIENT_SLUG,
          status:      'open',
          thread:      firebase.firestore.FieldValue.arrayUnion(entry),
          lastUpdated: firebase.firestore.FieldValue.serverTimestamp(),
        }, { merge: true }),
        db.collection('discountLog').doc(CLIENT_SLUG).set({
          project:     CLIENT_SLUG,
          client:      CLIENT_NAME,
          entries:     firebase.firestore.FieldValue.arrayUnion({
            ts: entry.ts, project: CLIENT_SLUG, client: CLIENT_NAME, architect: ARCHITECT_EMAIL,
            model: entry.model, listedRate: _selectedListedRate, proposedRate: rate || '', hasDiscount: !!rate.trim(), contactName: name.trim(), notes: notes || '',
          }),
          lastUpdated: firebase.firestore.FieldValue.serverTimestamp(),
        }, { merge: true }),
      ]);

      // Update local thread + re-render
      _negThread.push(entry);
      saveNegThreadLocally(_negThread);
      renderNegThread();

      // Reset form for the next round — clear rate + notes, keep name
      if (el('negotiate-rate'))  el('negotiate-rate').value  = '';
      if (el('negotiate-notes')) el('negotiate-notes').value = '';
      if (el('negotiate-notes')) el('negotiate-notes').style.height = 'auto';

      // Flash confirmation inside the panel, then hide it so the thread is front-and-center
      const successEl = el('selection-success');
      if (successEl) {
        successEl.style.display = 'block';
        setTimeout(() => {
          successEl.style.display = 'none';
          closeNegotiatePanel();
        }, 2500);
      }
    } catch(e) {
      console.warn('negotiation write failed:', e.message);
    }
  }
  if (btn) { btn.disabled = false; btn.textContent = rate.trim() ? 'Send Counter-Offer →' : 'Confirm Selection →'; }
}

// Keep legacy name for onclick handler in the template
function submitSelection() { submitCounterOffer(); }

function openNegotiateModal() {
  const backdrop = document.getElementById('neg-backdrop');
  if (!backdrop) return;
  backdrop.classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeNegotiatePanel(e) {
  // Close only when clicking the backdrop itself (not the modal content)
  if (e && e.target !== document.getElementById('neg-backdrop')) return;
  const backdrop = document.getElementById('neg-backdrop');
  if (backdrop) backdrop.classList.remove('open');
  document.body.style.overflow = '';
}

// Called by "Make Another Counter-Offer" button in the thread — pre-fills from last DS offer
function showNegotiatePanel() {
  const lastDSOffer = [..._negThread].reverse().find(e => e.by === 'dataskate');
  if (lastDSOffer && !_selectedModel) {
    _selectedModel      = lastDSOffer.model  || '';
    _selectedListedRate = lastDSOffer.amount || '';
    const nameEl = document.getElementById('selected-model-name');
    const rateEl = document.getElementById('selected-rate');
    if (nameEl) nameEl.textContent = _selectedModel || 'Previously selected model';
    if (rateEl) rateEl.textContent = lastDSOffer.amount || 'as previously quoted';
  }
  openNegotiateModal();
}

function onRateInput(val) {
  const btn = document.getElementById('negotiate-btn');
  if (btn) btn.textContent = val.trim() ? 'Send Counter-Offer →' : 'Confirm Selection →';
}

function onNotesInput(el) {
  el.style.height = 'auto';
  el.style.height = el.scrollHeight + 'px';
}

// ── ACCEPT PROPOSAL ──────────────────────────────────────────────────────────
function showAcceptPanel() {
  const panel = document.getElementById('accept-panel');
  if (!panel) return;
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
}

async function submitAcceptance() {
  const nameEl  = document.getElementById('accept-name');
  const emailEl = document.getElementById('accept-email');
  const name    = (nameEl  || {}).value || '';
  const email   = (emailEl || {}).value || '';
  if (!name.trim())  { if (nameEl)  nameEl.focus();  return; }
  if (!email.trim()) { if (emailEl) emailEl.focus(); return; }

  const db = getDb();
  if (!db) {
    alert('Firebase not available. Please email ' + ARCHITECT_EMAIL + ' to confirm acceptance.');
    return;
  }

  const btn = document.querySelector('#accept-panel .btn-primary');
  if (btn) { btn.disabled = true; btn.textContent = 'Saving…'; }

  try {
    const ref      = db.collection('proposals').doc(CLIENT_SLUG);
    const snap     = await ref.get();
    const existing = snap.exists ? snap.data() : {};

    // Find the agreed price — last DataSkate offer in thread, or listed rate if no negotiation
    const lastDSOffer = [...(_negThread || [])].reverse().find(e => e.by === 'dataskate');
    const agreedPrice  = lastDSOffer ? lastDSOffer.amount  : (_selectedListedRate || null);
    const agreedModel  = lastDSOffer ? lastDSOffer.model   : (_selectedModel || PROPOSAL_MODEL || null);

    const payload = {
      acceptedAt:        firebase.firestore.FieldValue.serverTimestamp(),
      acceptedBy:        { name: name.trim(), email: email.trim() },
      client:            CLIENT_SLUG,
      acceptedPrice:     agreedPrice,
      acceptedModel:     agreedModel,
      negotiationThread: _negThread.length ? _negThread : null,
    };
    if (!existing.ratePerFlow) {
      payload.ratePerFlow = PROPOSAL_RATE;
      payload.flowCount   = PROPOSAL_FLOW_COUNT;
      payload.model       = PROPOSAL_MODEL;
    }
    await ref.set(payload, { merge: true });

    // Persist to localStorage so the accepted state survives page reloads
    try {
      localStorage.setItem('proposal_accepted_' + CLIENT_SLUG, JSON.stringify({
        name: name.trim(), email: email.trim(), acceptedAt: new Date().toISOString()
      }));
    } catch(e) {}

    showAcceptedState(name.trim(), email.trim());
  } catch (e) {
    if (btn) { btn.disabled = false; btn.textContent = 'Confirm Acceptance →'; }
    alert('Could not save acceptance. Please try again or email ' + ARCHITECT_EMAIL);
  }
}

function showAcceptedState(name, email) {
  const success = document.getElementById('accept-success');
  const panel   = document.getElementById('accept-panel');
  const acceptBtn = document.getElementById('accept-btn');
  const nameEl  = document.getElementById('accept-name');
  const emailEl = document.getElementById('accept-email');
  if (success) success.style.display = 'block';
  if (panel)   panel.style.display = 'block';
  const btn = document.querySelector('#accept-panel .btn-primary');
  if (btn) btn.style.display = 'none';
  if (nameEl)  { nameEl.value = name || ''; nameEl.disabled = true; }
  if (emailEl) { emailEl.value = email || ''; emailEl.disabled = true; }
  if (acceptBtn) { acceptBtn.textContent = '✓ Proposal Accepted'; acceptBtn.style.background = 'var(--green)'; acceptBtn.onclick = null; acceptBtn.style.cursor = 'default'; }
}

function restoreAcceptedState() {
  // 1. Check localStorage first (instant)
  try {
    const raw = localStorage.getItem('proposal_accepted_' + CLIENT_SLUG);
    if (raw) { const d = JSON.parse(raw); showAcceptedState(d.name, d.email); return; }
  } catch(e) {}

  // 2. Fall back to Firestore (handles different browsers / cleared cache)
  function tryFirestore(attempt) {
    const db = getDb();
    if (!db) { if (attempt < 10) setTimeout(() => tryFirestore(attempt + 1), 400); return; }
    db.collection('proposals').doc(CLIENT_SLUG).get().then(snap => {
      if (!snap.exists || !snap.data().acceptedAt) return;
      const d = snap.data();
      const name  = (d.acceptedBy || {}).name  || '';
      const email = (d.acceptedBy || {}).email || '';
      try { localStorage.setItem('proposal_accepted_' + CLIENT_SLUG, JSON.stringify({ name, email, acceptedAt: d.acceptedAt })); } catch(e) {}
      showAcceptedState(name, email);
    }).catch(() => {});
  }
  tryFirestore(0);
}

// ── INIT ──────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function () {
  setTimeout(trackView, 800);
  restoreAcceptedState();
  loadNegotiationThread();
});
</script>{% endraw %}
