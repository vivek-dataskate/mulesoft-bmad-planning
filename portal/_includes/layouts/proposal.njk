{#
  layouts/proposal.njk
  ─────────────────────
  Per-client Integration Roadmap (proposal). Computed inputs arrive via
  docs/eleventy/site/intake/proposal.11tydata.js:

    proposal        — proposal-content.json payload
    proposalPricing — null when proposal.pricing != true; else computed pricing object
    proposalAbout   — structured object from commons/sales/about-dataskate.json
    proposalCS      — top-2 case studies scored by system + use-case overlap
    proposalDiagram — inline SVG string (from system-diagram.svg or buildDiagramSvg())
    client.logoPath — resolved Firebase URL of client logo

  Layout mirrors buildProposal() in fill-template.js. CSS is lifted verbatim.
#}
{% extends "layouts/base.njk" %}

{% block head %}
<style>
body { max-width: 1080px; margin: 0 auto; padding: 0 0 80px; }
p { font-size: 13px; color: #44546A; margin-bottom: 12px; line-height: 1.65; }
p:last-child { margin-bottom: 0; }
p strong, li strong { color: var(--dark); font-weight: 600; }
h3 { font-size: 18px; font-weight: 700; color: var(--dark); margin-bottom: 8px; line-height: 1.3; }
h4 { font-size: 14px; font-weight: 600; color: var(--dark); margin-bottom: 4px; }
.lead { font-size: 14px; color: var(--dark); font-weight: 400; line-height: 1.7; margin-bottom: 14px; }
.pull-quote { border-left: 4px solid var(--brand); background: var(--light); padding: 10px 14px; border-radius: 0 6px 6px 0; margin: 0 0 14px; font-size: 13px; font-weight: 500; color: var(--dark); line-height: 1.6; }

/* ── HEADER ── */
.header { background: #fff; border-bottom: 3px solid var(--brand); padding: 24px 40px 20px; }
.header-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
.logo-group { display: flex; align-items: center; gap: 0; }
.client-logo-block { display: flex; align-items: center; gap: 8px; margin-left: 6px; }
.client-logo-sep { width: 1px; height: 32px; background: var(--border); }
.client-logo-img { height: 32px; width: auto; max-width: 140px; object-fit: contain; }
.header .eyebrow { font-size: 11px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--mid); }
.header-title-block { border-left: 4px solid var(--brand); padding-left: 16px; margin-bottom: 16px; }
.header h1 { font-size: 26px; font-weight: 800; line-height: 1.2; margin-bottom: 4px; color: var(--dark); }
.header .subtitle { font-size: 13px; color: var(--mid); line-height: 1.6; max-width: 620px; }
.header-meta { display: flex; gap: 0; font-size: 12px; border-top: 1px solid var(--border); padding-top: 12px; flex-wrap: wrap; }
.header-meta span { color: var(--mid); padding-right: 20px; margin-right: 20px; border-right: 1px solid var(--border); line-height: 1.5; }
.header-meta span:last-child { border-right: none; margin-right: 0; }
.header-meta span strong { color: var(--dark); font-weight: 600; display: block; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1px; }

/* ── STICKY BAR ── */
.sticky-bar { position: sticky; top: 0; z-index: 100; background: #fff; border-bottom: 1px solid var(--border); padding: 8px 40px; display: flex; align-items: center; justify-content: flex-end; gap: 8px; }

/* ── TAB NAV ── */
.tab-nav { display: flex; padding: 0 40px; border-bottom: 2px solid var(--border); background: #fff; }
.tab-btn { padding: 10px 18px; border: none; border-bottom: 3px solid transparent; background: none; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--mid); margin-bottom: -2px; transition: color 0.15s, border-color 0.15s; }
.tab-btn:hover { color: var(--dark); }
.tab-btn.active { color: var(--brand); border-bottom-color: var(--brand); }

/* ── COLLAPSIBLE SECTIONS ── */
details.section-block { border-bottom: 1px solid var(--border); }
summary.section-head { display: flex; align-items: center; gap: 12px; cursor: pointer; padding: 13px 40px; list-style: none; user-select: none; }
summary.section-head::-webkit-details-marker { display: none; }
.section-summary { flex: 1; }
.section-eyebrow { font-size: 10px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--brand); margin-bottom: 2px; }
.section-title { font-size: 15px; font-weight: 700; color: var(--dark); }
.section-chevron { font-size: 11px; color: var(--mid); flex-shrink: 0; transition: transform 0.2s; }
details.section-block[open] .section-chevron { transform: rotate(180deg); }
.section-body { padding: 4px 40px 22px; }

/* ── CHALLENGE CARDS ── */
.challenge-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-top: 12px; }
.challenge-card { border: 1px solid var(--border); border-radius: 6px; padding: 14px; }
.challenge-card .card-label { font-size: 10px; font-weight: 600; color: var(--brand); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 6px; }
.challenge-card p { font-size: 12px; color: #44546A; margin: 0; line-height: 1.5; }

/* ── SOLUTION DIAGRAM ── */
.diagram-wrap { margin: 16px -40px 4px; display: flex; justify-content: center; overflow-x: auto; }
.diagram-wrap svg { width: 100%; height: auto; max-width: 1010px; }
.diagram-caption { font-size: 11px; color: var(--mid); text-align: center; margin-top: 8px; font-style: italic; line-height: 1.5; }

/* ── FLOW CARDS ── */
.flow-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.flow-card { border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; background: #fff; }
.flow-card .flow-num { font-size: 10px; font-weight: 600; color: var(--brand); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 3px; }
.flow-card .flow-name { font-size: 14px; font-weight: 600; color: var(--dark); margin-bottom: 3px; }
.flow-card .flow-route { font-size: 11px; color: var(--mid); margin-bottom: 6px; }
.flow-card .flow-value { font-size: 12px; color: #44546A; line-height: 1.55; }

/* ── COMPLEXITY BADGES ── */
.complexity-badge { display: inline-block; font-size: 10px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; padding: 2px 8px; border-radius: 20px; float: right; margin-top: 2px; }
.complexity-badge.high   { background: #FEF3C7; color: #92400E; }
.complexity-badge.medium { background: #EBEBEB; color: var(--mid); }
.complexity-badge.low    { background: #D1FAE5; color: #065F46; }

/* ── OUTCOMES ── */
.outcomes-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.outcome-card { background: var(--light); border-radius: 8px; padding: 14px 16px; display: flex; align-items: flex-start; gap: 12px; }
.outcome-icon { font-size: 20px; flex-shrink: 0; line-height: 1; }
.outcome-card-text h4 { font-size: 13px; font-weight: 600; color: var(--dark); margin-bottom: 3px; }
.outcome-card-text p  { font-size: 12px; color: #44546A; margin: 0; }

/* ── INCLUDED / OOS ── */
.included-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.inc-card { display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px; border-radius: 8px; background: var(--light); }
.inc-check { width: 22px; height: 22px; border-radius: 50%; background: var(--green); color: #fff; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
.inc-card strong { font-size: 13px; font-weight: 600; color: var(--dark); display: block; margin-bottom: 3px; }
.inc-card span { font-size: 12px; color: #44546A; line-height: 1.5; }
.oos-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.oos-card { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--border); }
.oos-x { width: 20px; height: 20px; border-radius: 50%; background: #F3F4F6; color: var(--mid); font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
.oos-card strong { font-size: 13px; font-weight: 600; color: var(--dark); display: block; margin-bottom: 3px; }
.oos-card span { font-size: 12px; color: var(--mid); line-height: 1.5; }

/* ── ASSUMPTIONS TABLE ── */
.assumptions-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.assumptions-table th { text-align: left; padding: 8px 10px; background: var(--light); font-size: 10px; font-weight: 600; color: var(--mid); text-transform: uppercase; letter-spacing: 1px; border-bottom: 2px solid var(--border); }
.assumptions-table td { padding: 8px 10px; border-bottom: 1px solid var(--border); vertical-align: top; color: #44546A; }
.assumptions-table tr:last-child td { border-bottom: none; }
.p0-flag { display: inline-block; font-size: 9px; font-weight: 700; color: #fff; background: var(--brand); padding: 1px 5px; border-radius: 3px; margin-right: 5px; vertical-align: middle; }
.owner-badge { display: inline-block; font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 10px; }
.owner-ds     { background: #EFF6FF; color: #1E40AF; }
.owner-client { background: #F0FFF4; color: #065F46; }
.owner-both   { background: #FFFBEB; color: #92400E; }
.owner-vendor { background: #F3F4F6; color: var(--mid); }

/* ── TIMELINE ── */
.timeline { display: flex; flex-direction: column; gap: 0; }
.tl-item { display: flex; gap: 14px; padding-bottom: 18px; position: relative; }
.tl-item:not(:last-child)::before { content: ''; position: absolute; left: 13px; top: 28px; bottom: 0; width: 2px; background: var(--border); }
.tl-dot { width: 28px; height: 28px; border-radius: 50%; background: var(--brand); color: #fff; font-size: 10px; font-weight: 600; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }
.tl-dot.phase2 { background: var(--green); }
.tl-dot.phase3 { background: #1C2B3A; }
.tl-content { flex: 1; }
.tl-weeks { font-size: 11px; color: var(--mid); margin-bottom: 2px; }

/* ── JOURNEY / STAGES ── */
.stage-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin: 6px 0 12px; }
.stage-card { border-radius: 8px; padding: 10px 12px; }
.stage-card.stage1 { background: #FFF0F0; border-top: 4px solid var(--brand); }
.stage-card.stage2 { background: #F0FFF6; border-top: 4px solid var(--green); }
.stage-card.stage3 { background: #F2F4F8; border-top: 4px solid #1C2B3A; }
.stage-card .stage-label { font-size: 10px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 2px; }
.stage-card.stage1 .stage-label { color: var(--brand); }
.stage-card.stage2 .stage-label { color: var(--green); }
.stage-card.stage3 .stage-label { color: #1C2B3A; }
.stage-card .stage-year { font-size: 10px; color: var(--mid); margin-bottom: 3px; }
.stage-card h4 { font-size: 12px; font-weight: 600; color: var(--dark); margin-bottom: 4px; }
.stage-card ul { list-style: none; padding: 0; margin: 0; }
.stage-card ul li { font-size: 11px; color: #44546A; padding: 2px 0 2px 13px; position: relative; line-height: 1.4; }
.stage-card ul li::before { content: '→'; position: absolute; left: 0; font-size: 9px; top: 3px; }
.stage-card.stage1 ul li::before { color: var(--brand); }
.stage-card.stage2 ul li::before { color: var(--green); }
.stage-card.stage3 ul li::before { color: #1C2B3A; }

/* ── PORTFOLIO CONTEXT ── */
.portfolio-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin: 12px 0; }
.portfolio-card { border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; background: #fff; }
.portfolio-card-name { font-size: 13px; font-weight: 700; color: var(--dark); margin-bottom: 2px; }
.portfolio-card-region { font-size: 11px; color: var(--mid); margin-bottom: 6px; }
.portfolio-card-signal { font-size: 11px; color: var(--dark); line-height: 1.5; border-left: 3px solid var(--brand); padding-left: 8px; }
.portfolio-sponsor { background: #F2F4F8; border-radius: 8px; padding: 14px 18px; margin-bottom: 14px; display: flex; align-items: flex-start; gap: 14px; }
.portfolio-sponsor-label { font-size: 10px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--mid); margin-bottom: 3px; }
.portfolio-sponsor-name { font-size: 15px; font-weight: 700; color: var(--dark); margin-bottom: 4px; }
.portfolio-sponsor-detail { font-size: 12px; color: var(--mid); line-height: 1.55; }
.portfolio-template-angle { background: #FFF8F0; border-left: 4px solid #F59E0B; padding: 12px 16px; border-radius: 0 6px 6px 0; margin-bottom: 14px; font-size: 13px; color: var(--dark); line-height: 1.6; }
/* ── HOW WE SEE YOU ── */
.buyer-profile-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 12px; }
.buyer-profile-card { border: 1px solid var(--border); border-radius: 8px; padding: 16px 18px; background: #fff; }
.buyer-profile-label { font-size: 10px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--brand); margin-bottom: 6px; }
.buyer-profile-value { font-size: 15px; font-weight: 700; color: var(--dark); margin-bottom: 8px; text-transform: capitalize; }
.buyer-signal { font-size: 12px; color: #44546A; padding: 5px 0 5px 14px; position: relative; line-height: 1.5; border-bottom: 1px solid var(--border); }
.buyer-signal:last-child { border-bottom: none; }
.buyer-signal::before { content: '"'; position: absolute; left: 0; color: var(--brand); font-size: 14px; top: 3px; font-weight: 700; }
/* ── FOMO CARDS ── */
.fomo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 4px; }
.fomo-card { border: 1px solid var(--border); border-radius: 8px; padding: 16px 18px; background: #fff; }
.fomo-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
.fomo-co { font-size: 13px; font-weight: 600; color: var(--dark); }
.fomo-meta { font-size: 11px; color: var(--mid); margin-top: 2px; }
.fomo-tier-badge { display: inline-block; font-size: 9px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; padding: 2px 7px; border-radius: 10px; flex-shrink: 0; white-space: nowrap; }
.tier-exact    { background: #D1FAE5; color: #065F46; }
.tier-adjacent { background: #DBEAFE; color: #1E40AF; }
.tier-stat     { background: #F3F4F6; color: var(--mid); }
.fomo-built { font-size: 12px; color: #44546A; margin-bottom: 6px; line-height: 1.5; }
.fomo-savings-val { font-size: 16px; font-weight: 700; color: var(--green); margin-bottom: 6px; }
.fomo-analogy { font-size: 11px; color: var(--mid); font-style: italic; margin-bottom: 6px; line-height: 1.5; }
.fomo-angle { font-size: 12px; font-weight: 500; color: var(--dark); border-left: 3px solid var(--brand); padding-left: 8px; line-height: 1.55; }
.fomo-co-link { color: var(--brand); text-decoration: none; font-weight: 600; font-size: 13px; }
.fomo-co-link:hover { text-decoration: underline; }
.fomo-source { font-size: 11px; color: var(--mid); margin-top: 8px; font-style: italic; }
.fomo-source a { color: var(--brand); text-decoration: underline; }
.fomo-agent { font-size: 11px; color: #1D4ED8; background: #EFF6FF; border-radius: 4px; padding: 5px 8px; margin-bottom: 6px; line-height: 1.5; }
.fomo-agent::before { content: '\26A1 AI agent: '; font-weight: 600; }
/* ── AI THOUGHT STARTERS ── */
.ai-starters { padding: 16px 40px 22px; background: #F0F4FF; border-top: 2px solid var(--brand); }
.ai-starters-eyebrow { font-size: 10px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--brand); margin-bottom: 10px; }
.ai-starters-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
.ai-starters-list li { font-size: 13px; color: var(--dark); line-height: 1.55; padding-left: 18px; position: relative; }
.ai-starters-list li::before { content: '\2192'; position: absolute; left: 0; color: var(--brand); font-size: 12px; top: 1px; }

/* ── INVESTMENT / PRICING ── */
.model-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 24px; }
@media (max-width: 860px) { .model-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 560px) { .model-grid { grid-template-columns: 1fr; } }
.tm-rate-table { width: 100%; border-collapse: collapse; font-size: 11px; margin: 10px 0 14px; }
.tm-rate-table th { background: var(--blue-bg); font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #1e40af; padding: 4px 8px; border-bottom: 1px solid #BFDBFE; text-align: left; }
.tm-rate-table td { padding: 5px 8px; border-bottom: 1px solid var(--border); color: var(--dark); }
.tm-rate-table tr:last-child td { border-bottom: none; }
.model-card { border: 1px solid var(--border); border-radius: 10px; padding: 20px; position: relative; }
.model-card.recommended { border-color: var(--brand); border-width: 2px; }
.rec-badge { position: absolute; top: -11px; left: 20px; background: var(--brand); color: #fff; font-size: 10px; font-weight: 600; padding: 2px 10px; border-radius: 10px; text-transform: uppercase; letter-spacing: 1px; }
.model-name { font-size: 13px; font-weight: 600; color: var(--dark); margin-bottom: 8px; }
.model-impl { font-size: 26px; font-weight: 800; color: var(--brand); line-height: 1; }
.model-impl-label { font-size: 11px; color: var(--mid); margin-bottom: 12px; margin-top: 2px; }
.model-service { font-size: 20px; font-weight: 700; color: var(--dark); }
.model-service-label { font-size: 11px; color: var(--mid); margin-top: 2px; margin-bottom: 12px; }
.model-divider { border: none; border-top: 1px solid var(--border); margin: 12px 0; }
.best-for { font-size: 10px; font-weight: 600; color: var(--mid); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
.model-vp { font-size: 12px; color: #44546A; line-height: 1.5; margin-bottom: 14px; }
.model-retainer { font-size: 11px; color: var(--mid); margin-top: 2px; margin-bottom: 4px; }
.impl-pitch { background: var(--blue-bg); border: 1px solid var(--blue-br); border-radius: 8px; padding: 16px 18px; margin: 16px 0 4px; }
.impl-pitch-head { font-size: 12px; font-weight: 600; color: var(--dark); margin-bottom: 12px; }
.impl-pitch-row { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 9px; font-size: 12px; color: #44546A; line-height: 1.5; }
.impl-pitch-row:last-child { margin-bottom: 0; }
.impl-pitch-icon { color: var(--mid); flex-shrink: 0; font-size: 13px; margin-top: 1px; }
.impl-pitch-note { font-size: 11px; color: var(--mid); margin-top: 12px; border-top: 1px solid var(--border); padding-top: 10px; }
.model-instruction { font-size: 11px; color: var(--mid); font-style: italic; margin-bottom: 12px; }
.model-select-btn { width: 100%; }
.managed-intro { margin: 4px 0 10px; }
.managed-intro h3 { font-size: 15px; font-weight: 600; color: var(--dark); margin-bottom: 4px; }
.managed-intro p { font-size: 12px; color: var(--mid); }
.managed-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 16px; }
.managed-table th { text-align: left; padding: 8px 10px; background: var(--light); font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--mid); border-bottom: 2px solid var(--border); }
.managed-table td { padding: 8px 10px; border-bottom: 1px solid var(--border); }
.managed-table tr:last-child td { border-bottom: none; }
/* ── Negotiate modal (centered overlay) ── */
.neg-backdrop { display:none; position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:200; align-items:center; justify-content:center; padding:20px; }
.neg-backdrop.open { display:flex; }
.negotiate-panel { background:#fff; border-radius:12px; padding:28px 28px 24px; width:100%; max-width:560px; max-height:90vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,.25); position:relative; }
.neg-close { position:absolute; top:14px; right:16px; background:none; border:none; font-size:20px; color:var(--mid); cursor:pointer; line-height:1; padding:4px 8px; border-radius:4px; }
.neg-close:hover { background:var(--light); color:var(--dark); }
.negotiate-header { margin-bottom:18px; padding-bottom:14px; border-bottom:1px solid var(--border); }
.negotiate-label { font-size:10px; font-weight:600; color:var(--mid); text-transform:uppercase; letter-spacing:1px; margin-bottom:4px; }
.negotiate-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; }
.negotiate-field-label { display: block; font-size: 11px; font-weight: 600; color: var(--dark); margin-bottom: 4px; }
.negotiate-required { color: var(--brand); }
.negotiate-optional { font-weight: 400; color: var(--mid); }

/* ── ACCEPT PANEL ── */
.accept-panel { position: fixed; top: 45px; right: 40px; z-index: 99; background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 18px 20px; width: 320px; box-shadow: 0 4px 20px rgba(0,0,0,.12); display: none; }
.accept-panel-head { font-size: 14px; font-weight: 700; color: var(--dark); margin-bottom: 4px; }
.accept-panel-sub  { font-size: 12px; color: var(--mid); margin-bottom: 14px; line-height: 1.5; }

/* ── NEXT STEPS ── */
.next-steps { display: flex; gap: 0; }
.ns-item { flex: 1; text-align: center; padding: 0 10px; position: relative; }
.ns-item:not(:last-child)::after { content: '→'; position: absolute; right: -10px; top: 16px; font-size: 16px; color: var(--border); }
.ns-num { width: 36px; height: 36px; background: var(--brand); color: #fff; border-radius: 50%; font-size: 15px; font-weight: 700; display: flex; align-items: center; justify-content: center; margin: 0 auto 8px; }
.ns-item h4 { font-size: 12px; font-weight: 600; color: var(--dark); margin-bottom: 3px; }
.ns-item p  { font-size: 11px; color: var(--mid); margin: 0; }

/* ── NEGOTIATE INPUTS ── */
.cta-input { width: 100%; padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 13px; color: var(--dark); font-family: inherit; margin-bottom: 10px; box-sizing: border-box; }
.cta-input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(237,28,36,.12); }
textarea.cta-input { min-height: 80px; resize: vertical; }
.accept-success { display: none; background: #F0FFF4; border: 1px solid #68D391; border-left: 4px solid var(--green); border-radius: 6px; padding: 10px 14px; margin-top: 10px; font-size: 13px; font-weight: 600; color: #276749; }

/* ── ABOUT TAB ── */
.about-hero { display: grid; grid-template-columns: 1fr 1fr 1fr; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-bottom: 20px; }
.about-stat { padding: 18px 22px; border-right: 1px solid var(--border); }
.about-stat:last-child { border-right: none; }
.about-stat-num { font-size: 52px; font-weight: 800; color: var(--brand); line-height: 1; margin-bottom: 4px; }
.about-stat-label { font-size: 11px; color: var(--mid); text-transform: uppercase; letter-spacing: 1px; line-height: 1.4; }
.about-lead { font-size: 14px; color: var(--dark); line-height: 1.7; margin-bottom: 16px; }
.about-ai-callout { background: var(--light); border-left: 4px solid var(--brand); padding: 14px 18px; margin-bottom: 20px; border-radius: 0 6px 6px 0; }
.about-ai-label { font-size: 10px; font-weight: 600; color: var(--brand); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 6px; }
.about-ai-callout p { font-size: 13px; color: var(--dark); margin: 0; line-height: 1.65; }
.about-pillars { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 4px; }
.about-pillar { border-top: 3px solid var(--border); padding: 14px 0 0; }
.about-pillar-head { font-size: 13px; font-weight: 700; color: var(--dark); margin-bottom: 7px; }
.about-pillar p { font-size: 12px; color: #44546A; margin: 0; line-height: 1.55; }

/* ── CASE STUDY CARDS ── */
.cs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 4px; }
.cs-card { border: 1px solid var(--border); border-radius: 8px; padding: 16px 18px; }
.cs-co { font-size: 14px; font-weight: 700; color: var(--dark); margin-bottom: 2px; }
.cs-meta { font-size: 11px; color: var(--mid); margin-bottom: 10px; }
.cs-headline { font-size: 13px; font-weight: 600; color: var(--dark); margin-bottom: 6px; line-height: 1.4; }
.cs-built { font-size: 12px; color: #44546A; line-height: 1.5; margin-bottom: 6px; }
.cs-outcome { font-size: 12px; font-weight: 600; color: var(--green); margin-bottom: 8px; }
.cs-ai { font-size: 12px; color: #44546A; border-left: 3px solid var(--brand); padding-left: 8px; line-height: 1.5; }

/* ── IAAS AI CALLOUT ── */
.iaas-ai-callout { background: #F0FFF6; border: 1px solid var(--green); border-left: 4px solid var(--green); border-radius: 8px; padding: 12px 14px; margin: 10px 0 14px; }
.iaas-ai-callout-head { font-size: 10px; font-weight: 600; color: var(--green); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
.iaas-ai-callout p { font-size: 12px; color: #44546A; margin: 0; line-height: 1.55; }

/* ── FOOTER ── */
.footer { border-top: 1px solid var(--border); padding: 16px 40px; font-size: 12px; color: var(--mid); display: flex; justify-content: space-between; align-items: center; }
.footer strong { color: var(--dark); }
.footer a { color: var(--mid); text-decoration: none; }

/* ── BUTTONS ── */
.btn         { padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; border: none; }
.btn-primary { background: var(--brand); color: #fff; }
.btn-outline { background: #fff; color: var(--dark); border: 2px solid var(--border); }
.btn-submit  { font-size: 14px; padding: 10px 28px; }

/* ── PRINT ── */
@media print {
  body { max-width: 100%; padding: 0; font-size: 11px; }
  .no-print, .sticky-bar, .tab-nav { display: none !important; }
  .tab-panel { display: block !important; }
  .header { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  details.section-block { page-break-inside: avoid; }
  details.section-block > .section-body { display: block !important; }
  .section-chevron { display: none; }
  .complexity-badge, .fomo-tier-badge, .stage-card, .model-card, .rec-badge { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
}
</style>
{% endblock %}

{% block body %}
{% set meta      = proposal.meta or {} %}
{% set sol       = proposal.solution or {} %}
{% set bp        = proposal.buyerProfile or {} %}
{% set flowCount = meta.flowCount or 0 %}
{% set fomo      = proposal.fomo or [] %}
{% set starters  = proposal.fomoThoughtStarters or [] %}
{% set nextSteps = proposal.nextSteps or [] %}

{# ── HEADER ── #}
<div class="header">
  <div class="header-top">
    <div class="logo-group">
      <span style="--logo-h: 32px;">{{ branding.logo | safe }}</span>
      {% if client.logoPath %}
      <div class="client-logo-block"><div class="client-logo-sep"></div><img src="{{ client.logoPath | esc }}" alt="{{ meta.clientName | esc }}" class="client-logo-img" onerror="this.parentNode.style.display='none'"></div>
      {% endif %}
    </div>
    <span class="eyebrow">Integration Roadmap — Confidential</span>
  </div>
  <div class="header-title-block">
    <h1>{{ (meta.title or ('MuleSoft Integration for ' + (meta.clientName or ''))) | esc }}</h1>
    <div class="subtitle">{{ (meta.subtitle or '') | esc }}</div>
  </div>
  <div class="header-meta">
    <span><strong>Prepared for</strong>{{ meta.clientName | esc }}</span>
    <span><strong>Architect</strong>{{ meta.architect | esc }} · DataSkate</span>
    <span><strong>Date</strong>{{ (meta.date or '') | esc }}</span>
    <span><strong>Scope</strong>{{ flowCount }} integration flow{{ 's' if flowCount != 1 else '' }}</span>
  </div>
</div>

{# ── STICKY BAR ── #}
<div class="sticky-bar no-print">
  <button class="btn btn-outline" onclick="toggleAllSections(this)">Expand All</button>
  <button class="btn btn-outline" onclick="window.print()">Print / PDF</button>
  <button class="btn btn-primary" onclick="goToInvestment()">Let's Talk →</button>
  <button class="btn btn-primary" id="accept-btn" onclick="showAcceptPanel()" style="background:var(--green)">Accept Proposal ✓</button>
</div>

{# ── ACCEPT PROPOSAL PANEL ── #}
<div class="accept-panel no-print" id="accept-panel">
  <div class="accept-panel-head">Accept this Proposal</div>
  <div class="accept-panel-sub">Your name and email confirm acceptance. We'll follow up with an SOW for signature.</div>
  <input id="accept-name"  class="cta-input" type="text"  placeholder="Your full name *" style="margin-bottom:8px" />
  <input id="accept-email" class="cta-input" type="email" placeholder="Your email *" style="margin-bottom:12px" />
  <button class="btn btn-primary" style="width:100%" onclick="submitAcceptance()">Confirm Acceptance →</button>
  <div class="accept-success" id="accept-success">
    ✓ Acceptance recorded. Your DataSkate architect will be in touch shortly with the SOW.
  </div>
</div>

{# ── TAB NAV ── #}
<div class="tab-nav no-print">
  <button class="tab-btn active" data-tab="proposal" onclick="showTab('proposal',this)">Proposal</button>
  <button class="tab-btn" data-tab="solution" onclick="showTab('solution',this)">Solution</button>
  <button class="tab-btn" data-tab="ai" onclick="showTab('ai',this)">AI Vision</button>
  <button class="tab-btn" data-tab="about" onclick="showTab('about',this)">About Us</button>
</div>

{# ═══════ TAB 1: PROPOSAL ═══════ #}
<div id="tab-proposal" class="tab-panel">

{# THE CHALLENGE #}
<details class="section-block" open>
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">The Challenge</div>
      <div class="section-title">Why this matters now</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    {% if proposal.challenge and proposal.challenge.lead %}
    <p class="pull-quote">{{ proposal.challenge.lead | esc }}</p>
    {% endif %}
    {% if proposal.challenge and proposal.challenge.cards and proposal.challenge.cards | length > 0 %}
    <div class="challenge-grid">
      {% for card in proposal.challenge.cards %}
      <div class="challenge-card">
        <div class="card-label">{{ card.label | esc }}</div>
        <p>{{ card.text | esc }}</p>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</details>

{# ROI / BUSINESS CASE — conditional #}
{% if proposal.roi %}
<details class="section-block"{% if bp.primary == 'roi-analytical' %} open{% endif %}>
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">ROI / Business Case</div>
      <div class="section-title">{{ (proposal.roi.headline or 'The business case') | esc }}</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    <p>{{ proposal.roi.body | safe }}</p>
    {% if proposal.roi.stats and proposal.roi.stats | length > 0 %}
    <div style="display:flex;gap:24px;margin-top:12px;padding-top:12px;border-top:1px solid var(--border);flex-wrap:wrap;">
      {% for s in proposal.roi.stats %}
      <div style="flex:1;min-width:120px;">
        <span style="font-size:22px;font-weight:800;color:var(--brand);line-height:1;">{{ s.value | esc }}</span>
        <div style="font-size:11px;color:var(--mid);margin-top:3px;line-height:1.4;">{{ s.label | esc }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</details>
{% endif %}

{# WHAT'S INCLUDED #}
<details class="section-block">
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">What's Included</div>
      <div class="section-title">Everything covered in this engagement</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    <div class="included-grid">
      {% for item in (proposal.included or []) %}
      <div class="inc-card">
        <div class="inc-check">&#10003;</div>
        <div><strong>{{ item.title | esc }}</strong><span>{{ (item.detail or '') | esc }}</span></div>
      </div>
      {% endfor %}
    </div>
  </div>
</details>

{# WHAT YOU GET #}
<details class="section-block">
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">What You Get</div>
      <div class="section-title">Expected outcomes from this engagement</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    <div class="outcomes-grid">
      {% for o in (proposal.outcomes or []) %}
      <div class="outcome-card">
        <div class="outcome-icon">{{ o.icon | safe }}</div>
        <div class="outcome-card-text"><h4>{{ o.title | esc }}</h4><p>{{ o.body | safe }}</p></div>
      </div>
      {% endfor %}
    </div>
  </div>
</details>

{# INVESTMENT — conditional #}
{% if proposalPricing %}
<details class="section-block" id="investment-details">
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">Investment</div>
      <div class="section-title">Pricing &amp; engagement model</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    {% include "components/proposal-investment.njk" %}
  </div>
</details>
{% endif %}

{# WHAT'S NOT INCLUDED #}
<details class="section-block">
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">What's Not Included</div>
      <div class="section-title">Out of scope for this engagement</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    <div class="oos-grid">
      {% for item in (proposal.oos or []) %}
      <div class="oos-card">
        <div class="oos-x">&#215;</div>
        <div><strong>{{ item.title | esc }}</strong><span>{{ (item.detail or '') | esc }}</span></div>
      </div>
      {% endfor %}
    </div>
  </div>
</details>

{# HOW WE SEE YOU — conditional on buyerProfile existing #}
{% if bp and bp.primary %}
<details class="section-block">
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">How We Read This Engagement</div>
      <div class="section-title">What we noticed about how you evaluate decisions</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    <div class="buyer-profile-grid">
      <div class="buyer-profile-card">
        <div class="buyer-profile-label">Your decision style</div>
        <div class="buyer-profile-value">{{ bp.primary | replace('-', ' ') | esc }}</div>
        <p style="font-size:12px;color:var(--mid);margin:0;line-height:1.6;">This proposal was shaped around what matters most to you — concrete outcomes, specific timelines, and what stops on go-live day. Abstract capability claims were left out.</p>
      </div>
      {% if bp.signals and bp.signals | length > 0 %}
      <div class="buyer-profile-card">
        <div class="buyer-profile-label">Signals that shaped this proposal</div>
        {% for sig in bp.signals %}
        <div class="buyer-signal">{{ sig | esc }}</div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
</details>
{% endif %}

{# HOW TO MOVE FORWARD #}
<details class="section-block" open>
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">How to Move Forward</div>
      <div class="section-title">Next steps to get started</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    <div class="next-steps">
      {% for ns in nextSteps %}
      <div class="ns-item">
        <div class="ns-num">{{ loop.index }}</div>
        <h4>{{ ns.title | esc }}</h4>
        <p>{{ ns.body | safe }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</details>

</div>{# /tab-proposal #}

{# ═══════ TAB 2: SOLUTION ═══════ #}
<div id="tab-solution" class="tab-panel" style="display:none">

{# THE SOLUTION #}
<details class="section-block" open>
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">The Solution</div>
      <div class="section-title">How MuleSoft connects your systems</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    {% if sol.lead %}<p class="lead">{{ sol.lead | esc }}</p>{% endif %}
    {% if proposalDiagram %}<div class="diagram-wrap">{{ proposalDiagram | safe }}</div>{% endif %}
    {% if sol.diagramCaption %}<p class="diagram-caption">{{ sol.diagramCaption | esc }}</p>{% endif %}
  </div>
</details>

{# PROPOSED INTEGRATIONS #}
<details class="section-block" open>
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">Proposed Integrations</div>
      <div class="section-title">{{ flowCount }} Proposed Integration Flow{{ 's' if flowCount != 1 else '' }}</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    <div class="flow-grid">
      {% for flow in (proposal.flows or []) %}
      {% include "components/proposal-flow-card.njk" %}
      {% endfor %}
    </div>
  </div>
</details>

{# KEY ASSUMPTIONS & DEPENDENCIES #}
<details class="section-block">
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">Key Assumptions &amp; Dependencies</div>
      <div class="section-title">Prerequisites and shared responsibilities</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    <table class="assumptions-table">
      <thead>
        <tr><th>Assumption</th><th>Owner</th><th>When</th></tr>
      </thead>
      <tbody>
        {% for a in (proposal.assumptions or []) %}
        {% set ownerCls = 'owner-ds' %}
        {% if a.owner == 'Client' %}{% set ownerCls = 'owner-client' %}
        {% elif a.owner == 'Both'   %}{% set ownerCls = 'owner-both'   %}
        {% elif a.owner == 'Vendor' %}{% set ownerCls = 'owner-vendor' %}
        {% endif %}
        <tr>
          <td>{% if a.p0 %}<span class="p0-flag">P0</span>{% endif %}{{ a.assumption | esc }}</td>
          <td><span class="owner-badge {{ ownerCls }}">{{ a.owner | esc }}</span></td>
          <td>{{ (a.when or '') | esc }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</details>

{# DELIVERY TIMELINE — conditional #}
{% if proposal.timeline and proposal.timeline | length > 0 %}
<details class="section-block">
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">Delivery Timeline</div>
      <div class="section-title">Indicative project schedule</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    <div class="timeline">
      {% for ph in proposal.timeline %}
      {% set dotCls = '' %}
      {% if loop.index == 2 %}{% set dotCls = ' phase2' %}
      {% elif loop.index > 2 %}{% set dotCls = ' phase3' %}
      {% endif %}
      <div class="tl-item">
        <div class="tl-dot{{ dotCls }}">{{ loop.index }}</div>
        <div class="tl-content">
          <div class="tl-weeks">{{ (ph.weeks or '') | esc }}</div>
          <h4>{{ ph.label | esc }}</h4>
          {% if ph.tasks and ph.tasks | length > 0 %}
          <ul style="margin:4px 0 0;padding-left:16px;">
            {% for t in ph.tasks %}<li style="font-size:12px;color:#44546A;line-height:1.5;">{{ t | esc }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</details>
{% endif %}

{# PORTFOLIO CONTEXT — conditional on portfolioContext existing #}
{% set pc = proposal.portfolioContext %}
{% if pc and pc.platformName %}
<details class="section-block">
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">Platform Opportunity</div>
      <div class="section-title">This engagement is bigger than one brand</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    {% if pc.sponsorName %}
    <div class="portfolio-sponsor">
      <div>
        <div class="portfolio-sponsor-label">Financial Sponsor</div>
        <div class="portfolio-sponsor-name">{{ pc.sponsorName | esc }}</div>
        <div class="portfolio-sponsor-detail">{{ pc.executiveAngle | esc }}</div>
      </div>
    </div>
    {% endif %}
    {% if pc.templateAngle %}
    <div class="portfolio-template-angle">{{ pc.templateAngle | esc }}</div>
    {% endif %}
    {% if pc.siblings and pc.siblings | length > 0 %}
    <p style="font-size:12px;color:var(--mid);margin-bottom:8px;">{{ pc.siblingCount }} sibling brands under {{ pc.platformName | esc }} — each a future engagement once the Peerless template is proven:</p>
    <div class="portfolio-grid">
      {% for sib in pc.siblings %}
      <div class="portfolio-card">
        <div class="portfolio-card-name">{{ sib.name | esc }}</div>
        {% if sib.region %}<div class="portfolio-card-region">{{ sib.region | esc }}</div>{% endif %}
        <div class="portfolio-card-signal">{{ (sib.integrationSignal or 'Integration signals TBD') | esc }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</details>
{% endif %}

</div>{# /tab-solution #}

{# ═══════ TAB 3: AI VISION ═══════ #}
<div id="tab-ai" class="tab-panel" style="display:none">

{# YOUR AI JOURNEY #}
<details class="section-block" open>
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">Your AI Journey</div>
      <div class="section-title">{{ (proposal.journey.headline or 'From Connected to AI-Enabled') | esc }}</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    <div class="stage-grid">
      {% for stageKey in ['stage1', 'stage2', 'stage3'] %}
      {% set stage = proposal.journey[stageKey] %}
      {% set stageNum = loop.index %}
      {% include "components/proposal-stage-card.njk" %}
      {% endfor %}
    </div>
    {% if proposal.journey.closingLine %}
    <p class="pull-quote">{{ proposal.journey.closingLine | esc }}</p>
    {% endif %}
  </div>
</details>

{# PEER COMPARISON — conditional #}
{% if fomo and fomo | length > 0 %}
<details class="section-block" open>
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">Peer Comparison</div>
      <div class="section-title">Companies like yours are already doing this</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    <div class="fomo-grid">
      {% for fomoItem in fomo %}
      {% include "components/proposal-fomo-card.njk" %}
      {% endfor %}
    </div>
  </div>
</details>
{% endif %}

{# AI THOUGHT STARTERS — conditional, standalone block #}
{% if starters and starters | length > 0 %}
<div class="ai-starters">
  <div class="ai-starters-eyebrow">What else teams like yours are exploring</div>
  <ul class="ai-starters-list">
    {% for s in starters %}<li>{{ s | esc }}</li>{% endfor %}
  </ul>
</div>
{% endif %}

</div>{# /tab-ai #}

{# ═══════ TAB 4: ABOUT US ═══════ #}
<div id="tab-about" class="tab-panel" style="display:none">

<details class="section-block" open>
  <summary class="section-head">
    <div class="section-summary">
      <div class="section-eyebrow">About DataSkate</div>
      <div class="section-title">Who we are and how we work</div>
    </div>
    <span class="section-chevron">&#9660;</span>
  </summary>
  <div class="section-body">
    {% set about = proposalAbout %}
    {% if about %}
      {% if about.stats %}
      <div class="about-hero">
        {% for s in about.stats %}
        <div class="about-stat">
          <div class="about-stat-num">{{ s.num | esc }}</div>
          <div class="about-stat-label">{{ s.label | esc }}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if about.lead %}<p class="about-lead">{{ about.lead | esc }}</p>{% endif %}
      {% if about.aiCallout %}
      <div class="about-ai-callout">
        <div class="about-ai-label">{{ about.aiCallout.label | esc }}</div>
        <p>{{ about.aiCallout.body | esc }}</p>
      </div>
      {% endif %}
