rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isArchitect() {
      return request.auth != null &&
             request.auth.token.email.matches('.*@dataskate\\.ai');
    }

    // Architects can read and write all project records
    match /projects/{clientId} {
      allow read, write: if isArchitect();
    }

    // Clients write intake responses without auth (public URL, no login)
    // Architects can read all responses
    match /intake_responses/{clientId} {
      allow create, update: if true;
      allow read: if isArchitect();
    }

    // Krisp meeting data — written only by the Cloud Function (server-side admin SDK)
    // Architects can read; no direct client writes
    match /krisp_meetings/{meetingId} {
      allow read: if isArchitect();
      allow write: if false;
    }

    // Proposal acceptance — written and read by client browser (no auth; public URL)
    // Client needs read access to restore accepted state on page reload (localStorage fallback).
    match /proposals/{clientId} {
      allow create, update: if true;
      allow read: if true;
    }

    // Proposal view tracking — written by client browser on page load (no auth)
    // Architects can read; field-level increment is append-safe
    match /proposalViews/{clientId} {
      allow create, update: if true;
      allow read: if isArchitect();
    }

    // Negotiation thread — read/write by client browser; DataSkate responds via Firebase Console
    // Client counter-offers append to thread[]; DataSkate entries added server-side
    match /negotiations/{clientId} {
      allow create, update: if true;
      allow read: if true;
    }

    // Counter-offer discount audit log — written by client browser; read only by architects
    match /discountLog/{clientId} {
      allow create, update: if true;
      allow read: if isArchitect();
    }

    // SOW electronic signatures — written and read by client browser (no auth; public URL)
    // Client needs read access to restore their signature on page reload.
    // Signature data (name, title, email, PNG) is non-sensitive confirmation data.
    match /sow_signatures/{clientId} {
      allow create, update: if true;
      allow read: if true;
    }

    // Architect pitch kits — written by build pipeline (REST API, bypasses rules)
    // Only architects can read; never writable from the browser
    match /pitchKits/{clientSlug} {
      allow read: if isArchitect();
      allow write: if false;
    }
  }
}
