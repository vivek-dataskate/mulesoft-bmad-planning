<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:os="http://www.mulesoft.org/schema/mule/os" 
      xmlns:dynamics365ForOperations="http://www.mulesoft.org/schema/mule/dynamics365ForOperations"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:shopify="http://www.mulesoft.org/schema/mule/shopify"
      xmlns:oauth="http://www.mulesoft.org/schema/mule/oauth" 
      xmlns="http://www.mulesoft.org/schema/mule/core" 
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" 
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/shopify http://www.mulesoft.org/schema/mule/shopify/current/mule-shopify.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/oauth http://www.mulesoft.org/schema/mule/oauth/current/mule-oauth.xsd
        http://www.mulesoft.org/schema/mule/dynamics365ForOperations http://www.mulesoft.org/schema/mule/dynamics365ForOperations/current/mule-dynamics365ForOperations.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <shopify:config name="Shopify_Connector_Config" doc:name="Shopify Connector Config" doc:id="56d97cd5-65bf-4851-87ee-583c7e329388" >
        <shopify:oauth2-connection baseUri="https://zyrisdev.myshopify.com">
            <reconnection>
    <reconnect count="5" frequency="10000" />
</reconnection>
			<shopify:oauth-authorization-code consumerKey="${shopify.consumer.id}" consumerSecret="${shopify.consumer.secret}" authorizationUrl="https://zyrisdev.myshopify.com/admin/oauth/authorize" accessTokenUrl="https://zyrisdev.myshopify.com/admin/oauth/access_token" />
<shopify:oauth-callback-config listenerConfig="HTTP_Listener_config" callbackPath="/callback" authorizePath="/authorize" externalCallbackUrl="${shopify.callback.url}"/>
			<shopify:oauth-store-config objectStore="Object_store_Shopify" />
        
</shopify:oauth2-connection>
    </shopify:config>

    <dynamics365ForOperations:dynamics-365-for-operations-config name="Dynamics_365_For_Operations_Config" doc:name="Dynamics 365 For Operations Config">
        <dynamics365ForOperations:oauth-client-credentials-connection resource="https://zyris-zydev91ed270f8a3f5c58aos.axcloud.dynamics.com" >
            <reconnection >
                <reconnect count="3" />
            </reconnection>
            <dynamics365ForOperations:oauth-client-credentials clientId="${d365.client.id}" clientSecret="${d365.client.secret}" tokenUrl="https://login.microsoftonline.com/${d365.tenant.id}/oauth2/v2.0/token" scopes="https://zyris-zydev91ed270f8a3f5c58aos.axcloud.dynamics.com/.default"/>
        </dynamics365ForOperations:oauth-client-credentials-connection>
    </dynamics365ForOperations:dynamics-365-for-operations-config>

    <http:request-config name="HubSpot_HTTP_Request_Config" doc:name="HubSpot HTTP Request Config" doc:id="cd509256-b4fa-47df-8743-92b9214d73a2">
        <http:request-connection protocol="HTTPS" host="api.hubapi.com" port="443"/>
    </http:request-config>

    <!--  <http:request-config name="Shopify_Admin_HTTP_Request_Config" doc:name="Shopify Admin HTTP Request Config" doc:id="3e644acd-05d2-4b24-a320-788459c376a3">
        <http:request-connection protocol="HTTPS" host="${shopify.shop.domain}" port="443"/>
        <http:default-headers>
            <http:default-header key="Content-Type" value="application/json"/>
            <http:default-header key="X-Shopify-Access-Token" value="${shopify.admin.access.token}"/>
        </http:default-headers>
    </http:request-config> -->

    <http:request-config name="HTTP_Request_D365_OData" 
    doc:name="HTTP Request configuration" 
    doc:id="77fdca74-cdbb-4be8-a389-b7848514cfba"
    basePath="/data">
    <http:request-connection 
        protocol="HTTPS" 
        host="${d365.host}" 
        port="443"/>
</http:request-config>
    <configuration-properties doc:name="Configuration properties" doc:id="d087b4f4-c277-48b2-8bb1-3a2a0c240910" file="configurations\application.properties" />
	<os:object-store name="D365_Token_Store"
    persistent="true"
    maxEntries="1"
    entryTtl="55"
    entryTtlUnit="MINUTES" />
	<http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config" doc:id="24f71d7b-b64b-46f5-acbc-21c708bec305" >
		<http:listener-connection host="0.0.0.0" port="8081" />
	</http:listener-config>
	<os:config name="ObjectStore_Config" doc:name="ObjectStore Config" doc:id="cb157d6e-efce-44ad-8fb7-bc43d89fa0f3" >
		<os:connection >
			<reconnection />
		</os:connection>
	</os:config>
	<os:object-store name="Object_store_Shopify"
    persistent="true"
    maxEntries="10"
    entryTtl="24"
    entryTtlUnit="HOURS" />
    <os:object-store name="Shopify_Polling_Store"
    persistent="true"
    maxEntries="500"
    entryTtl="24"
    entryTtlUnit="HOURS" />

</mule>