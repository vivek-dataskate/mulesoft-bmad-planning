{
  "project": {
    "name": "leolabs-integration",
    "client": "leolabs",
    "description": "LeoLabs Salesforce ↔ NetSuite integration with event-driven sync",
    "generatedAt": "2026-05-10",
    "bmadVersion": "6.6.0"
  },
  "integration": {
    "integrationStyle": "messaging",
    "primaryPattern": "event-driven",
    "secondaryPatterns": ["scheduled-sync"],
    "direction": "bidirectional",
    "flows": [
      {
        "name": "sync-opportunity-to-netsuite-flow",
        "layer": "process",
        "source": "salesforce",
        "target": "netsuite",
        "trigger": "mq-subscriber",
        "description": "Sync Salesforce opportunity closed-won to NetSuite sales order"
      },
      {
        "name": "poll-netsuite-invoices-flow",
        "layer": "process",
        "source": "netsuite",
        "target": "salesforce",
        "trigger": "scheduler",
        "description": "Poll NetSuite invoices and sync status back to Salesforce"
      },
      {
        "name": "get-integration-status-flow",
        "layer": "experience",
        "source": "client",
        "target": "integration",
        "trigger": "http",
        "description": "Return current integration health and sync status"
      }
    ]
  },
  "nfr": {
    "volume": "medium",
    "latency": "async-ok",
    "frequency": "real-time",
    "availability": "99.9",
    "throughput": "medium"
  },
  "systems": {
    "connectors": ["salesforce", "netsuite", "anypoint-mq", "http"],
    "customSystems": {},
    "database": null,
    "nosql": null
  },
  "security": {
    "level": "internal",
    "apiAuth": "client-id",
    "gatewayPolicies": ["client-id-enforcement", "rate-limiting"],
    "secretsManager": false,
    "fieldEncryption": false,
    "dataMasking": true,
    "mtls": false
  },
  "errorHandling": {
    "strategy": "retry-then-dlq",
    "compensationStrategy": "retry",
    "maxRetries": 3,
    "backoff": "exponential",
    "dlq": true,
    "dlqName": "leolabs-integration-dlq",
    "retryQueueName": "leolabs-integration-retry-queue",
    "invalidMessageChannel": true,
    "invalidMessageChannelName": "leolabs-invalid-messages-queue",
    "errorEnvelope": true
  },
  "flowControl": {
    "direction": "push",
    "messageTtlHours": 24,
    "maxConcurrency": 4,
    "queueDepthAlertPct": 80,
    "backpressureEnabled": true,
    "deduplicationEnabled": true,
    "deduplicationTtlMinutes": 1440
  },
  "observability": {
    "anypointMonitoring": true,
    "customDashboard": false,
    "businessEvents": false,
    "externalPlatform": null,
    "logLevel": {
      "local": "DEBUG",
      "dev": "DEBUG",
      "uat": "INFO",
      "prod": "WARN"
    },
    "alerts": []
  },
  "notifications": {
    "email": true,
    "sms": false,
    "slack": true,
    "teams": false,
    "slackWebhook": null,
    "emailRecipients": ["ops@leolabs.io"]
  },
  "wireTap": {
    "enabled": false,
    "retentionHours": 72,
    "queueName": "leolabs-audit-queue"
  },
  "scheduling": {
    "required": true,
    "type": "cron",
    "expression": "0 0 2 * * ?",
    "watermarking": true,
    "objectStore": "persistent"
  },
  "aiIntegration": {
    "enabled": false,
    "provider": null,
    "model": "",
    "useCase": null,
    "timeoutSeconds": 30,
    "fallbackOnTimeout": true,
    "storeEmbeddingsIn": "none"
  },
  "clientFacing": {
    "operationsDashboard": false,
    "businessReporting": false,
    "auditTrail": false,
    "selfServicePortal": false,
    "uxFrontend": false
  },
  "devops": {
    "cicd": "github-actions",
    "environments": ["dev", "uat", "prod"],
    "munitRequired": true,
    "munitCoverage": 75,
    "exchangePublish": false,
    "deployment": "cloudhub2",
    "region": "us-east-1"
  },
  "scaffold": {
    "runtime": "4.8.0",
    "java": "17",
    "groupId": "com.leolabs",
    "apiLedLayers": ["process", "experience"],
    "generateMunit": true,
    "generateCicd": true,
    "generateNotifications": true,
