	<configuration-properties doc:name="Configuration properties" doc:id="e4f53959-2554-4b31-a3c8-a312954f12d9" file="config\mule-${mule.env}.yaml" doc:description="Configuration Properties File for Zyris"/>
	<global-property doc:name="Global Property" doc:id="e94641da-2c9d-4e5a-8c60-2ae32d674987" name="mule.env" value="local" doc:description="Global Env Property"/>
