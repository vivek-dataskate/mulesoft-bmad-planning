	<http:request-config name="HubSpot_HTTP_Request_Config" doc:name="HTTP Request configuration" doc:description="HubSpot HTTP Request">
		<http:request-connection protocol="HTTPS" host="${hubspot.host}" />
	</http:request-config>
	<os:object-store name="Watermark_Object_Store" doc:name="Object store" doc:id="8f3c4c42-a03f-4d24-ac47-56db00a7f1a8" maxEntries="1000" config-ref="Watermark_Object_Store_Config" doc:description="Zyris_UC3_Watermark_Object_Store"/>
	<os:config name="Watermark_Object_Store_Config" doc:name="ObjectStore Config" doc:id="40e0c58b-ae95-43c2-9731-d33c08a548d6" doc:description="Zyris_UC3_Watermark_Object_Store_Config">
		<os:connection />
	</os:config>
	<http:request-config name="D365FO_HTTP_Request_config" doc:name="HTTP Request config" doc:id="eb759d8d-6ee0-47e2-b700-81c49c99f45a" doc:description="Zyris D365FO HTTP Request">
		<http:request-connection protocol="HTTPS" host="${d365.resource}" port="443"/>
	</http:request-config>
	<error-handler name="global-Error_Handler" doc:id="e608d392-97e9-42dd-b7cb-4bf75425583a" >
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="defb78e3-99fc-44cc-b1c9-50e7955c4432" type="ANY">
			<ee:transform doc:name="Error Log" doc:id="e6ab7b36-9f0f-43ef-864b-435c1da54a32" >
				<ee:message >
					<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"Error Message": error.errorMessage,
	"Error Description": error.detailedDescription
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>
			<logger level="INFO" doc:name="Print Error" doc:id="db5891e6-0267-4f67-ad99-07be825e85fc" message="#[payload]"/>
		</on-error-propagate>
	</error-handler>
