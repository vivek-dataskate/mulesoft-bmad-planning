<!--
    Connector: HTTP Listener Config
    Registry key: http
    Connector: mule-http-connector 1.9.0
    Namespace: xmlns:http="http://www.mulesoft.org/schema/mule/http"
    Schema:    http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd

    Purpose: Base HTTP listener for all API-triggered flows.
    One listener-config shared by all http:listener elements in the application.
    Auth policies (client-id-enforcement, oauth2) applied via Flex Gateway — not in this config.

    Properties required in {env}.yaml:
      http.host  → "0.0.0.0"     (always bind all interfaces)
      http.port  → "8081"        (default; CloudHub 2.0 uses 8081)
-->

    <!-- HTTP Listener Config — shared by all API-triggered flows -->
    <http:listener-config
        name="HTTP_Listener_Config"
        doc:name="HTTP Listener Config">
        <http:listener-connection
            host="${http.host}"
            port="${http.port}"/>
    </http:listener-config>

    <!-- HTTP Requester — outbound calls to downstream REST APIs -->
    <!-- Add one <http:request-config> per external system you call -->
    <!-- Example:
    <http:request-config
        name="HTTP_Request_Config"
        doc:name="HTTP Requester Config"
        basePath="${http.target.basePath}">
        <http:request-connection
            host="${http.target.host}"
            port="${http.target.port}"
            protocol="${http.target.protocol}"/>
    </http:request-config>
    -->
