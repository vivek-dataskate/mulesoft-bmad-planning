<?xml version="1.0" encoding="UTF-8"?>
<!--
    global-config.xml — Generated by scaffold generator. Do not add flow logic here.
    Contains: properties, HTTP listener, all connector configurations.
    Rules:
      - Every connector <config> element lives HERE, never in flow files.
      - Property references use ${property.name} — never hardcode values.
      - Secrets Manager properties provider: mandatory for security=regulated|government (auto-injected);
        recommended for internal|partner (generated as commented-out block, opt in via decisions.json security.secretsManager=true).
-->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:configuration-properties="http://www.mulesoft.org/schema/mule/configuration-properties"
      {{ADDITIONAL_NAMESPACES}}
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
          http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
          http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/os
          http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/configuration-properties
          http://www.mulesoft.org/schema/mule/configuration-properties/current/mule-configuration-properties.xsd
        {{ADDITIONAL_SCHEMA_LOCATIONS}}">

    <!--
        Environment property files.
        Runtime resolves ${mule.env} from -Dmule.env system property.
        CloudHub 2.0: set mule.env in Application Properties in Runtime Manager.
        local.yaml: developer workstation overrides (ignored if absent).
    -->
    <configuration-properties
        file="properties/${mule.env}.yaml"
        doc:name="Environment Properties"/>
    <configuration-properties
        file="properties/local.yaml"
        doc:name="Local Overrides"
        ignore-error-if-missing="true"/>

    {{#if SECRETS_MANAGER_ENABLED}}
    <!-- ═══════════════════════════════════════════════════════════════
         SECRETS MANAGER PROPERTIES PROVIDER
         Generated when: decisions.json security.secretsManager = true
                         (profiles: regulated, government)

         Option A: AWS Secrets Manager
           Connector: mule-amazon-secrets-manager-properties-provider
           pom.xml:   <artifactId>mule-amazon-secrets-manager-properties-provider</artifactId>
                      <groupId>com.mulesoft.connectors</groupId>
                      Add xmlns:aws-secrets-provider to mule root element.

         Option B: Azure Key Vault
           Connector: mule-azure-key-vault-properties-provider
           pom.xml:   <artifactId>mule-azure-key-vault-properties-provider</artifactId>
                      <groupId>com.mulesoft.connectors</groupId>
                      Add xmlns:azure-key-vault-provider to mule root element.

         After adding, reference secrets as: ${secrets::my-secret-name}
         NEVER put actual secret values in property files.
         ═══════════════════════════════════════════════════════════════ -->

    <!-- TODO: Uncomment one block below based on your cloud provider -->

    <!--
    OPTION A — AWS Secrets Manager:

    <aws-secrets-manager-properties-provider:config
        name="AWS_Secrets_Manager_Config"
        doc:name="AWS Secrets Manager">
        <aws-secrets-manager-properties-provider:basic-connection
            region="${aws.secrets.region}"
            accessKey="${aws.secrets.accessKey}"
            secretKey="${aws.secrets.secretKey}"/>
    </aws-secrets-manager-properties-provider:config>
    -->

    <!--
    OPTION B — Azure Key Vault:

    <azure-key-vault-provider:config
        name="Azure_Key_Vault_Config"
        doc:name="Azure Key Vault">
        <azure-key-vault-provider:connection
            vaultName="${azure.keyvault.name}"
            clientId="${azure.keyvault.clientId}"
            tenantId="${azure.keyvault.tenantId}"
            clientSecret="${azure.keyvault.clientSecret}"/>
    </azure-key-vault-provider:config>
    -->
    {{/if}}

    <!-- Persistent Object Store — shared by idempotency checks and watermarks -->
    <os:object-store
        name="Persistent_Object_Store"
        persistent="true"
        doc:name="Persistent Object Store"/>

    <!-- HTTP Listener: single config shared by all HTTP-triggered flows in this app -->
    <http:listener-config name="HTTP_Listener_Config" doc:name="HTTP Listener Config">
        <http:listener-connection host="${http.host}" port="${http.port}"/>
    </http:listener-config>

    <!-- ═══════════════════════════════════════════════════════════════
         CONNECTOR CONFIGURATIONS
         Generated from decisions.json systems.connectors[]
         Each block sourced from templates/connectors/{key}-config.xml
         ═══════════════════════════════════════════════════════════════ -->

    {{CONNECTOR_CONFIGS}}

</mule>
