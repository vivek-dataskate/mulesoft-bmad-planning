{
  "info": {
    "_postman_id": "{{PROJECT_NAME}}-smoke-tests",
    "name": "{{PROJECT_NAME}} — Smoke + Functional Tests",
    "description": "Generated by BMAD scaffold. Run with Newman for CI/CD post-deployment verification.\n\nUsage:\n  newman run postman-collection.json \\\n    --env-var BASE_URL=https://{{PROJECT_NAME}}.dev.cloudhub.io/api/v1 \\\n    --env-var CLIENT_ID=<id> \\\n    --env-var CLIENT_SECRET=<secret> \\\n    --reporters cli,junit \\\n    --reporter-junit-export results/smoke-results.xml\n\nTest groups:\n  1. Connectivity    — API reachable, health check\n  2. Authentication  — 401 without creds, 200 with creds\n  3. Validation      — 400 on invalid input, error envelope schema check\n  4. Golden Path     — Happy path POST/GET with realistic payload\n  5. Error Envelope  — Shape of all error responses\n  6. Correlation ID  — ID propagated in response headers\n  7. Performance     — Response time within SLA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL",       "value": "https://{{PROJECT_NAME}}.dev.cloudhub.io/api/v1" },
    { "key": "CLIENT_ID",     "value": "TODO_REPLACE_CLIENT_ID" },
    { "key": "CLIENT_SECRET", "value": "TODO_REPLACE_CLIENT_SECRET" },
    { "key": "CORRELATION_ID", "value": "smoke-postman-001" }
  ],
  "item": [

    {
      "name": "1. Connectivity",
      "item": [
        {
          "name": "GET /health — API reachable",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Correlation-ID", "value": "{{CORRELATION_ID}}-health" }
            ],
            "url": { "raw": "{{BASE_URL}}/health", "host": ["{{BASE_URL}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API is reachable — HTTP 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response time < 3000ms (SLA)', function() {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "No credentials → 401",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Correlation-ID", "value": "{{CORRELATION_ID}}-no-auth" }
            ],
            "url": { "raw": "{{BASE_URL}}/{{SMOKE_ENDPOINT_1}}", "host": ["{{BASE_URL}}"], "path": ["{{SMOKE_ENDPOINT_1}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('No credentials → 401 Unauthorized', function() {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Error envelope has errorCode=UNAUTHORIZED', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('errorCode', 'UNAUTHORIZED');",
                  "    pm.expect(body).to.have.property('correlationId');",
                  "    pm.expect(body).to.have.property('timestamp');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Valid credentials → 200 (not 401/403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "client_id",        "value": "{{CLIENT_ID}}" },
              { "key": "client_secret",    "value": "{{CLIENT_SECRET}}" },
              { "key": "X-Correlation-ID", "value": "{{CORRELATION_ID}}-valid-auth" }
            ],
            "url": { "raw": "{{BASE_URL}}/{{SMOKE_ENDPOINT_1}}", "host": ["{{BASE_URL}}"], "path": ["{{SMOKE_ENDPOINT_1}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Valid credentials → not 401 or 403', function() {",
                  "    pm.expect(pm.response.code).to.not.equal(401);",
                  "    pm.expect(pm.response.code).to.not.equal(403);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "3. Input Validation",
      "item": [
        {
          "name": "POST empty body → 400 VALIDATION_ERROR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",     "value": "application/json" },
              { "key": "client_id",        "value": "{{CLIENT_ID}}" },
              { "key": "client_secret",    "value": "{{CLIENT_SECRET}}" },
              { "key": "X-Correlation-ID", "value": "{{CORRELATION_ID}}-validation" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{BASE_URL}}/{{SMOKE_ENDPOINT_POST}}", "host": ["{{BASE_URL}}"], "path": ["{{SMOKE_ENDPOINT_POST}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Empty body → 400', function() {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Error envelope: errorCode=VALIDATION_ERROR', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.errorCode).to.eql('VALIDATION_ERROR');",
                  "    pm.expect(body.correlationId).to.not.be.empty;",
                  "    pm.expect(body.timestamp).to.not.be.empty;",
                  "    pm.expect(body.message).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "4. Golden Path",
      "item": [
        {
          "name": "POST valid payload → 200/201/202",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",     "value": "application/json" },
              { "key": "client_id",        "value": "{{CLIENT_ID}}" },
              { "key": "client_secret",    "value": "{{CLIENT_SECRET}}" },
              { "key": "X-Correlation-ID", "value": "{{CORRELATION_ID}}-golden" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"smoke-test-{{PROJECT_NAME}}-001\",\n  \"name\": \"Smoke Test Record\",\n  \"source\": \"smoke-test\",\n  \"timestamp\": \"2026-05-11T00:00:00Z\"\n}"
            },
            "url": { "raw": "{{BASE_URL}}/{{SMOKE_ENDPOINT_POST}}", "host": ["{{BASE_URL}}"], "path": ["{{SMOKE_ENDPOINT_POST}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Golden path → 2xx success', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
                  "});",
                  "pm.test('Response time within SLA ({{LATENCY_MS}}ms)', function() {",
                  "    pm.expect(pm.response.responseTime).to.be.below({{LATENCY_MS}});",
                  "});",
                  "pm.test('Response body is valid JSON', function() {",
                  "    pm.response.to.be.json;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "5. Error Envelope Schema",
      "item": [
        {
          "name": "Connectivity error simulation → 503 with full error envelope",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",     "value": "application/json" },
              { "key": "client_id",        "value": "{{CLIENT_ID}}" },
              { "key": "client_secret",    "value": "{{CLIENT_SECRET}}" },
              { "key": "X-Correlation-ID", "value": "{{CORRELATION_ID}}-err-env" },
              { "key": "X-Simulate-Error", "value": "CONNECTIVITY" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"smoke-err-envelope-001\"\n}"
            },
            "url": { "raw": "{{BASE_URL}}/{{SMOKE_ENDPOINT_POST}}", "host": ["{{BASE_URL}}"], "path": ["{{SMOKE_ENDPOINT_POST}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Note: X-Simulate-Error header only active in dev/uat — remove from prod collection",
                  "// If simulation not supported, skip or manually invoke a known-broken endpoint",
                  "const body = pm.response.json();",
                  "pm.test('Error envelope has all required fields', function() {",
                  "    pm.expect(body).to.have.property('correlationId');",
                  "    pm.expect(body).to.have.property('errorCode');",
                  "    pm.expect(body).to.have.property('message');",
                  "    pm.expect(body).to.have.property('timestamp');",
                  "    pm.expect(body).to.have.property('failingComponent');",
                  "});",
                  "pm.test('No Java stack trace in error response', function() {",
                  "    const bodyStr = JSON.stringify(body);",
                  "    pm.expect(bodyStr).to.not.include('java.lang');",
                  "    pm.expect(bodyStr).to.not.include('at org.mule');",
                  "    pm.expect(bodyStr).to.not.include('at com.mulesoft');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "6. Correlation ID",
      "item": [
        {
          "name": "Correlation ID echoed in response",
          "request": {
            "method": "GET",
            "header": [
              { "key": "client_id",        "value": "{{CLIENT_ID}}" },
              { "key": "client_secret",    "value": "{{CLIENT_SECRET}}" },
              { "key": "X-Correlation-ID", "value": "smoke-corr-verify-abc123" }
            ],
            "url": { "raw": "{{BASE_URL}}/{{SMOKE_ENDPOINT_1}}", "host": ["{{BASE_URL}}"], "path": ["{{SMOKE_ENDPOINT_1}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Correlation ID present in response header or body', function() {",
                  "    const responseHeader = pm.response.headers.get('X-Correlation-ID');",
                  "    const responseBody   = pm.response.text();",
                  "    const correlationId  = 'smoke-corr-verify-abc123';",
                  "    const found = (responseHeader && responseHeader.includes(correlationId))",
                  "               || responseBody.includes(correlationId);",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "7. Performance SLA",
      "item": [
        {
          "name": "Response time within decisions.json nfr.latency",
          "request": {
            "method": "GET",
            "header": [
              { "key": "client_id",        "value": "{{CLIENT_ID}}" },
              { "key": "client_secret",    "value": "{{CLIENT_SECRET}}" },
              { "key": "X-Correlation-ID", "value": "{{CORRELATION_ID}}-perf" }
            ],
            "url": { "raw": "{{BASE_URL}}/{{SMOKE_ENDPOINT_1}}", "host": ["{{BASE_URL}}"], "path": ["{{SMOKE_ENDPOINT_1}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// {{LATENCY_MS}} is generated from decisions.json nfr.latency",
                  "// under-1s → 1000, under-3s → 3000, under-10s → 10000, async-ok → 30000",
                  "pm.test('Response within latency SLA ({{LATENCY_MS}}ms)', function() {",
                  "    pm.expect(pm.response.responseTime).to.be.below({{LATENCY_MS}});",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }

  ]
}
