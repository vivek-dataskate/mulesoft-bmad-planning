<!--
    Snippet: Invalid Message Channel (IMC) — validation failure routing
    Generated when: decisions.json errorHandling.invalidMessageChannel = true

    CRITICAL DISTINCTION (never confuse these):
      Invalid Message Channel → VALIDATION failures (structural/semantic errors)
                                NEVER retried — message is wrong; retry will always fail
      Dead Letter Queue (DLQ) → DELIVERY failures (downstream unavailable)
                                Retried when the system recovers

    Queue: ${mq.queue.invalid-messages}
    Naming standard: {domain}-invalid-messages-{env}-queue

    ── HOW TO USE THIS SNIPPET ─────────────────────────────────────────────────
    This snippet provides TWO blocks that work together:

    BLOCK 1 — Validation assertions (place BEFORE any downstream call in the flow):
    ┌─────────────────────────────────────────────────────────────────────────┐
    │  <validation:is-not-null .../>                                          │
    │  <validation:matches-regex .../>                                        │
    │  etc.                                                                   │
    └─────────────────────────────────────────────────────────────────────────┘

    BLOCK 2 — Error handler (place at the END of the flow inside <error-handler>):
    ┌─────────────────────────────────────────────────────────────────────────┐
    │  <error-handler>                                                        │
    │      <!-- paste the on-error-continue block below here -->             │
    │      <on-error-continue type="VALIDATION:*" ...>                       │
    │          ...publish to invalid-messages-queue...                       │
    │      </on-error-continue>                                               │
    │      <!-- other error handlers follow -->                              │
    │  </error-handler>                                                       │
    └─────────────────────────────────────────────────────────────────────────┘

    The Global_Error_Handler in error-handler.xml already includes VALIDATION:*
    routing to the IMC (when INVALID_MESSAGE_CHANNEL_ENABLED). For flows that
    use the global handler, no per-flow error handler is needed — just add the
    validation assertions before the downstream call.
-->

        <!-- ── BLOCK 1: Validation assertions — paste BEFORE downstream calls ── -->
        <!--
            Validation module namespace required in the mule root element:
              xmlns:validation="http://www.mulesoft.org/schema/mule/validation"
            Schema location:
              http://www.mulesoft.org/schema/mule/validation
                http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd
            pom.xml dependency:
              <groupId>org.mule.modules</groupId>
              <artifactId>mule-validation-module</artifactId>

            TODO: Replace examples with actual required fields for this flow.
        -->
        <validation:is-not-null
            value="#[payload.orderId]"
            message="orderId is required"
            doc:name="Validate orderId present"/>
        <!-- <validation:matches-regex value="#[payload.email]" regex="^[^@]+@[^@]+$" message="Invalid email format"/> -->
        <!-- <validation:is-not-empty-collection values="#[payload.lineItems]" message="lineItems must not be empty"/> -->

        <!-- ── BLOCK 2: Error handler entry — paste INSIDE <error-handler> ──── -->
        <!--
            USAGE: This on-error-continue must be placed inside an <error-handler> element.
            It cannot be placed directly in a flow or async scope.

            Full flow structure example:
            ────────────────────────────────────────────────────────
            <flow name="my-flow">
                <anypoint-mq:subscriber .../>
                <!-- BLOCK 1: validations here -->
                <validation:is-not-null .../>

                <!-- downstream calls -->

                <anypoint-mq:ack .../>

                <error-handler>
                    <!-- BLOCK 2: IMC routing for validation failures -->
                    <on-error-continue type="VALIDATION:INVALID_VALUE,...">
                        ...
                    </on-error-continue>
                    <!-- Other error types handled by Global_Error_Handler
                         if error-handler ref="Global_Error_Handler" is used instead -->
                </error-handler>
            </flow>
            ────────────────────────────────────────────────────────
        -->
        <on-error-continue
            type="VALIDATION:INVALID_VALUE,VALIDATION:NULL,VALIDATION:EMPTY_COLLECTION,VALIDATION:EXPRESSION"
            logException="false"
            doc:name="Route Validation Failure to IMC">
            <ee:transform doc:name="Build IMC Envelope">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
// TODO [COMPLIANCE]: mask any PII in originalPayload before publishing to IMC queue.
// Use the same PII field exclusion set as wire-tap.xml.
var piiFields = { "ssn", "taxId", "creditCardNumber", "cvv", "password", "secret", "token" }
var safePayload = if (payload is Object) payload - piiFields else "(non-object)"
---
{
    correlationId:    correlationId,
    errorCode:        "VALIDATION_ERROR",
    validationError:  error.description,
    failingComponent: error.failingComponent,
    receivedAt:       now() as String { format: "yyyy-MM-dd'T'HH:mm:ss.SSSZ" },
    originalPayload:  safePayload
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
            <anypoint-mq:publish
                config-ref="Anypoint_MQ_Config"
                destination="${mq.queue.invalid-messages}"
                messageId="#[correlationId]"
                doc:name="Publish to Invalid Message Channel">
                <anypoint-mq:body>#[output application/json --- payload]</anypoint-mq:body>
            </anypoint-mq:publish>
            <logger
                level="WARN"
                message='#["[INVALID MESSAGE] flow=" ++ flow.name ++ " | correlationId=" ++ correlationId ++ " | error=" ++ error.description]'
                doc:name="Log Validation Failure"/>
        </on-error-continue>
