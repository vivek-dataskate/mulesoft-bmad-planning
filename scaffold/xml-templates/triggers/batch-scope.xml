<!--
    Trigger: Batch Scope (patterns B/batch, C/batch-scope, K/data-migration)
    Use when: bulk record processing at scale (thousands of records) where:
      - Per-record error isolation is required (one failed record doesn't abort the batch)
      - Parallel step execution is needed for throughput
      - A batch summary report is required (failed count, succeeded count)
      - The source is a file, DB query result, or large API response

    For smaller volumes (< 1000 records, simple transforms): use foreach instead.
    For DB polling: see triggers/db-poll.xml (uses foreach with watermark).

    Batch job ID: auto-generated by Mule runtime per execution
    Source: {{FLOW_SOURCE}}  Target: {{FLOW_TARGET}}
    Step concurrency: ${batch.threadCount} (tune based on target system capacity)
    On-complete: updates watermark or audit record ONLY on clean batch exit
-->
    <!-- ── Inbound trigger: scheduler fires batch ──────────────────────── -->
    <flow name="{{FLOW_NAME}}-trigger-flow" doc:name="{{FLOW_DESCRIPTION}} — Trigger">

        <scheduler doc:name="Batch Job Scheduler">
            <scheduling-strategy>
                <cron expression="${scheduler.cron}" timeZone="UTC"/>
            </scheduling-strategy>
        </scheduler>

        <logger
            level="INFO"
            message='#["[BATCH START] flow=" ++ flow.name ++ " | correlationId=" ++ correlationId ++ " | env=" ++ p("mule.env")]'
            doc:name="Log Batch Start"/>

        <!--
            TODO: Fetch or supply the record set to process.
            Options:
              A. DB query result: <db:select .../>  (result = list of records)
              B. File contents:   <file:read .../>  (parse CSV/JSON/XML into list)
              C. S3 listing:      <s3:list-objects.../> + read each object
              D. API page fetch:  call paginated API subflow, accumulate all records
                 (see FK-006 in docs/FIELD_KNOWLEDGE.md for pagination pattern)
        -->

        <!-- TODO: Replace with actual source fetch for {{FLOW_SOURCE}} -->

        <batch:job
            jobName="{{FLOW_NAME}}-batch-job"
            blockSize="${batch.blockSize}"
            maxFailedRecords="${batch.maxFailedRecords}"
            doc:name="{{FLOW_DESCRIPTION}} Batch Job">

            <!-- ── Step 1: Validate + Enrich ──────────────────────────── -->
            <batch:process-records>
                <batch:step
                    name="validate-enrich"
                    acceptPolicy="ALL"
                    doc:name="Step 1 — Validate and Enrich">
                    <!--
                        TODO: Validate each record against required field rules.
                        Use <batch:record-variable> to pass data between steps.
                        Failed records in this step are tracked by the batch job
                        (failedRecords count) — they do NOT abort the batch.
                        Route known-invalid records to Invalid Message Channel here.
                    -->
                    <ee:transform doc:name="Transform — {{FLOW_SOURCE}} to Canonical">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/java
// TODO: transform source record to canonical model
// Import from: resources/dwl/{{DWL_FILE_NAME}}.dwl
---
payload]]></ee:set-payload>
                        </ee:message>
                    </ee:transform>
                </batch:step>

                <!-- ── Step 2: Write to Target ────────────────────────── -->
                <batch:step
                    name="write-to-target"
                    acceptPolicy="ONLY_NO_FAILURES"
                    doc:name="Step 2 — Write to {{FLOW_TARGET}}">
                    <!--
                        acceptPolicy="ONLY_NO_FAILURES": only records that passed Step 1
                        are processed in Step 2. Failed Step 1 records are tracked but skipped.

                        TODO: Write to target system: {{FLOW_TARGET}}
                        Use upsert (idempotent write) wherever the target supports it.
                        For Salesforce: salesforce:upsert with externalIdFieldName
                        For DB: INSERT ... ON CONFLICT UPDATE (PG) or MERGE (Oracle/MSSQL)
                        For REST API: PUT with record natural key in URL
                    -->
                </batch:step>
            </batch:process-records>

            <!-- ── On Complete: audit + watermark ─────────────────────── -->
            <batch:on-complete doc:name="Batch On Complete">
                <logger
                    level="INFO"
                    message='#["[BATCH COMPLETE] job=" ++ batchJobResult.batchJobId ++ " | correlationId=" ++ correlationId ++ " | processed=" ++ batchJobResult.processedRecords as String ++ " | failed=" ++ batchJobResult.failedRecords as String ++ " | success=" ++ batchJobResult.successfulRecords as String]'
                    doc:name="Log Batch Summary"/>
                <!--
                    Only advance watermark / mark as complete when NO records failed.
                    If any records failed, leave watermark unchanged so the next run
                    re-fetches and re-attempts (idempotency in Step 2 handles duplicates).
                    Per FK-007: watermark advances ONLY on fully clean completion.
                -->
                <choice doc:name="Route on Success vs Partial Failure">
                    <when expression="#[batchJobResult.failedRecords == 0]">
                        <os:store
                            key="{{FLOW_NAME}}-watermark"
                            objectStore="Persistent_Object_Store"
                            doc:name="Update Watermark — all records succeeded">
                            <os:value>#[now() as String { format: "yyyy-MM-dd'T'HH:mm:ss.SSSZ" }]</os:value>
                        </os:store>
                        <logger
                            level="INFO"
                            message='#["[BATCH SUCCESS] watermark advanced | correlationId=" ++ correlationId]'
                            doc:name="Log Watermark Advanced"/>
                    </when>
                    <otherwise>
                        <logger
                            level="ERROR"
                            message='#["[BATCH PARTIAL FAILURE] failedRecords=" ++ batchJobResult.failedRecords as String ++ " | watermark NOT advanced | correlationId=" ++ correlationId]'
                            doc:name="Log Partial Failure — Watermark Not Advanced"/>
                        <!-- TODO: publish summary to DLQ or alert ops channel -->
                    </otherwise>
                </choice>
            </batch:on-complete>

        </batch:job>

        <error-handler ref="Global_Error_Handler"/>
    </flow>
