<!--
    Trigger: DB Scheduler + Watermark (scheduled-sync / cdc-streaming via DB polling)
    Poll frequency: ${scheduler.frequencySeconds} seconds
    Watermark field: {{WATERMARK_FIELD}} (last-modified timestamp or sequence ID)
    MANDATORY: Always use watermark — never full-table scan.
    Watermark stored in persistent Object Store (survives restarts).
    NOTE: For true CDC use Salesforce Platform Events, Debezium/Kafka, or CDC connector.
-->
    <flow name="{{FLOW_NAME}}" doc:name="{{FLOW_DESCRIPTION}}">

        <scheduler doc:name="DB Poll Scheduler">
            <scheduling-strategy>
                <fixed-frequency
                    frequency="${scheduler.frequencySeconds}"
                    timeUnit="SECONDS"/>
            </scheduling-strategy>
        </scheduler>

        <logger
            level="INFO"
            message='#["[START POLL] flow=" ++ flow.name ++ " | correlationId=" ++ correlationId ++ " | env=" ++ p("mule.env")]'
            doc:name="Log Poll Start"/>

        <!-- Read watermark from persistent Object Store -->
        <os:retrieve
            key="{{FLOW_NAME}}-watermark"
            objectStore="Persistent_Object_Store"
            target="watermark"
            doc:name="Read Watermark">
            <!-- Epoch default on first run — adjust for partial historical load -->
            <os:default-value>#["1970-01-01T00:00:00.000Z"]</os:default-value>
        </os:retrieve>

        <logger
            level="DEBUG"
            message='#["[WATERMARK] flow=" ++ flow.name ++ " | correlationId=" ++ correlationId ++ " | since=" ++ vars.watermark]'
            doc:name="Log Watermark"/>

        <!-- Poll changed records since last watermark -->
        <db:select config-ref="Database_Config" doc:name="Poll Changed Records — {{FLOW_SOURCE}}">
            <db:sql><![CDATA[
                -- TODO: Replace with actual query for {{FLOW_SOURCE}}
                -- Always filter by watermark field; never full-table scan
                SELECT *
                FROM   {{DB_TABLE}}
                WHERE  {{WATERMARK_FIELD}} > :watermark
                ORDER  BY {{WATERMARK_FIELD}} ASC
                LIMIT  ${db.poll.batchSize}
            ]]></db:sql>
            <db:input-parameters>#[{ watermark: vars.watermark }]</db:input-parameters>
        </db:select>

        <logger
            level="INFO"
            message='#["[POLL] flow=" ++ flow.name ++ " | correlationId=" ++ correlationId ++ " | recordCount=" ++ sizeOf(payload) as String]'
            doc:name="Log Record Count"/>

        <!-- Process each changed record -->
        <foreach doc:name="Process Each Record">
            <!--
                TODO: Transform each record using:
                  resources/dwl/{{DWL_FILE_NAME}}.dwl
                TODO: Write to target: {{FLOW_TARGET}}
                TODO: Handle idempotency per record if target is an API
                      (use record's natural key, not MQ messageId)
            -->
        </foreach>

        <!-- Save new watermark — highest timestamp seen in this batch -->
        <os:store
            key="{{FLOW_NAME}}-watermark"
            objectStore="Persistent_Object_Store"
            doc:name="Update Watermark">
            <!-- Store run time, not max(record.updatedAt) — avoids missing records updated during poll window -->
            <os:value>#[now() as String { format: "yyyy-MM-dd'T'HH:mm:ss.SSSZ" }]</os:value>
        </os:store>

        <logger
            level="INFO"
            message='#["[END POLL] flow=" ++ flow.name ++ " | correlationId=" ++ correlationId]'
            doc:name="Log Poll End"/>

        <error-handler ref="Global_Error_Handler"/>
    </flow>
