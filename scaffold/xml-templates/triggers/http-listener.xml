<!--
    Trigger: HTTP Listener (request-reply / api-aggregation / webhook-ingestion)
    Layer: {{API_LAYER}} (system | process | experience)
    Naming: {action}-{entity}-flow

    Correlation ID strategy:
      - Client sends X-Correlation-ID header → we adopt it as the Mule correlationId
      - Client sends no header → Mule auto-generates a UUID correlationId
      - We echo the correlationId back in every response header (success and error)
      - Error handler uses bare `correlationId` expression (Mule built-in) — same value

    Validation namespace: add to mule root element if using validation:* module
      xmlns:validation="http://www.mulesoft.org/schema/mule/validation"
      and to xsi:schemaLocation:
      http://www.mulesoft.org/schema/mule/validation
        http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd
-->
    <flow name="{{FLOW_NAME}}" doc:name="{{FLOW_DESCRIPTION}}">

        <!--
            allowedMethods: set per-flow in decisions.json flows[].httpMethods
            Defaults to "POST,GET" — override by adding "httpMethods": "GET" to the flow entry.
        -->
        <http:listener
            config-ref="HTTP_Listener_Config"
            path="{{HTTP_PATH}}"
            allowedMethods="{{HTTP_METHODS}}"
            doc:name="HTTP Listener">
            <!-- Echo correlationId back to caller for end-to-end tracing -->
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[{
    "X-Correlation-ID": correlationId,
    "Content-Type":     "application/json"
}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:headers><![CDATA[#[{
    "X-Correlation-ID": correlationId,
    "Content-Type":     "application/json"
}]]]></http:headers>
                <http:body>#[payload]</http:body>
            </http:error-response>
        </http:listener>

        <!--
            Adopt the client's X-Correlation-ID as the Mule event correlationId so that
            ALL downstream logs, error envelopes, and MQ messages use the client's ID.
            set-correlation-id (Mule 4.6+) sets the actual Mule event correlationId —
            not a variable. Using set-variable here would NOT propagate to the error handler.
        -->
        <set-correlation-id
            value="#[attributes.headers['X-Correlation-ID'] default correlationId]"
            doc:name="Adopt Inbound Correlation ID"/>

        <logger
            level="INFO"
            message='#["[START] flow=" ++ flow.name ++ " | correlationId=" ++ correlationId ++ " | method=" ++ attributes.method ++ " | path=" ++ attributes.requestPath ++ " | env=" ++ p("mule.env")]'
            doc:name="Log Request Start"/>

        <!--
            TODO: Validate inbound payload BEFORE any downstream call.
            Route validation failures to Invalid Message Channel (not DLQ).
            Validation module must be in pom.xml and namespace declared above.
            Example:
              <validation:is-not-null value="#[payload.orderId]" message="orderId is required"/>
              <validation:matches-regex value="#[payload.email]" regex="^[^@]+@[^@]+$" message="Invalid email format"/>
        -->

        <!-- TODO: Implement {{FLOW_DESCRIPTION}} -->
        <!-- Source: {{FLOW_SOURCE}} → Target: {{FLOW_TARGET}} -->

        <!--
            Transform references the generated DWL stub at src/main/resources/dwl/{{DWL_FILE_NAME}}.dwl
            Implement the field mappings there (already created by scaffold generator).
        -->
        <ee:transform doc:name="Transform Response — {{FLOW_NAME}}">
            <ee:message>
                <ee:set-payload resource="dwl/{{DWL_FILE_NAME}}.dwl"/>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="httpStatus"><![CDATA[200]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <logger
            level="INFO"
            message='#["[END] flow=" ++ flow.name ++ " | correlationId=" ++ correlationId ++ " | status=" ++ (vars.httpStatus default 200) as String]'
            doc:name="Log Request End"/>

        <error-handler ref="Global_Error_Handler"/>
    </flow>
