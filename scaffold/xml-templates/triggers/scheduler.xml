<!--
    Trigger: Scheduler (scheduled-sync / batch / data-migration)
    Cron: {{CRON_EXPRESSION}} UTC  (property: ${scheduler.cron})
    Watermark: {{WATERMARK_ENABLED}}
    correlationId: generated by Mule runtime on each scheduler fire
-->
    <flow name="{{FLOW_NAME}}" doc:name="{{FLOW_DESCRIPTION}}">

        <scheduler doc:name="Scheduler — {{FLOW_NAME}}">
            <scheduling-strategy>
                <!-- Cron expression set via ${scheduler.cron} per environment -->
                <cron expression="${scheduler.cron}" timeZone="UTC"/>
            </scheduling-strategy>
        </scheduler>

        <logger
            level="INFO"
            message='#["[START] flow=" ++ flow.name ++ " | correlationId=" ++ correlationId ++ " | firedAt=" ++ now() as String ++ " | env=" ++ p("mule.env")]'
            doc:name="Log Scheduler Start"/>

        {{#if WATERMARK_ENABLED}}
        <!-- Read watermark from persistent Object Store (survives restart / redeploy) -->
        <os:retrieve
            key="{{FLOW_NAME}}-watermark"
            objectStore="Persistent_Object_Store"
            target="watermark"
            doc:name="Read Watermark">
            <!-- Default to epoch for first run — full historical load -->
            <os:default-value>#["1970-01-01T00:00:00.000Z"]</os:default-value>
        </os:retrieve>

        <logger
            level="DEBUG"
            message='#["[WATERMARK] flow=" ++ flow.name ++ " | correlationId=" ++ correlationId ++ " | from=" ++ vars.watermark]'
            doc:name="Log Watermark"/>
        {{/if}}

        <!--
            TODO: Implement {{FLOW_DESCRIPTION}}
            Source: {{FLOW_SOURCE}} → Target: {{FLOW_TARGET}}
            Query pattern: SELECT * FROM {table} WHERE updated_at > :watermark
            Use persistent watermark (last-modified timestamp or sequence ID).
            Never do a full-table scan on every run.
        -->

        {{#if WATERMARK_ENABLED}}
        <!-- Update watermark after successful run -->
        <os:store
            key="{{FLOW_NAME}}-watermark"
            objectStore="Persistent_Object_Store"
            doc:name="Update Watermark">
            <os:value>#[now() as String { format: "yyyy-MM-dd'T'HH:mm:ss.SSSZ" }]</os:value>
        </os:store>
        {{/if}}

        <logger
            level="INFO"
            message='#["[END] flow=" ++ flow.name ++ " | correlationId=" ++ correlationId]'
            doc:name="Log Scheduler End"/>

        <error-handler ref="Global_Error_Handler"/>
    </flow>
