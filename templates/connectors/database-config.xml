    <!--
        Usage in flows (always use parameterized queries):
          Select:
            <db:select config-ref="Database_Config" doc:name="Select Records">
              <db:sql>SELECT * FROM orders WHERE status = :status AND created_at > :since</db:sql>
              <db:input-parameters>#[{ status: "OPEN", since: vars.watermark }]</db:input-parameters>
            </db:select>

          Insert:
            <db:insert config-ref="Database_Config" doc:name="Insert Record">
              <db:sql>INSERT INTO orders (id, customer_id, total) VALUES (:id, :customerId, :total)</db:sql>
              <db:input-parameters>#[{ id: payload.id, customerId: payload.customerId, total: payload.total }]</db:input-parameters>
            </db:insert>

          Upsert (idempotent — preferred for integrations):
            Use INSERT ... ON CONFLICT UPDATE (PG) or MERGE (Oracle/MSSQL)
    -->
